@prefix dsim: <https://w3id.org/ontosim-dis#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix ta:   <https://w3id.org/ontosim-dis/test-cours#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/ontosim-dis/test-cours> rdf:type owl:Ontology ;
    rdfs:label "Test fonctionnel - forme du cours de maladie"@fr ;
    owl:imports <https://w3id.org/ontosim-dis/layer4-core/1.1> ;
    owl:versionInfo "1.0" .


#    Deux cours de maladie, de formes differentes

ta:tFluShape  rdf:type owl:NamedIndividual , obo:OGMS_0000094 .
# un cours aigu

ta:tDiabShape rdf:type owl:NamedIndividual , obo:OGMS_0000064 .
# un cours chronique


#    Les deux maladies : memes proprietes, seule la forme change

ta:tFlu rdf:type owl:NamedIndividual , dsim:DiseaseKnowledgeTemplate ;
    dsim:diseaseName "Influenza" ;
    dsim:hasDiseaseCourseShape ta:tFluShape .


ta:tDiab rdf:type owl:NamedIndividual , dsim:DiseaseKnowledgeTemplate ;
    dsim:diseaseName "Type 2 diabetes" ;
    dsim:hasDiseaseCourseShape ta:tDiabShape .
    
#
# Ce que ce test demontre : la forme du cours est un axe de classification INDEPENDANT
# du determinant. Une grippe est a la fois a cours aigu et a transmission couplee ;
# un diabete est a cours chronique et a progression individuelle. Les deux axes se
# croisent sans se confondre, et c'est le raisonneur qui place chaque maladie dans les
# deux, sans qu'on ait ecrit ni l'un ni l'autre.
