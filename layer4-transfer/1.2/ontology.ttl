@prefix : <https://w3id.org/ontosim-dis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dsim: <https://w3id.org/ontosim-dis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/ontosim-dis#> .

<https://w3id.org/ontosim-dis/layer4-transfer> rdf:type owl:Ontology ;
                                                owl:versionIRI <https://w3id.org/ontosim-dis/layer4-transfer/1.2> ;
                                                owl:imports <https://w3id.org/ontosim-dis/layer4-context/1.2> ;
                                                dcterms:created "2026" ;
                                                dcterms:creator "Paul Cheikh Anta DIOUF" ;
                                                dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                                rdfs:comment """Transferability of a model's parameters from one context to another. It states which context element the value of a parameter depends on, and how that value was obtained. The reasoner then infers what a change of context requires: re-estimating the parameter, replacing it or recalculating it.
A parameter that depends on no context element is kept as it is.
This module stands apart from layer 4-Context: that layer describes a context, this one states what a change of context costs."""@en ,
                                                             """Transférabilité des paramètres d'un modèle d'un contexte à un autre. On y dit de quel élément de contexte dépend la valeur d'un paramètre, et comment cette valeur a été obtenue. Le raisonneur en déduit ce que demande un changement de contexte : réestimer le paramètre, le remplacer ou le recalculer.
Un paramètre qui ne dépend d'aucun élément de contexte se garde tel quel.
Ce module est à part de la couche 4-Context : elle décrit un contexte, il dit ce que coûte un changement de contexte."""@fr ;
                                                rdfs:label "OntoSim-Dis Couche 4-Transfer - Transférabilité des paramètres"@fr ,
                                                           "OntoSim-Dis Layer 4-Transfer - Transferability of parameters"@en ;
                                                owl:versionInfo "1.2" .

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontosim-dis#dependsOnContextElement
dsim:dependsOnContextElement rdf:type owl:ObjectProperty ;
                             rdfs:domain dsim:ModelParameter ;
                             rdfs:range [ rdf:type owl:Class ;
                                          owl:unionOf ( dsim:Climate
                                                        dsim:GeographicRegion
                                                        dsim:HealthInfrastructure
                                                        dsim:Population
                                                      )
                                        ] ;
                             rdfs:comment "Lie un paramètre à l'élément de contexte dont sa valeur dépend : une région géographique, une population, un climat ou une infrastructure de santé. On ne l'écrit pas pour un paramètre propre à la maladie, comme une durée d'incubation."@fr ,
                                          "Links a parameter to the context element its value depends on: a geographic region, a population, a climate or a health infrastructure. It is not stated for a parameter that belongs to the disease itself, such as an incubation period."@en ;
                             rdfs:label "dependsOnContextElement"@en .


###  https://w3id.org/ontosim-dis#hasValueOrigin
dsim:hasValueOrigin rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain dsim:ModelParameter ;
                    rdfs:range dsim:ValueOrigin ;
                    rdfs:comment "Dit comment la valeur d'un paramètre a été obtenue. Fonctionnelle : une valeur a une origine et une seule."@fr ,
                                 "States how the value of a parameter was obtained. Functional: a value has one origin and only one."@en ;
                    rdfs:label "hasValueOrigin"@en .


###  https://w3id.org/ontosim-dis#isDerivedFrom
dsim:isDerivedFrom rdf:type owl:ObjectProperty ;
                   rdfs:domain dsim:ModelParameter ;
                   rdfs:range dsim:ModelParameter ;
                   rdfs:comment "Lie un paramètre calculé aux paramètres dont une formule tire sa valeur. Le nombre de reproduction de base est ainsi tiré du taux de transmission et de la durée de contagiosité."@fr ,
                                "Links a calculated parameter to the parameters from which a formula obtains its value. The basic reproduction number is thus obtained from the transmission rate and the infectious period."@en ;
                   rdfs:label "isDerivedFrom"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontosim-dis#parameterExpression
dsim:parameterExpression rdf:type owl:DatatypeProperty ;
                         rdfs:domain dsim:ModelParameter ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Expression textuelle d'un paramètre calculé à partir d'autres, par exemple beta / gamma."@fr ,
                                      "Textual expression of a parameter calculated from others, for instance beta / gamma."@en ;
                         rdfs:label "parameterExpression"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontosim-dis#ContextDependentParameter
dsim:ContextDependentParameter rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( dsim:ModelParameter
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty dsim:dependsOnContextElement ;
                                                                            owl:someValuesFrom owl:Thing
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf dsim:ModelParameter ;
                               rdfs:comment "A parameter whose value depends on at least one context element. Inferred by the reasoner."@en ,
                                            "Paramètre dont la valeur dépend d'au moins un élément de contexte. Inféré par le raisonneur."@fr ;
                               rdfs:label "ContextDependentParameter"@en .


###  https://w3id.org/ontosim-dis#ParameterToRecalculate
dsim:ParameterToRecalculate rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( dsim:ModelParameter
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty dsim:isDerivedFrom ;
                                                                         owl:someValuesFrom dsim:ContextDependentParameter
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf dsim:ContextDependentParameter ;
                            rdfs:comment "A parameter calculated from at least one context-dependent parameter. Changing context requires redoing the calculation, with no new data. It depends on the context itself, through the parameter it is obtained from. Inferred by the reasoner."@en ,
                                         "Paramètre calculé à partir d'au moins un paramètre dépendant du contexte. Changer de contexte demande de refaire le calcul, sans nouvelles données. Il dépend lui-même du contexte, par le paramètre dont il est tiré. Inféré par le raisonneur."@fr ;
                            rdfs:label "ParameterToRecalculate"@en .


###  https://w3id.org/ontosim-dis#ParameterToReestimate
dsim:ParameterToReestimate rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( dsim:ContextDependentParameter
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty dsim:hasValueOrigin ;
                                                                        owl:hasValue dsim:ESTIMATED_FROM_DATA
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf dsim:ContextDependentParameter ;
                           rdfs:comment "A context-dependent parameter whose value was estimated from data. Changing context requires estimating it again, from data of the new context. Inferred by the reasoner."@en ,
                                        "Paramètre dépendant du contexte dont la valeur a été estimée sur des données. Changer de contexte demande de l'estimer de nouveau, sur des données du nouveau contexte. Inféré par le raisonneur."@fr ;
                           rdfs:label "ParameterToReestimate"@en .


###  https://w3id.org/ontosim-dis#ParameterToReplace
dsim:ParameterToReplace rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( dsim:ContextDependentParameter
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty dsim:hasValueOrigin ;
                                                                     owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                          owl:oneOf ( dsim:ASSUMED
                                                                                                      dsim:FROM_LITERATURE
                                                                                                    )
                                                                                        ]
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf dsim:ContextDependentParameter ;
                        rdfs:comment "A context-dependent parameter whose value was assumed or taken from a source. Changing context only requires taking the value of the new context. Inferred by the reasoner."@en ,
                                     "Paramètre dépendant du contexte dont la valeur a été supposée ou reprise d'une source. Changer de contexte demande seulement de prendre la valeur du nouveau contexte. Inféré par le raisonneur."@fr ;
                        rdfs:label "ParameterToReplace"@en .


###  https://w3id.org/ontosim-dis#ValueOrigin
dsim:ValueOrigin rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( dsim:ASSUMED
                                                   dsim:DERIVED
                                                   dsim:ESTIMATED_FROM_DATA
                                                   dsim:FROM_LITERATURE
                                                 )
                                     ] ;
                 rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                 rdfs:comment "Façon dont la valeur d'un paramètre a été obtenue. Liste fermée. C'est ce qui décide de ce que coûte un changement de contexte : une valeur estimée demande de nouvelles données, une valeur supposée ou reprise d'une source se remplace, une valeur calculée se recalcule."@fr ,
                              "How the value of a parameter was obtained. Closed list. This is what decides the cost of a change of context: an estimated value needs new data, a value that was assumed or taken from a source is replaced, a calculated value is recalculated."@en ;
                 rdfs:label "ValueOrigin"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontosim-dis#ASSUMED
dsim:ASSUMED rdf:type owl:NamedIndividual ,
                      dsim:ValueOrigin ;
             rdfs:comment "Valeur posée par hypothèse, sans mesure ni estimation."@fr ,
                          "Value set by assumption, neither measured nor estimated."@en ;
             rdfs:label "Assumed"@en .


###  https://w3id.org/ontosim-dis#DERIVED
dsim:DERIVED rdf:type owl:NamedIndividual ,
                      dsim:ValueOrigin ;
             rdfs:comment "Valeur calculée par une formule à partir d'autres paramètres."@fr ,
                          "Value calculated by a formula from other parameters."@en ;
             rdfs:label "Derived"@en .


###  https://w3id.org/ontosim-dis#ESTIMATED_FROM_DATA
dsim:ESTIMATED_FROM_DATA rdf:type owl:NamedIndividual ,
                                  dsim:ValueOrigin ;
                         rdfs:comment "Valeur obtenue en ajustant le modèle à des données observées."@fr ,
                                      "Value obtained by fitting the model to observed data."@en ;
                         rdfs:label "Estimated from data"@en .


###  https://w3id.org/ontosim-dis#FROM_LITERATURE
dsim:FROM_LITERATURE rdf:type owl:NamedIndividual ,
                              dsim:ValueOrigin ;
                     rdfs:comment "Valeur reprise d'une étude publiée."@fr ,
                                  "Value taken from a published study."@en ;
                     rdfs:label "From literature"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( dsim:ASSUMED
                        dsim:DERIVED
                        dsim:ESTIMATED_FROM_DATA
                        dsim:FROM_LITERATURE
                      )
] .


