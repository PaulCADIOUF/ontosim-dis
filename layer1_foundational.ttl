<http://www.ontosim-dis.org/ontology/layer1> rdf:type owl:Ontology ;
                                              owl:versionIRI <http://www.ontosim-dis.org/ontology/layer1/1.0> ;
                                              dc:description "Couche 1 de l'ontologie OntoSim-Dis. les concepts fondateurs indépendants de tout domaine applicatif. Les termes nécessaires de BFO, RO et IAO ont été extraits selon une approche MIREOT."@fr ,
                                                             "Layer 1 of the OntoSim-Dis ontology: foundational concepts independent of any application domain. The necessary terms from BFO, RO, and IAO were extracted using a MIREOT approach."@en ;
                                              dcterms:created "2026" ;
                                              dcterms:creator "Paul Cheikh Anta DIOUF" ;
                                              dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
                                              dcterms:source "BFO / RO  /  IAO (Je rappelle que les termes sont extraits par MIREOT)"@fr ;
                                              rdfs:label "OntoSim-Dis Layer 1 - Foundational Ontologies"@en ;
                                              owl:versionInfo "1.0" .

