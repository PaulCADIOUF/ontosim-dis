        <rdfs:comment xml:lang="en">Numeric value of the parameter.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Valeur numérique du paramètre.</rdfs:comment>
        <rdfs:label xml:lang="en">parameterValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#pathogenName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#pathogenName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Nom scientifique de l&apos;agent pathogène.</rdfs:comment>
        <rdfs:comment xml:lang="en">Scientific name of the pathogen.</rdfs:comment>
        <rdfs:label xml:lang="en">pathogenName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#populationDensity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#populationDensity">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Density in inhabitants per square kilometre.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Densité en habitants par kilomètre carré.</rdfs:comment>
        <rdfs:label xml:lang="en">populationDensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#populationSize -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#populationSize">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Effectif de la population.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number of individuals in the population.</rdfs:comment>
        <rdfs:label xml:lang="en">populationSize</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#probabilityParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#probabilityParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Probability of success of a Bernoulli law, between 0 and 1.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Probabilité de succès d&apos;une loi de Bernoulli, entre 0 et 1.</rdfs:comment>
        <rdfs:label xml:lang="en">probabilityParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#randomSeed -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#randomSeed">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Graine du générateur aléatoire, nécessaire pour reproduire une exécution stochastique.</rdfs:comment>
        <rdfs:comment xml:lang="en">Seed of the random generator, needed to reproduce a stochastic run.</rdfs:comment>
        <rdfs:label xml:lang="en">randomSeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#rateConstantValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#rateConstantValue">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ConstantRate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Valeur d&apos;un taux constant, par jour.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value of a constant rate, per day.</rdfs:comment>
        <rdfs:label xml:lang="en">rateConstantValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#rateExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#rateExpression">
