    <!-- http://purl.obolibrary.org/obo/BFO_0000050 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">a core relation that holds between a part and its whole</rdfs:comment>
        <rdfs:label xml:lang="en">part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000054 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000054">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">Paraphrase of elucidation: a relation between a realizable entity and a process, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process</rdfs:comment>
        <rdfs:label xml:lang="en">realized in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000055 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000055">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:comment xml:lang="en">Paraphrase of elucidation: a relation between a process and a realizable entity, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process</rdfs:comment>
        <rdfs:label xml:lang="en">realizes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000136 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000136">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:comment xml:lang="en">A (currently) primitive relation that relates an information artifact to an entity.</rdfs:comment>
        <rdfs:label xml:lang="en">is about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000057 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000057">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:comment xml:lang="en">a relation between a process and a continuant, in which the continuant is somehow involved in the process.</rdfs:comment>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002131 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002131">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002323"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">A overlaps B if they share some part in common.
x overlaps y if and only if there exists some z such that x has part z and z part of y</rdfs:comment>
        <rdfs:label xml:lang="en">overlaps</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002233 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002233">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000116 xml:lang="fr">Décision en suspens : la recomposition n&apos;est pas encore conçue. RO réserve cette relation aux entrées matérielles, alors que DK, CK, MSK et EK sont des artefacts d&apos;information ; elle pourra donc être retirée.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">p has input c iff: p is a process, c is a material entity, c is a participant in p, c is present at the start of p, and the state of c is modified during p.</rdfs:comment>
        <rdfs:label xml:lang="en">has input</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002234 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002234">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <obo:IAO_0000116 xml:lang="fr">Décision en suspens : la recomposition n&apos;est pas encore conçue. Relation gardée pour elle ; elle pourra être retirée.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.</rdfs:comment>
        <rdfs:label xml:lang="en">has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002323 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002323">
        <rdfs:comment xml:lang="en">A mereological relationship or a topological relationship</rdfs:comment>
        <rdfs:label xml:lang="en">mereotopologically related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#appliesExecutionKnowledge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#appliesExecutionKnowledge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
        <rdfs:comment xml:lang="fr">Lie un processus d&apos;exécution à la configuration qu&apos;il réalise. Fonctionnelle : une exécution applique une configuration et une seule.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an execution process to the configuration it realises. Functional: one execution applies exactly one configuration.</rdfs:comment>
        <rdfs:label xml:lang="en">appliesExecutionKnowledge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#dependsOnAttribute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#dependsOnAttribute">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#IndividualDeterminant"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#IndividualAttribute"/>
        <rdfs:comment xml:lang="fr">Lie un déterminant aux attributs individuels qu&apos;il lit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a determinant to the individual attributes it reads.</rdfs:comment>
        <rdfs:label xml:lang="en">dependsOnAttribute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#dependsOnCompartment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#dependsOnCompartment">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#CompartmentDependentRate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
        <rdfs:comment xml:lang="fr">Lie un taux aux compartiments dont il lit le contenu courant. Signature du couplage populationnel dans le paradigme compartimental.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a rate to the compartments whose current content it reads. Signature of population coupling in the compartmental paradigm.</rdfs:comment>
        <rdfs:label xml:lang="en">dependsOnCompartment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#dependsOnCountIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#dependsOnCountIn">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#CouplingSource"/>
        <rdfs:comment xml:lang="fr">Lie un déterminant aux catégories dont il lit l&apos;effectif courant. Signature du couplage populationnel. La catégorie lue est un état de santé lorsque le risque dépend des humains infectés, un état de réservoir lorsqu&apos;il dépend d&apos;un milieu ou d&apos;un hôte non humain. Pendant exact de dependsOnCompartment [3B] et de triggeredBy sur une interaction [3A].</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a determinant to the categories whose current head count it reads. Signature of population coupling. The category read is a health state when the risk depends on infected humans, a reservoir state when it depends on an environment or a non-human host. Exact counterpart of dependsOnCompartment [3B] and triggeredBy an interaction [3A].</rdfs:comment>
        <rdfs:label xml:lang="en">dependsOnCountIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#detects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#detects">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DetectionIntervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="fr">Lie une intervention de détection à la connaissance de maladie qu&apos;elle recherche.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a detection intervention to the disease knowledge it looks for.</rdfs:comment>
        <rdfs:label xml:lang="en">detects</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#detects"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#executesModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#executesModel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:comment xml:lang="fr">Lie une exécution au modèle qu&apos;elle fait tourner.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an execution to the model it runs.</rdfs:comment>
        <rdfs:label xml:lang="en">executesModel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#governsCompartment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#governsCompartment">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DifferentialEquation"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
        <rdfs:comment xml:lang="fr">Lie une équation au compartiment dont elle donne la variation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an equation to the compartment whose variation it gives.</rdfs:comment>
        <rdfs:label xml:lang="en">governsCompartment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasAgentState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasAgentState">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentType"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#AgentState"/>
        <rdfs:comment xml:lang="fr">Lie une catégorie d&apos;agents aux états que ses agents peuvent occuper.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a category of agents to the states its agents can occupy.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAgentState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasAgentTransition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasAgentTransition">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentBasedModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#AgentTransition"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux changements d&apos;état que ses agents peuvent subir.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the state changes its agents can undergo.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAgentTransition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasAgentType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasAgentType">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentBasedModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#AgentType"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux catégories d&apos;agents qu&apos;il contient.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the categories of agents it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAgentType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasBehavior -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasBehavior">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentBasedModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Behavior"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux règles de comportement de ses agents.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the behaviour rules of its agents.</rdfs:comment>
        <rdfs:label xml:lang="en">hasBehavior</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasClimate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasClimate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ContextKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
        <rdfs:comment xml:lang="fr">Lie un contexte à ses conditions climatiques.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a context to its climatic conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">hasClimate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasCompartment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasCompartment">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#CompartmentalModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
        <rdfs:comment xml:lang="fr">Lie un modèle compartimental à ses compartiments.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a compartmental model to its compartments.</rdfs:comment>
        <rdfs:label xml:lang="en">hasCompartment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasComponent">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="fr">Lie une structure de modèle aux composants qu&apos;elle contient.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model structure to the components it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">hasComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasContextKnowledge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasContextKnowledge">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ContextKnowledge"/>
        <rdfs:comment xml:lang="fr">Lie un modèle au contexte pour lequel il a été construit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the context it was built for.</rdfs:comment>
        <rdfs:label xml:lang="en">hasContextKnowledge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasDiseaseCourseShape -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasDiseaseCourseShape">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie à la forme dynamique de son cours, telle que classifiée par OGMS. Cette forme contraint la structure du modèle indépendamment du déterminant : elle dit si un retour à l&apos;état sain est possible, si un état absorbant est requis ou si la progression est monotone.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the dynamic shape of its course, as classified by OGMS. This shape constrains the structure of the model independently of the determinant: it says whether a return to health is possible, whether an absorbing state is required or whether progression is monotone.</rdfs:comment>
        <rdfs:label xml:lang="en">hasDiseaseCourseShape</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasEndAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasEndAge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Lie un état de santé au paramètre donnant l&apos;âge au-delà duquel un individu n&apos;y est plus.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a health state to the parameter giving the age beyond which an individual is no longer in it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEndAge</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEndAge"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasEnvironmentModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasEnvironmentModel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentBasedModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#EnvironmentModel"/>
        <rdfs:comment xml:lang="fr">Lie un modèle au milieu dans lequel ses agents évoluent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the surroundings in which its agents evolve.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEnvironmentModel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasEpidemiologicalRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasEpidemiologicalRole">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie aux rôles intervenant dans son cycle de transmission.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the roles involved in its transmission cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEpidemiologicalRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasEquation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasEquation">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#CompartmentalModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#DifferentialEquation"/>
        <rdfs:comment xml:lang="fr">Lie un modèle compartimental à ses équations différentielles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a compartmental model to its differential equations.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEquation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasExecutionKnowledge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasExecutionKnowledge">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux configurations d&apos;exécution définies pour lui. Non fonctionnelle : un même modèle peut être exécuté sous plusieurs configurations, simulateurs différents ou nombres de répétitions différents.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the execution configurations defined for it. Not functional: the same model may be run under several configurations, with different simulators or different run counts.</rdfs:comment>
        <rdfs:label xml:lang="en">hasExecutionKnowledge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasFlow -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasFlow">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#CompartmentalModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
        <rdfs:comment xml:lang="fr">Lie un modèle compartimental à ses flux.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a compartmental model to its flows.</rdfs:comment>
        <rdfs:label xml:lang="en">hasFlow</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasGeographicRegion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasGeographicRegion">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ContextKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="fr">Lie un contexte aux territoires qu&apos;il couvre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a context to the territories it covers.</rdfs:comment>
        <rdfs:label xml:lang="en">hasGeographicRegion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasGranularityLevel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasGranularityLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#GranularityLevel"/>
        <rdfs:comment xml:lang="fr">Lie une structure de modèle à son niveau de détail.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model structure to its level of detail.</rdfs:comment>
        <rdfs:label xml:lang="en">hasGranularityLevel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasHealthInfrastructure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasHealthInfrastructure">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ContextKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthInfrastructure"/>
        <rdfs:comment xml:lang="fr">Lie un contexte aux structures de santé disponibles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a context to the health facilities available.</rdfs:comment>
        <rdfs:label xml:lang="en">hasHealthInfrastructure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasHealthState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasHealthState">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie aux états de santé qu&apos;elle définit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the health states it defines.</rdfs:comment>
        <rdfs:label xml:lang="en">hasHealthState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasMaterialBasisIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasMaterialBasisIn">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000031"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000045"/>
        <rdfs:comment xml:lang="fr">Lie une maladie au désordre qui en est la base physique. OGMS énonce cette relation dans la définition textuelle de la maladie, mais ne la formalise pas. IDO la formalise sous son propre IRI ; nous la déclarons ici pour ne pas dépendre d&apos;IDO.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease to the disorder that is its physical basis. OGMS states this in the textual definition of disease but does not formalise it. IDO formalises it under its own IRI; we declare it here so as not to depend on IDO.</rdfs:comment>
        <rdfs:label xml:lang="en">hasMaterialBasisIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasModelNature -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasModelNature">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelNature"/>
        <rdfs:comment xml:lang="fr">Dit si le modèle est mécaniste, empirique ou mixte. Fonctionnelle.</rdfs:comment>
        <rdfs:comment xml:lang="en">States whether the model is mechanistic, empirical or mixed. Functional.</rdfs:comment>
        <rdfs:label xml:lang="en">hasModelNature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasModelPurpose -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasModelPurpose">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelPurpose"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux objectifs pour lesquels il a été construit. Non fonctionnelle, délibérément : un même modèle peut servir à plusieurs choses, par exemple à comprendre une dynamique et à planifier une riposte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the purposes it was built for. Deliberately not functional: the same model may serve several ends, for instance understanding a dynamic and planning a response.</rdfs:comment>
        <rdfs:label xml:lang="en">hasModelPurpose</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasModelScope -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasModelScope">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelScope"/>
        <rdfs:comment xml:lang="fr">Dit si le modèle est général ou spécifique. Fonctionnelle : un modèle est l&apos;un ou l&apos;autre, pas les deux.</rdfs:comment>
        <rdfs:comment xml:lang="en">States whether the model is general or specific. Functional: a model is one or the other, not both.</rdfs:comment>
        <rdfs:label xml:lang="en">hasModelScope</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasOnsetAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasOnsetAge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Lie un état de santé au paramètre donnant l&apos;âge à partir duquel un individu peut y entrer.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a health state to the parameter giving the age from which an individual may enter it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasOnsetAge</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasParadigm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasParadigm">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ParadigmType"/>
        <rdfs:comment xml:lang="fr">Lie une structure de modèle à sa nature déterministe ou stochastique.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model structure to its deterministic or stochastic nature.</rdfs:comment>
        <rdfs:label xml:lang="en">hasParadigm</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Lie un modèle à ses paramètres.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to its parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">hasParameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasPathogen -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasPathogen">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie à l&apos;agent pathogène qui la cause.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the pathogen causing it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPathogen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasPopulation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasPopulation">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ContextKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:comment xml:lang="fr">Lie un contexte aux populations qu&apos;il concerne.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a context to the populations it concerns.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPopulation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasRate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasRate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#RateSpecification"/>
        <rdfs:comment xml:lang="fr">Lie un flux à la façon dont son taux est déterminé.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a flow to the way its rate is determined.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasReservoirState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasReservoirState">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie aux états de réservoir qui interviennent dans sa transmission. Une maladie qui en déclare au moins un est classée transmission médiée par l&apos;environnement, sans que personne ne l&apos;ait dit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the reservoir states involved in its transmission. A disease declaring at least one is classified as environmentally mediated, without anyone having said so.</rdfs:comment>
        <rdfs:label xml:lang="en">hasReservoirState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasRiskFactor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasRiskFactor">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#RiskFactor"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie à ses facteurs de risque.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to its risk factors.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRiskFactor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasSensitivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasSensitivity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DetectionIntervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Lie une intervention de détection au paramètre qui en donne la sensibilité : la part des individus atteints que le test trouve effectivement. Passer par un paramètre plutôt que par un nombre en clair permet à la sensibilité de porter sa propre incertitude.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a detection intervention to the parameter giving its sensitivity: the share of affected individuals the test does find. Going through a parameter rather than a plain number allows the sensitivity to carry its own uncertainty.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSensitivity</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSensitivity"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasSourceHealthState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasSourceHealthState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:comment xml:lang="en">Start health state of a transition. Distinct from hasSourceState of layer 2, which links model components, not knowledge.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État de santé de départ d&apos;une transition. Distincte de hasSourceState de la couche 2, qui relie des composants de modèle et non des connaissances.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSourceHealthState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasSourceState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasSourceState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransitionComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
        <rdfs:comment xml:lang="en">Start state of a transition.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État de départ d&apos;une transition.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSourceState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasSpatialType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasSpatialType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#SpatialType"/>
        <rdfs:comment xml:lang="fr">Lie une structure de modèle à son traitement de l&apos;espace.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model structure to its handling of space.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSpatialType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasSpecificity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasSpecificity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DetectionIntervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Lie une intervention de détection au paramètre qui en donne la spécificité : la part des individus indemnes que le test écarte correctement.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a detection intervention to the parameter giving its specificity: the share of unaffected individuals the test correctly leaves aside.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSpecificity</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSpecificity"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasStateTransition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasStateTransition">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie aux transitions qu&apos;elle autorise.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the transitions it allows.</rdfs:comment>
        <rdfs:label xml:lang="en">hasStateTransition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasStructureKnowledge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasStructureKnowledge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:comment xml:lang="fr">Lie un modèle à la connaissance décrivant sa structure interne.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the knowledge describing its internal structure.</rdfs:comment>
        <rdfs:label xml:lang="en">hasStructureKnowledge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasTargetHealthState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasTargetHealthState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:comment xml:lang="en">End health state of a transition.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État de santé d&apos;arrivée d&apos;une transition.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTargetHealthState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasTargetState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasTargetState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransitionComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
        <rdfs:comment xml:lang="en">End state of a transition.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État d&apos;arrivée d&apos;une transition.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTargetState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasTemporalType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasTemporalType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TemporalType"/>
        <rdfs:comment xml:lang="fr">Lie une structure de modèle à son traitement du temps.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model structure to its handling of time.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTemporalType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasTransmissionRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasTransmissionRoute">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Lie une connaissance de maladie aux voies par lesquelles elle se transmet.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the routes by which it is transmitted.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTransmissionRoute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasUncertaintyDistribution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasUncertaintyDistribution">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:comment xml:lang="fr">Lie un paramètre à la loi de probabilité qui décrit l&apos;incertitude sur sa valeur. C&apos;est ce qui rend possible l&apos;analyse de sensibilité probabiliste : au lieu d&apos;une valeur unique, le paramètre porte la loi dont sa valeur est tirée à chaque répétition de l&apos;exécution.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a parameter to the probability law describing the uncertainty on its value. This is what makes probabilistic sensitivity analysis possible: instead of a single value, the parameter carries the law its value is drawn from at each repetition of the run.</rdfs:comment>
        <rdfs:label xml:lang="en">hasUncertaintyDistribution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasValidationMethod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#hasValidationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ValidationMethod"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux méthodes par lesquelles il a été validé.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the methods by which it was validated.</rdfs:comment>
        <rdfs:label xml:lang="en">hasValidationMethod</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#involvesAgentType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#involvesAgentType">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InteractionType"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#AgentType"/>
        <rdfs:comment xml:lang="fr">Lie une sorte d&apos;interaction aux catégories d&apos;agents qui y participent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a kind of interaction to the categories of agents that take part in it.</rdfs:comment>
        <rdfs:label xml:lang="en">involvesAgentType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#involvesFlow -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#involvesFlow">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DifferentialEquation"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
        <rdfs:comment xml:lang="fr">Lie une équation aux flux qui y figurent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an equation to the flows appearing in it.</rdfs:comment>
        <rdfs:label xml:lang="en">involvesFlow</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#isGovernedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#isGovernedBy">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:comment xml:lang="fr">Lie une transition aux déterminants qui en fixent le taux ou la probabilité.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a transition to the determinants that set its rate or probability.</rdfs:comment>
        <rdfs:label xml:lang="en">isGovernedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#isLocatedInRegion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#isLocatedInRegion">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="fr">Lie une population au territoire où elle vit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a population to the territory where it lives.</rdfs:comment>
        <rdfs:label xml:lang="en">isLocatedInRegion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#isStateOfRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#isStateOfRole">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="fr">Lie un état de réservoir au rôle épidémiologique dont il quantifie l&apos;effectif : le rôle d&apos;hôte intermédiaire pour les escargots infectés, le rôle de réservoir pour les cercaires présentes dans l&apos;eau. Fonctionnelle : un effectif ne quantifie qu&apos;un seul rôle.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a reservoir state to the epidemiological role whose head count it quantifies: the intermediate host role for infected snails, the reservoir role for cercariae present in the water. Functional: one head count quantifies one role only.</rdfs:comment>
        <rdfs:label xml:lang="en">isStateOfRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#isSubRegionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#isSubRegionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="fr">Lie un territoire au territoire plus large qui le contient. Transitive : un district dans une région dans un pays est dans ce pays. RO:located in n&apos;est délibérément pas réutilisée ici, car elle relie des entités matérielles réelles, alors que nos régions sont des descriptions de territoires.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a territory to the larger territory containing it. Transitive: a district in a region in a country is in that country. RO:located in is deliberately not reused here, because it relates real material entities, whereas our regions are descriptions of territories.</rdfs:comment>
        <rdfs:label xml:lang="en">isSubRegionOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#modifiesDeterminant -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#modifiesDeterminant">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:comment xml:lang="fr">Lie une intervention aux déterminants dont elle modifie la valeur. C&apos;est ce qui donne un sens formel à une intervention : sans cela, c&apos;est une étiquette.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an intervention to the determinants whose value it changes. This is what gives an intervention a formal meaning: without it, an intervention is a label.</rdfs:comment>
        <rdfs:label xml:lang="en">modifiesDeterminant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#producesResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#producesResult">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationExecution"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#SimulationResult"/>
        <rdfs:comment xml:lang="fr">Lie une exécution aux données qu&apos;elle produit.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an execution to the data it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">producesResult</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#quantifiedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#quantifiedBy">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Lie un déterminant au paramètre qui lui donne sa valeur : beta, gamma, un rapport de risque.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a determinant to the parameter that gives it its value: beta, gamma, a hazard ratio.</rdfs:comment>
        <rdfs:label xml:lang="en">quantifiedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#realisesDeterminant -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#realisesDeterminant">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:comment xml:lang="fr">Déclare quel déterminant un composant de modèle réalise : un taux dépendant d&apos;un compartiment [3B] ou une transition déclenchée par une interaction [3A] réalisent tous deux un déterminant couplé à la population.</rdfs:comment>
        <rdfs:comment xml:lang="en">States which determinant a model component realises: a compartment-dependent rate [3B] or an interaction-triggered transition [3A] both realise a population-coupled determinant.</rdfs:comment>
        <rdfs:label xml:lang="en">realisesDeterminant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#representsDisease -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#representsDisease">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000031"/>
        <rdfs:comment xml:lang="fr">Lie un artefact de connaissance de maladie à la maladie réelle dont il parle, c&apos;est-à-dire une disposition portée par un organisme. Unique point de contact entre la couche informationnelle d&apos;OntoSim-Dis et l&apos;ontologie réaliste OGMS.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a disease knowledge artifact to the real disease it is about, a disposition borne by an organism. Only point of contact between the informational layer of OntoSim-Dis and the realist ontology OGMS.</rdfs:comment>
        <rdfs:label xml:lang="en">representsDisease</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#representsHealthState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#representsHealthState">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:comment xml:lang="fr">Déclare quel état de santé un composant d&apos;état de modèle représente. Un compartiment S et un état d&apos;agent susceptible utilisent tous deux cette même propriété.</rdfs:comment>
        <rdfs:comment xml:lang="en">States which health state a model state component stands for. A compartment S and an agent state &apos;susceptible&apos; both use this same property.</rdfs:comment>
        <rdfs:label xml:lang="en">representsHealthState</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#representsPhaseOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#representsPhaseOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
        <rdfs:comment xml:lang="fr">Lie un état de santé à la phase du cours de maladie qu&apos;il représente. Un état de santé n&apos;est pas une phase réelle : c&apos;est une abstraction de modélisation qui en tient lieu.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a health state to the phase of the disease course it stands for. A health state is not a real phase: it is a modelling abstraction standing in for one.</rdfs:comment>
        <rdfs:label xml:lang="en">representsPhaseOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#representsStateTransition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#representsStateTransition">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransitionComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
        <rdfs:comment xml:lang="fr">Déclare quelle transition d&apos;état de santé un composant de transition de modèle représente.</rdfs:comment>
        <rdfs:comment xml:lang="en">States which health state transition a model transition component stands for.</rdfs:comment>
        <rdfs:label xml:lang="en">representsStateTransition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#supersedesHealthState -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#supersedesHealthState">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:comment xml:lang="en">Order of progression between health states, where one exists.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Ordre de progression entre états de santé, lorsqu&apos;il en existe un.</rdfs:comment>
        <rdfs:label xml:lang="en">supersedesHealthState</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#supersedesClinicalProgression"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#transmittedThroughRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#transmittedThroughRole">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="fr">Lie une voie de transmission au rôle par lequel elle passe, lorsqu&apos;elle passe par un organisme vivant ou un milieu.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a transmission route to the role it passes through, when it passes through a living organism or an environment.</rdfs:comment>
        <rdfs:label xml:lang="en">transmittedThroughRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#triggeredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#triggeredBy">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentTransition"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#InteractionType"/>
        <rdfs:comment xml:lang="fr">Lie une transition à la sorte d&apos;interaction qui la déclenche. Signature du couplage populationnel dans le paradigme multi-agents.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a transition to the kind of interaction that triggers it. Signature of population coupling in the agent-based paradigm.</rdfs:comment>
        <rdfs:label xml:lang="en">triggeredBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontosim-dis#usesScenario -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontosim-dis#usesScenario">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/ontosim-dis#SimulationScenario"/>
        <rdfs:comment xml:lang="fr">Lie un modèle aux scénarios sous lesquels il est exécuté.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a model to the scenarios under which it is run.</rdfs:comment>
        <rdfs:label xml:lang="en">usesScenario</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontosim-dis#agentTypeName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#agentTypeName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the agent category.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nom de la catégorie d&apos;agents.</rdfs:comment>
        <rdfs:label xml:lang="en">agentTypeName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#alphaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#alphaParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Paramètre de forme d&apos;une loi bêta ou gamma.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shape parameter of a beta or gamma law.</rdfs:comment>
        <rdfs:label xml:lang="en">alphaParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#averageHouseholdSize -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#averageHouseholdSize">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average number of people per household. Governs the intensity of domestic contacts.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nombre moyen de personnes par ménage. Gouverne l&apos;intensité des contacts domestiques.</rdfs:comment>
        <rdfs:label xml:lang="en">averageHouseholdSize</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#avgHumidity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#avgHumidity">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average relative humidity as a percentage.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Humidité relative moyenne en pourcentage.</rdfs:comment>
        <rdfs:label xml:lang="en">avgHumidity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#avgTemperature -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#avgTemperature">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average annual temperature, in degrees Celsius.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Température moyenne annuelle, en degrés Celsius.</rdfs:comment>
        <rdfs:label xml:lang="en">avgTemperature</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#basicReproductionNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#basicReproductionNumber">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average number of secondary cases produced by one case in a fully susceptible population.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nombre moyen de cas secondaires produits par un cas dans une population entièrement susceptible.</rdfs:comment>
        <rdfs:label xml:lang="en">basicReproductionNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#behaviorExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#behaviorExpression">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Behavior"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Expression textuelle de la règle de comportement.</rdfs:comment>
        <rdfs:comment xml:lang="en">Textual expression of the behaviour rule.</rdfs:comment>
        <rdfs:label xml:lang="en">behaviorExpression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#betaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#betaParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Second paramètre de forme d&apos;une loi bêta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Second shape parameter of a beta law.</rdfs:comment>
        <rdfs:label xml:lang="en">betaParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#caseFatalityRate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#caseFatalityRate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Fraction des cas symptomatiques se terminant par un décès, entre 0 et 1. Générique : vaut pour toute maladie létale.</rdfs:comment>
        <rdfs:comment xml:lang="en">Fraction of symptomatic cases that end in death, between 0 and 1. Generic: applies to any lethal disease.</rdfs:comment>
        <rdfs:label xml:lang="en">caseFatalityRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#compartmentInitialSize -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#compartmentInitialSize">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Nombre d&apos;individus dans le compartiment au début de la simulation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number of individuals in the compartment at the start of the simulation.</rdfs:comment>
        <rdfs:label xml:lang="en">compartmentInitialSize</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#compartmentSymbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#compartmentSymbol">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Symbol of the compartment in the equations, for instance S or I.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Symbole du compartiment dans les équations, par exemple S ou I.</rdfs:comment>
        <rdfs:label xml:lang="en">compartmentSymbol</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#contactRatePerDay -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#contactRatePerDay">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InteractionType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average number of interactions of this kind per agent and per day.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nombre moyen d&apos;interactions de cette sorte par agent et par jour.</rdfs:comment>
        <rdfs:label xml:lang="en">contactRatePerDay</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#coverageRate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#coverageRate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Fraction de la population visée effectivement atteinte par l&apos;intervention, entre 0 et 1. Pour une vaccination, c&apos;est le taux de vaccination.</rdfs:comment>
        <rdfs:comment xml:lang="en">Fraction of the target population actually reached by the intervention, between 0 and 1. For a vaccination, this is the vaccination rate.</rdfs:comment>
        <rdfs:label xml:lang="en">coverageRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#creationDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#creationDate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date de création du modèle.</rdfs:comment>
        <rdfs:comment xml:lang="en">Date the model was created.</rdfs:comment>
        <rdfs:label xml:lang="en">creationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#defaultValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#defaultValue">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Valeur utilisée lorsqu&apos;aucune n&apos;est fournie.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value used when none is supplied.</rdfs:comment>
        <rdfs:label xml:lang="en">defaultValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#determinantExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#determinantExpression">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Expression textuelle du déterminant, par exemple beta * I / N.</rdfs:comment>
        <rdfs:comment xml:lang="en">Textual expression of the determinant, for instance beta * I / N.</rdfs:comment>
        <rdfs:label xml:lang="en">determinantExpression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#diseaseName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#diseaseName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Nom officiel de la maladie.</rdfs:comment>
        <rdfs:comment xml:lang="en">Official name of the disease.</rdfs:comment>
        <rdfs:label xml:lang="en">diseaseName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#endDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#endDate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationScenario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date de fin du scénario.</rdfs:comment>
        <rdfs:comment xml:lang="en">End date of the scenario.</rdfs:comment>
        <rdfs:label xml:lang="en">endDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#equationExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#equationExpression">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DifferentialEquation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Expression textuelle de l&apos;équation, par exemple dS/dt = -beta * S * I / N.</rdfs:comment>
        <rdfs:comment xml:lang="en">Textual expression of the equation, for instance dS/dt = -beta * S * I / N.</rdfs:comment>
        <rdfs:label xml:lang="en">equationExpression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#executionStatus -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#executionStatus">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationExecution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">State of the execution: pending, running, completed, failed.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État de l&apos;exécution : en attente, en cours, terminée, échouée.</rdfs:comment>
        <rdfs:label xml:lang="en">executionStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasAuthor -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hasAuthor">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Le nom de l&apos;auteur du modèle est sous forme de texte et non en classe. </rdfs:comment>
        <rdfs:comment xml:lang="en">The model author&apos;s name is stored as text rather than as a class.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAuthor</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAuthor"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasPermanentImmunity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hasPermanentImmunity">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True when the immunity acquired after recovery lasts for life.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Vrai lorsque l&apos;immunité acquise après guérison dure toute la vie.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPermanentImmunity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasRefToDO -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hasRefToDO">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Disease Ontology identifier. Attaches the medical taxonomy, deliberately kept OUTSIDE the structure of the ontology.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Identifiant Disease Ontology. Rattache la taxonomie médicale, délibérément tenue HORS de la structure de l&apos;ontologie.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRefToDO</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToDO"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasRefToICD -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hasRefToICD">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Code CIM de la maladie. Reprend la convention d&apos;OSDi pour faciliter l&apos;alignement.</rdfs:comment>
        <rdfs:comment xml:lang="en">ICD code of the disease. Follows the OSDi convention to ease alignment.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRefToICD</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToICD"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasRefToNCBITaxon -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hasRefToNCBITaxon">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Identifiant NCBI Taxonomy de l&apos;agent pathogène. Rattache la taxonomie biologique, délibérément tenue hors de la structure de l&apos;ontologie.</rdfs:comment>
        <rdfs:comment xml:lang="en">NCBI Taxonomy identifier of the pathogen. Attaches the biological taxonomy, deliberately kept outside the structure of the ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRefToNCBITaxon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hasRefToSNOMED -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hasRefToSNOMED">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Identifiant SNOMED CT de la maladie. Reprend la convention d&apos;OSDi.</rdfs:comment>
        <rdfs:comment xml:lang="en">SNOMED CT identifier of the disease. Follows the OSDi convention.</rdfs:comment>
        <rdfs:label xml:lang="en">hasRefToSNOMED</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSNOMED"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#healthStateName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#healthStateName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the health state.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nom de l&apos;état de santé.</rdfs:comment>
        <rdfs:label xml:lang="en">healthStateName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#hospitalCapacity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#hospitalCapacity">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthInfrastructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Nombre de lits disponibles. Fixe le seuil de saturation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number of beds available. Sets the saturation threshold.</rdfs:comment>
        <rdfs:label xml:lang="en">hospitalCapacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#incubationPeriodDays -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#incubationPeriodDays">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average time between infection and the first symptoms, in days.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Durée moyenne entre l&apos;infection et les premiers symptômes, en jours.</rdfs:comment>
        <rdfs:label xml:lang="en">incubationPeriodDays</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#infectiousPeriodDays -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#infectiousPeriodDays">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average duration during which a host can transmit, in days.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Durée moyenne pendant laquelle un hôte peut transmettre, en jours.</rdfs:comment>
        <rdfs:label xml:lang="en">infectiousPeriodDays</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#initialAgentCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#initialAgentCount">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#AgentType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Nombre d&apos;agents de cette catégorie au début de la simulation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number of agents of this category at the start of the simulation.</rdfs:comment>
        <rdfs:label xml:lang="en">initialAgentCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#interactionProbability -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#interactionProbability">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InteractionType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Probability that the interaction leads to the transition it triggers.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Probabilité que l&apos;interaction entraîne la transition qu&apos;elle déclenche.</rdfs:comment>
        <rdfs:label xml:lang="en">interactionProbability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#interventionEndDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#interventionEndDate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date de fin de l&apos;intervention, ce qui permet de modéliser les interventions intermittentes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Date the intervention stops, which allows intermittent interventions to be modelled.</rdfs:comment>
        <rdfs:label xml:lang="en">interventionEndDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#interventionIntensity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#interventionIntensity">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Intensity of the intervention, between 0 and 1. 0 means no effect, 1 means maximal effect.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Intensité de l&apos;intervention, entre 0 et 1. 0 signifie aucun effet, 1 un effet maximal.</rdfs:comment>
        <rdfs:label xml:lang="en">interventionIntensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#interventionStartDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#interventionStartDate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date de début d&apos;application de l&apos;intervention.</rdfs:comment>
        <rdfs:comment xml:lang="en">Date the intervention starts being applied.</rdfs:comment>
        <rdfs:label xml:lang="en">interventionStartDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#isAbsorbingState -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#isAbsorbingState">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True when no transition leaves this state, for instance death.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Vrai lorsqu&apos;aucune transition ne quitte cet état, par exemple le décès.</rdfs:comment>
        <rdfs:label xml:lang="en">isAbsorbingState</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#lambdaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#lambdaParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Paramètre de taux d&apos;une loi exponentielle, gamma ou de Poisson.</rdfs:comment>
        <rdfs:comment xml:lang="en">Rate parameter of an exponential, gamma or Poisson law.</rdfs:comment>
        <rdfs:label xml:lang="en">lambdaParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#latentPeriodDays -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#latentPeriodDays">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Average time between infection and the moment the host becomes infectious, in days. Distinct from the incubation period: one may transmit before showing symptoms.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Durée moyenne entre l&apos;infection et le moment où l&apos;hôte devient infectieux, en jours. Distincte de la période d&apos;incubation : on peut transmettre avant d&apos;avoir des symptômes.</rdfs:comment>
        <rdfs:label xml:lang="en">latentPeriodDays</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#lowerLimitParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#lowerLimitParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Borne inférieure d&apos;une loi uniforme.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lower bound of a uniform law.</rdfs:comment>
        <rdfs:label xml:lang="en">lowerLimitParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#meanParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#meanParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Mean of a normal law.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Moyenne d&apos;une loi normale.</rdfs:comment>
        <rdfs:label xml:lang="en">meanParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#medianAge -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#medianAge">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Median age of the population, in years.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Âge médian de la population, en années.</rdfs:comment>
        <rdfs:label xml:lang="en">medianAge</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#modelDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#modelDescription">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Description libre du modèle.</rdfs:comment>
        <rdfs:comment xml:lang="en">Free-text description of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">modelDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#modelName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#modelName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the model.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nom du modèle</rdfs:comment>
        <rdfs:label xml:lang="en">modelName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#modelVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#modelVersion">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Version du modèle.</rdfs:comment>
        <rdfs:comment xml:lang="en">Version of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">modelVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#numberOfRuns -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#numberOfRuns">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Nombre de répétitions de l&apos;exécution, utile pour les modèles stochastiques.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number of repetitions of the execution, useful for stochastic models.</rdfs:comment>
        <rdfs:label xml:lang="en">numberOfRuns</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#numberOfZones -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#numberOfZones">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Nombre de sous-zones administratives.</rdfs:comment>
        <rdfs:comment xml:lang="en">Number of administrative sub-zones.</rdfs:comment>
        <rdfs:label xml:lang="en">numberOfZones</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#parameterName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#parameterName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the parameter, for instance beta.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nom du paramètre, par exemple beta.</rdfs:comment>
        <rdfs:label xml:lang="en">parameterName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#parameterUnit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#parameterUnit">
