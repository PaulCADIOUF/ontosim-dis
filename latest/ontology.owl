        <rdfs:comment xml:lang="en">Unit of the parameter, for instance day^-1.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Unité du paramètre, par exemple jour^-1.</rdfs:comment>
        <rdfs:label xml:lang="en">parameterUnit</rdfs:label>
    </owl:DatatypeProperty>
    


