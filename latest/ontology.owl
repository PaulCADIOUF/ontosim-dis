        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Expression textuelle du taux, par exemple beta * I / N.</rdfs:comment>
        <rdfs:comment xml:lang="en">Textual expression of the rate, for instance beta * I / N.</rdfs:comment>
        <rdfs:label xml:lang="en">rateExpression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#regionName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#regionName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Nom officiel du territoire.</rdfs:comment>
        <rdfs:comment xml:lang="en">Official name of the territory.</rdfs:comment>
        <rdfs:label xml:lang="en">regionName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#reinfectionPossible -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#reinfectionPossible">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True when a recovered host can be infected again.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Vrai lorsqu&apos;un hôte guéri peut être infecté à nouveau.</rdfs:comment>
        <rdfs:label xml:lang="en">reinfectionPossible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#scenarioDurationInDays -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#scenarioDurationInDays">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationScenario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Duration covered by the scenario in days</rdfs:comment>
        <rdfs:comment xml:lang="fr">Durée couverte par le scénario en jours</rdfs:comment>
        <rdfs:label xml:lang="en">scenarioDurationInDays</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#simulationDurationInDays -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#simulationDurationInDays">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Durée totale simulée en jours</rdfs:comment>
        <rdfs:comment xml:lang="en">Total simulated duration in days</rdfs:comment>
        <rdfs:label xml:lang="en">simulationDurationInDays</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#simulatorName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#simulatorName">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the simulator used, for instance JaDES, GAMA, NetLogo.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Nom du simulateur employé, par exemple JaDES, GAMA, NetLogo.</rdfs:comment>
        <rdfs:label xml:lang="en">simulatorName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#simulatorVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#simulatorVersion">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Version du simulateur employé.</rdfs:comment>
        <rdfs:comment xml:lang="en">Version of the simulator used.</rdfs:comment>
        <rdfs:label xml:lang="en">simulatorVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#standardDeviationParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#standardDeviationParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Standard deviation of a normal law.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Écart type d&apos;une loi normale</rdfs:comment>
        <rdfs:label xml:lang="en">standardDeviationParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#startDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#startDate">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#SimulationScenario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date de début du scénario.</rdfs:comment>
        <rdfs:comment xml:lang="en">Start date of the scenario.</rdfs:comment>
        <rdfs:label xml:lang="en">startDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#timeStepInDays -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#timeStepInDays">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">Duration of one simulation step in days</rdfs:comment>
        <rdfs:comment xml:lang="fr">Durée d&apos;un pas de simulation en jours</rdfs:comment>
        <rdfs:label xml:lang="en">timeStepInDays</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontosim-dis#upperLimitParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontosim-dis#upperLimitParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="fr">Borne supérieure d&apos;une loi uniforme.</rdfs:comment>
        <rdfs:comment xml:lang="en">Upper bound of a uniform law.</rdfs:comment>
        <rdfs:label xml:lang="en">upperLimitParameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <obo:IAO_0000116 xml:lang="en">BFO:0000001 - imported via MIREOT. Root of the entire BFO hierarchy.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="fr">BFO:0000001 - importé via MIREOT. Racine de toute la hiérarchie BFO.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">An entity is anything that exists or has existed or will exist.</rdfs:comment>
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/bfo.owl</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000116 xml:lang="en">Entities persisting over time: models, diseases, populations.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="fr">Entités persistant dans le temps : modèles, maladies, populations.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity.</rdfs:comment>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/bfo.owl</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000116 xml:lang="en">BFO:0000003 - imported via MIREOT. Superclass of all processes in OntoSim-Dis.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="fr">BFO:0000003 - importé via MIREOT. Superclasse de tous les processus dans OntoSim-Dis.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">An occurrent is an entity that unfolds itself in time or it is the instantaneous boundary of such an entity (for example a beginning or an ending) or it is a temporal or spatiotemporal region which such an entity occupies_temporal_region or occupies_spatiotemporal_region.</rdfs:comment>
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/bfo.owl</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:comment xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t.</rdfs:comment>
        <rdfs:label xml:lang="en">independent continuant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">An occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t.</rdfs:comment>
        <rdfs:label xml:lang="en">process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000016 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:comment xml:lang="fr">Dire que « b est une disposition » signifie que : b est une entité réalisable ; le porteur de b est une entité matérielle ; b est telle que, si elle cesse d&apos;exister, son porteur subit une modification physique ; la réalisation de b survient lorsque, et parce que, ce porteur se trouve dans certaines circonstances physiques particulières, et cette réalisation se produit en vertu de la constitution physique du porteur.</rdfs:comment>
        <rdfs:comment xml:lang="en">b is a disposition means: b is a realizable entity &amp; b’s bearer is some material entity &amp; b is such that if it ceases to exist, then its bearer is physically changed, &amp; b’s realization occurs when and because this bearer is in some special physical circumstances, &amp; this realization occurs in virtue of the bearer’s physical make-up.</rdfs:comment>
        <rdfs:label xml:lang="en">disposition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="fr">Dire que b est une entité réalisable revient à dire que b est un continuant spécifiquement dépendant qui inhère dans un continuant indépendant, autre qu&apos;une région spatiale, et qui est d&apos;un type dont les instances sont réalisées au cours de processus d&apos;un type corrélé.</rdfs:comment>
        <rdfs:comment xml:lang="en">To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type.</rdfs:comment>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000019 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <rdfs:comment xml:lang="en">a quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized.</rdfs:comment>
        <rdfs:label xml:lang="en">quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:comment xml:lang="en">b is a specifically dependent continuant = Def. b is a continuant &amp; there is some independent continuant c which is not a spatial region and which is such that b s-depends_on c at every time t during the course of b’s existence.</rdfs:comment>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/bfo.owl</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:comment xml:lang="en">b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities.</rdfs:comment>
        <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:comment xml:lang="en">A material entity is an independent continuant that has some portion of matter as proper or improper continuant part.</rdfs:comment>
        <rdfs:label xml:lang="en">material entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000141 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:label xml:lang="en">immaterial entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000116 xml:lang="en">Direct superclass of dsim:SimulationKnowledgeArtifact (Layer 2). Groups all informational artifacts of the ontology.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="fr">Superclasse directe de dsim:SimulationKnowledgeArtifact (Couche 2). Regroupe tous les artefacts informationnels de l&apos;ontologie</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">A generically dependent continuant that is about some thing.</rdfs:comment>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000030 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:comment xml:lang="en">A disposition in an organism that constitutes an increased risk of the organism&apos;s subsequently developing the disease X.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une prédisposition chez un organisme qui constitue un risque accru pour cet organisme de développer ultérieurement la maladie X.</rdfs:comment>
        <rdfs:label xml:lang="en">predisposition to disease of type X</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasMaterialBasisIn"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A disposition (i) to undergo pathological processes that (ii) exists in an organism because of one or more disorders in that organism.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une prédisposition (i) à subir des processus pathologiques qui (ii) existe chez un organisme en raison d&apos;un ou plusieurs troubles affectant cet organisme.</rdfs:comment>
        <rdfs:label xml:lang="en">disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000045 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000087"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A material entity which is clinically abnormal and part of an extended organism. Disorders are the physical basis of disease.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une entité matérielle cliniquement anormale et faisant partie d&apos;un organisme étendu. Les troubles constituent le fondement physique de la maladie.</rdfs:comment>
        <rdfs:label xml:lang="en">disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000063 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">The totality of all processes through which a given disease instance is realized.</rdfs:comment>
        <rdfs:label xml:lang="en">disease course</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000064 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
        <rdfs:comment xml:lang="en">A disease course that (a) does not terminate in a return to normal homeostasis and (b) would, absent intervention, fall within abnormal homeostatic range.</rdfs:comment>
        <rdfs:label xml:lang="en">chronic disease course</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000065 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
        <rdfs:comment xml:lang="en">A disease course that (a) does not terminate in a return to normal homeostasis and (b) would, absent intervention, involve an increasing deviation from homeostasis.</rdfs:comment>
        <rdfs:label xml:lang="en">progressive disease course</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000066 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
        <rdfs:comment xml:lang="en">A disease course that terminates in a return to normal homeostasis.</rdfs:comment>
        <rdfs:label xml:lang="en">transient disease course</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000084 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">An aggregate of organisms of the same type.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un regroupement d&apos;organismes du même type.</rdfs:comment>
        <rdfs:label xml:lang="en">organism population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000087 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">An object aggregate consisting of an organism and all material entities located within the organism, overlapping the organism, or occupying sites formed in part by the organism.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un agrégat d&apos;objets constitué d&apos;un organisme et de toutes les entités matérielles situées à l&apos;intérieur de l&apos;organisme, chevauchant l&apos;organisme ou occupant des sites formés en partie par l&apos;organisme.</rdfs:comment>
        <rdfs:label xml:lang="en">extended organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000094 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
        <rdfs:comment xml:lang="en">A disease course with an acute onset.</rdfs:comment>
        <rdfs:label xml:lang="en">acute disease course</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AcuteCourseDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AcuteCourseDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasDiseaseCourseShape"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000094"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="en">A disease with an abrupt onset. Fourth course shape recognised by OGMS, alongside the chronic, progressive and transient forms. Constrains the structure of the model little, but qualifies the dynamics of entry.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Maladie à début brutal. Quatrième forme de cours reconnue par OGMS, aux côtés des formes chronique, progressive et transitoire. Contraint peu la structure du modèle mais qualifie la dynamique d&apos;entrée.</rdfs:comment>
        <rdfs:label xml:lang="en">AcuteCourseDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AdministrativeRegion -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AdministrativeRegion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="en">Administrative division of a country. Senegal has fourteen of them.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Division administrative d&apos;un pays. Le Sénégal en compte quatorze.</rdfs:comment>
        <rdfs:label xml:lang="en">AdministrativeRegion</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AgentBasedModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AgentBasedModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasAgentType"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#AgentType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasBehavior"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#Behavior"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A model in which autonomous agents, each following its own behaviour, interact and produce the behaviour of the system.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle dans lequel des agents autonomes, suivant chacun son comportement, interagissent et produisent le comportement du système.</rdfs:comment>
        <rdfs:label xml:lang="en">AgentBasedModel</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AgentBasedModel"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AgentState -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AgentState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
        <rdfs:comment xml:lang="en">A state an agent can occupy. Agent-based form of a state component.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État qu&apos;un agent peut occuper. Forme multi-agents d&apos;un composant d&apos;état.</rdfs:comment>
        <rdfs:label xml:lang="en">AgentState</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AgentTransition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AgentTransition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#TransitionComponent"/>
        <rdfs:comment xml:lang="en">A change of state of an agent. Inherits from the layer 2 transition its source and target states.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Changement d&apos;état d&apos;un agent. Hérite de la transition de couche 2 ses états de départ et d&apos;arrivée.</rdfs:comment>
        <rdfs:label xml:lang="en">AgentTransition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AgentType -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AgentType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="en">A category of autonomous entities in the model. 
The individual agent is not modelled because it exists only at run time.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Catégorie d&apos;entités autonomes du modèle.
L&apos;agent individuel n&apos;est pas modélisé car il n&apos;existe qu&apos;à l&apos;exécution.</rdfs:comment>
        <rdfs:label xml:lang="en">AgentType</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AridClimate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AridClimate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
        <rdfs:comment xml:lang="fr">Climat sec à faibles précipitations.</rdfs:comment>
        <rdfs:comment xml:lang="en">Dry climate with little rainfall.</rdfs:comment>
        <rdfs:label xml:lang="en">AridClimate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#AttributeDrivenTransition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#AttributeDrivenTransition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#AgentTransition"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#InteractionTriggeredTransition"/>
        <rdfs:comment xml:lang="en">A transition triggered by the agent&apos;s own attributes alone: its age, the time spent in its current state. Individual determinant.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Transition déclenchée par les seuls attributs de l&apos;agent : son âge, le temps passé dans son état courant. Déterminant individuel.</rdfs:comment>
        <rdfs:label xml:lang="en">AttributeDrivenTransition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Bacterium -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Bacterium">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:comment xml:lang="fr">Agent pathogène unicellulaire dépourvu de noyau.</rdfs:comment>
        <rdfs:comment xml:lang="en">Single-celled pathogen without a nucleus.</rdfs:comment>
        <rdfs:label xml:lang="en">Bacterium</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Behavior -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Behavior">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#RuleComponent"/>
        <rdfs:comment xml:lang="en">A rule saying what an agent does according to its state and its surroundings.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Règle disant ce que fait un agent selon son état et ce qui l&apos;entoure.</rdfs:comment>
        <rdfs:label xml:lang="en">Behavior</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#BernoulliDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#BernoulliDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#probabilityParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Law of a single trial with two outcomes, of given probability.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi d&apos;un tirage unique à deux issues de probabilité donnée.</rdfs:comment>
        <rdfs:label xml:lang="en">BernoulliDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#BetaDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#BetaDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#alphaParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#betaParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Law on the interval zero to one, used for proportions and probabilities.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi sur l&apos;intervalle de zéro à un, employée pour les proportions et les probabilités.</rdfs:comment>
        <rdfs:label xml:lang="en">BetaDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ChronicCourseDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ChronicCourseDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasDiseaseCourseShape"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000064"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="en">A disease whose course does not return to normal homeostasis. Requires at least one absorbing state.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Maladie dont le cours ne revient pas à l&apos;homéostasie normale. Impose au moins un état absorbant.</rdfs:comment>
        <rdfs:label xml:lang="en">ChronicCourseDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#City -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#City">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="fr">Localité urbaine.</rdfs:comment>
        <rdfs:comment xml:lang="en">Urban locality</rdfs:comment>
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Climate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Climate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">Climatic conditions influencing disease transmission. Decisive for vector-borne and water-borne diseases, where temperature and humidity govern the life cycle of the vector or of the intermediate host.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Conditions climatiques influençant la transmission des maladies. Déterminantes pour les maladies à vecteur et à transmission hydrique, où température et humidité gouvernent le cycle de vie du vecteur ou de l&apos;hôte intermédiaire.</rdfs:comment>
        <rdfs:label xml:lang="en">Climate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Compartment -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Compartment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
        <rdfs:comment xml:lang="en">A group of individuals sharing the same situation, counted together. Compartmental form of a state component.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Groupe d&apos;individus partageant la même situation, comptés ensemble. Forme compartimentale d&apos;un composant d&apos;état.</rdfs:comment>
        <rdfs:label xml:lang="en">Compartment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CompartmentDependentRate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CompartmentDependentRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#RateSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#dependsOnCompartment"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#ConstantRate"/>
        <rdfs:comment xml:lang="en">A rate whose value depends on the current content of one or more compartments, which makes the system non-linear and coupled. Compartmental form of population coupling.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Taux dont la valeur dépend du contenu courant d&apos;un ou plusieurs compartiments, ce qui rend le système non linéaire et couplé. Forme compartimentale du couplage populationnel.</rdfs:comment>
        <rdfs:label xml:lang="en">CompartmentDependentRate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CompartmentalModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CompartmentalModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasCompartment"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasFlow"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A model dividing the population into compartments, between which flows carry individuals at rates.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle divisant la population en compartiments, entre lesquels des flux font passer les individus à certains taux.</rdfs:comment>
        <rdfs:label xml:lang="en">CompartmentalModel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ConstantRate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ConstantRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#RateSpecification"/>
        <rdfs:comment xml:lang="en">A rate that does not depend on the current content of any compartment. Individual determinant. &apos;Constant&apos; means here independent of the compartments, not fixed in time: a seasonal rate that reads no compartment is also a ConstantRate. It is then declared as such, and its value is written with rateExpression, since rateConstantValue only gives a fixed value.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Taux qui ne dépend du contenu courant d&apos;aucun compartiment. Déterminant individuel. « Constant » veut dire ici indépendant des compartiments, et non fixe dans le temps : un taux saisonnier qui ne lit aucun compartiment est aussi un ConstantRate. On le déclare alors comme tel, et sa valeur s&apos;écrit avec rateExpression, car rateConstantValue ne donne qu&apos;une valeur fixe.</rdfs:comment>
        <rdfs:label xml:lang="en">ConstantRate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ContextKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ContextKnowledge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasClimate"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasHealthInfrastructure"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontosim-dis#HealthInfrastructure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasGeographicRegion"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasPopulation"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Deuxième composant du Quadruplet de recomposition (CK). Décrit où, pour qui et dans quelles conditions un modèle s&apos;applique.</rdfs:comment>
        <rdfs:comment xml:lang="en">Second component of the recomposition Quadruplet (CK). Describes where, for whom and under which conditions a model applies.</rdfs:comment>
        <rdfs:label xml:lang="en">ContextKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Country -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Country">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="en">Highest administrative level.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Niveau administratif le plus haut.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CoupledAgentBasedModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CoupledAgentBasedModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#AgentBasedModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasAgentTransition"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#InteractionTriggeredTransition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#AgentBasedModel"/>
        <rdfs:comment xml:lang="en">An agent-based model containing at least one transition triggered by an interaction. Inferred by the reasoner without anyone declaring the model infectious.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle multi-agents comportant au moins une transition déclenchée par une interaction. Inféré par le raisonneur sans que personne ait déclaré le modèle infectieux.</rdfs:comment>
        <rdfs:label xml:lang="en">CoupledAgentBasedModel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CoupledCompartmentalModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CoupledCompartmentalModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#CompartmentalModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasFlow"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#CoupledFlow"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#CompartmentalModel"/>
        <rdfs:comment xml:lang="en">A compartmental model containing at least one coupled flow. Inferred by the reasoner without anyone declaring the model infectious.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle compartimental comportant au moins un flux couplé. Inféré par le raisonneur sans que personne ait déclaré le modèle infectieux.</rdfs:comment>
        <rdfs:label xml:lang="en">CoupledCompartmentalModel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CoupledDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CoupledDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasStateTransition"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#CoupledTransition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="fr">Connaissance de maladie comportant au moins une transition couplée. Le raisonneur classe ici toute maladie dont une transition dépend de l&apos;état de la population, SANS qu&apos;on ait déclaré qu&apos;elle est infectieuse.</rdfs:comment>
        <rdfs:comment xml:lang="en">Disease knowledge containing at least one coupled transition. The reasoner classifies here any disease one of whose transitions depends on the state of the population WITHOUT anyone having declared it infectious.</rdfs:comment>
        <rdfs:label xml:lang="en">CoupledDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CoupledFlow -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CoupledFlow">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#TransitionFlow"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasRate"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#CompartmentDependentRate"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
        <rdfs:comment xml:lang="en">A flow whose rate depends on the content of a compartment.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Flux dont le taux dépend du contenu d&apos;un compartiment.</rdfs:comment>
        <rdfs:label xml:lang="en">CoupledFlow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CoupledTransition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CoupledTransition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#HealthStateTransition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#isGovernedBy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
        <rdfs:comment xml:lang="en">A health state transition governed by at least one population-coupled determinant.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Transition d&apos;état de santé gouvernée par au moins un déterminant couplé à la population.</rdfs:comment>
        <rdfs:label xml:lang="en">CoupledTransition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#CouplingSource -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#CouplingSource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">A category whose current head count can be read, and whose reading may make a risk vary. Abstract class: never instantiated directly, only subclassed. A human health state in the core, a reservoir state in the infectious extension.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Catégorie dont on peut lire l&apos;effectif courant et dont la lecture peut faire varier un risque. Classe abstraite : on n&apos;en crée jamais d&apos;instance directe, seulement des sous-classes. Un état de santé humain dans le noyau, un état de réservoir dans l&apos;extension infectieuse.</rdfs:comment>
        <rdfs:label xml:lang="en">CouplingSource</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#DetectionIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#DetectionIntervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasSensitivity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasSpecificity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An intervention whose purpose is to find out whether an individual has the disease, rather than to treat it. It changes a determinant through what it triggers: a detected individual is treated, followed up or isolated.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Intervention dont le but est de savoir si un individu a la maladie, et non de la soigner. Elle modifie un déterminant par l&apos;intermédiaire de ce qu&apos;elle déclenche : un individu détecté est traité, suivi ou isolé.</rdfs:comment>
        <rdfs:label xml:lang="en">DetectionIntervention</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#DiagnosisIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#DiagnosisIntervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DetectionIntervention"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#ScreeningIntervention"/>
        <rdfs:comment xml:lang="en">Detection applied to an individual who already shows signs of the disease. This is what clinical practice does in the absence of screening.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Détection appliquée à un individu présentant déjà des signes de la maladie. C&apos;est ce que fait la pratique clinique en l&apos;absence de dépistage.</rdfs:comment>
        <rdfs:label xml:lang="en">DiagnosisIntervention</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#DifferentialEquation -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#DifferentialEquation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#involvesFlow"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#governsCompartment"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#Compartment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The equation giving the variation over time of the content of one compartment, as the balance of the flows entering and leaving it.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Équation donnant la variation dans le temps du contenu d&apos;un compartiment, comme bilan des flux qui y entrent et en sortent.</rdfs:comment>
        <rdfs:label xml:lang="en">DifferentialEquation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#DirectlyCoupledDeterminant -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#DirectlyCoupledDeterminant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#dependsOnCountIn"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
        <rdfs:comment xml:lang="fr">Classe DÉFINIE : déterminant dont la valeur se lit sur un effectif d&apos;humains. Signature de la transmission interhumaine directe. Le raisonneur y classe la force d&apos;infection du COVID, de la grippe, de la rougeole. N&apos;est PAS disjointe de IndirectlyCoupledDeterminant : un risque peut lire les deux à la fois, ce qui est le cas du cycle complet de la schistosomiase.</rdfs:comment>
        <rdfs:comment xml:lang="en">DEFINED class: a determinant whose value is read off a head count of humans. Signature of direct person-to-person transmission. NOT disjoint from IndirectlyCoupledDeterminant: one risk may read both, which is the case of the full schistosomiasis cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">DirectlyCoupledDeterminant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#representsDisease"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasDiseaseCourseShape"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasRiskFactor"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontosim-dis#RiskFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasHealthState"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasStateTransition"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#HealthStateTransition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">First component of the recomposition Quadruplet (DK). Structured knowledge about a disease, independent of its type, of the modelling paradigm and of the geographical context. It is an information artifact: it is ABOUT a disease, it is not the disease.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Premier composant du Quadruplet de recomposition (DK). Connaissance structurée sur une maladie, indépendante de son type, du paradigme de modélisation et du contexte géographique. C&apos;est un artefact d&apos;information : il est À PROPOS d&apos;une maladie, il n&apos;est pas la maladie.</rdfs:comment>
        <rdfs:label xml:lang="en">DiseaseKnowledgeTemplate</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#District -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#District">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
        <rdfs:comment xml:lang="en">Administrative division of a region.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Division administrative d&apos;une région.</rdfs:comment>
        <rdfs:label xml:lang="en">District</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#DynamicParameter -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#DynamicParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#StaticParameter"/>
        <rdfs:comment xml:lang="en">A parameter whose value varies with time, for instance a time-dependent transmission rate.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Paramètre dont la valeur varie dans le temps, par exemple un taux de transmission dépendant du temps.</rdfs:comment>
        <rdfs:label xml:lang="en">DynamicParameter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#EnvironmentComponent -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#EnvironmentComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="en">An external or contextual factor influencing the modelled system: weather, terrain, infrastructure.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Facteur externe ou contextuel influençant le système modélisé : météo, relief, infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">EnvironmentComponent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#EnvironmentModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#EnvironmentModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#EnvironmentComponent"/>
        <rdfs:comment xml:lang="fr">Milieu dans lequel les agents se déplacent et se rencontrent. Sa nature spatiale est donnée par le type d&apos;espace de la structure de modèle, en couche 2 et n&apos;est pas répétée ici.</rdfs:comment>
        <rdfs:comment xml:lang="en">The surroundings in which agents move and meet. Its spatial nature is given by the spatial type of the model structure, in layer 2 and is not repeated here.</rdfs:comment>
        <rdfs:label xml:lang="en">EnvironmentModel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#EnvironmentallyMediatedDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#EnvironmentallyMediatedDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasReservoirState"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"/>
        <rdfs:comment xml:lang="fr">Classe DÉFINIE : maladie infectieuse dont la transmission passe par un effectif non
humain. Le raisonneur l&apos;infère à partir de la structure du modèle, SANS que personne
ait déclaré la maladie environnementale. Schistosomiase, paludisme et choléra y
tombent ; COVID, grippe et rougeole n&apos;y tombent pas.</rdfs:comment>
        <rdfs:comment xml:lang="en">DEFINED class: an infectious disease whose transmission goes through a non-human head count. The reasoner infers it from the structure of the model, WITHOUT anyone having declared the disease environmental. Schistosomiasis, malaria and cholera fall here; COVID, influenza and measles do not.</rdfs:comment>
        <rdfs:label xml:lang="en">EnvironmentallyMediatedDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#EpidemiologicalRole -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#EpidemiologicalRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Part qu&apos;un organisme prend dans la transmission d&apos;une maladie.</rdfs:comment>
        <rdfs:comment xml:lang="en">The part an organism plays in the transmission of a disease.</rdfs:comment>
        <rdfs:label xml:lang="en">EpidemiologicalRole</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ExecutionKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ExecutionKnowledge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Comment exécuter le modèle : quel simulateur, combien de répétitions, avec quelle graine aléatoire. Quatrième composant du Quadruplet, à côté de la connaissance de la maladie, du contexte et de la structure. Ce n&apos;est pas l&apos;exécution elle-même, qui est un processus, mais la configuration que cette exécution réalise.</rdfs:comment>
        <rdfs:comment xml:lang="en">How to run the model: which simulator, how many runs, with which random seed. Fourth component of the Quadruplet, alongside disease, context and structure knowledge. It is not the execution itself, which is a process, but the configuration that execution realises.</rdfs:comment>
        <rdfs:label xml:lang="en">ExecutionKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ExponentialDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ExponentialDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#lambdaParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Law of the time between two events occurring at a constant rate.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi du temps séparant deux événements survenant à taux constant.</rdfs:comment>
        <rdfs:label xml:lang="en">ExponentialDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ExponentialDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#FreeLivingStageState -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#FreeLivingStageState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#NonHumanHostState"/>
        <rdfs:comment xml:lang="fr">Effectif d&apos;un stade libre de l&apos;agent pathogène présent dans un milieu, hors de tout hôte. Les cercaires dans l&apos;eau, les miracidies. Sous l&apos;hypothèse de quasi-équilibre, cet effectif se lit sur celui des hôtes qui le produisent et n&apos;a pas besoin d&apos;un compartiment propre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Head count of a free-living stage of the pathogen present in an environment, outside any host. The cercariae in the water, the miracidia. Under the quasi-equilibrium assumption, this head count is read off that of the hosts producing it and needs no compartment of its own.</rdfs:comment>
        <rdfs:label xml:lang="en">FreeLivingStageState</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Fungus -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Fungus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:comment xml:lang="fr">Champignon pathogène.</rdfs:comment>
        <rdfs:comment xml:lang="en">Pathogenic fungus.</rdfs:comment>
        <rdfs:label xml:lang="en">Fungus</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#GammaDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#GammaDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#alphaParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#lambdaParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Law on positive values, used for costs and durations.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi sur les valeurs positives, employée pour les coûts et les durées.</rdfs:comment>
        <rdfs:label xml:lang="en">GammaDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#GeographicRegion -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#GeographicRegion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Territoire auquel un modèle s&apos;applique. Quatre niveaux administratifs : pays, région, district, ville.</rdfs:comment>
        <rdfs:comment xml:lang="en">The territory a model applies to. Four administrative levels: country, region, district, city.</rdfs:comment>
        <rdfs:label xml:lang="en">GeographicRegion</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#GranularityLevel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#GranularityLevel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#GROUP"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#INDIVIDUAL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#MULTISCALE"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#REGIONAL"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">Level of detail at which the modelled entities are described. Closed list.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Niveau de détail auquel les entités modélisées sont décrites. Liste fermée.</rdfs:comment>
        <rdfs:label xml:lang="en">GranularityLevel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#HealthCentre -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#HealthCentre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#HealthInfrastructure"/>
        <rdfs:comment xml:lang="en">Local facility for primary care.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Structure de proximité assurant les soins primaires.</rdfs:comment>
        <rdfs:label xml:lang="en">HealthCentre</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#HealthInfrastructure -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#HealthInfrastructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">Health facilities available in the context. Determines the capacity to respond, and the saturation threshold beyond which lethality rises.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Structures de santé disponibles dans le contexte. Détermine la capacité de réponse, et le seuil de saturation au-delà duquel la létalité augmente.</rdfs:comment>
        <rdfs:label xml:lang="en">HealthInfrastructure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#HealthState -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#HealthState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#CouplingSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#representsPhaseOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
        <rdfs:comment xml:lang="en">A state an individual can occupy with respect to a disease. It is knowledge about a phase of the disease course, NOT a component of a model: a compartment or an agent state represents it, through the bridge representsHealthState.</rdfs:comment>
        <rdfs:comment xml:lang="fr">État qu&apos;un individu peut occuper vis-à-vis d&apos;une maladie. C&apos;est une connaissance sur une phase du cours de la maladie et NON un composant de modèle : un compartiment ou un état d&apos;agent le représente, par le pont representsHealthState.</rdfs:comment>
        <rdfs:label xml:lang="en">HealthState</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#HealthStateTransition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#HealthStateTransition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#isGovernedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasSourceHealthState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasTargetHealthState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#HealthState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
        <rdfs:comment xml:lang="fr">Passage d&apos;un individu d&apos;un état de santé à un autre. Classe pivot du noyau : c&apos;est le seul endroit où la structure du modèle est décidée, parce que c&apos;est le déterminant de la transition qui impose sa forme mathématique.</rdfs:comment>
        <rdfs:comment xml:lang="en">The passage of an individual from one health state to another. Pivot class of the core: it is the only place where the structure of the model is decided, because it is the determinant of the transition that imposes its mathematical form.</rdfs:comment>
        <rdfs:label xml:lang="en">HealthStateTransition</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Hospital -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Hospital">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#HealthInfrastructure"/>
        <rdfs:comment xml:lang="en">Facility with beds, able to admit severe cases.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Structure disposant de lits, capable d&apos;accueillir les cas graves.</rdfs:comment>
        <rdfs:label xml:lang="en">Hospital</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#HostRole -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#HostRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="en">Organism in which the pathogen develops and which suffers the disease.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Organisme dans lequel l&apos;agent pathogène se développe et qui subit la maladie.</rdfs:comment>
        <rdfs:label xml:lang="en">HostRole</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#IndirectlyCoupledDeterminant -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#IndirectlyCoupledDeterminant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#dependsOnCountIn"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
        <rdfs:comment xml:lang="fr">Classe DÉFINIE : déterminant dont la valeur se lit sur un effectif non humain. Signature de la transmission médiée par un réservoir ou un milieu. Le raisonneur y classe le risque d&apos;infection de la schistosomiase, du paludisme, du choléra.</rdfs:comment>
        <rdfs:comment xml:lang="en">DEFINED class: a determinant whose value is read off a non-human head count. Signature of reservoir-mediated or environmentally mediated transmission. The reasoner classifies here the infection risk of schistosomiasis, malaria and cholera.</rdfs:comment>
        <rdfs:label xml:lang="en">IndirectlyCoupledDeterminant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#IndividualAttribute -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#IndividualAttribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">A clinical or demographic characteristic of an individual whose value can change the course of the disease: age, sex, comorbidity, biomarker, vaccination status.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Caractéristique clinique ou démographique d&apos;un individu dont la valeur peut modifier l&apos;évolution de la maladie : âge, sexe, comorbidité, biomarqueur, statut vaccinal.</rdfs:comment>
        <rdfs:label xml:lang="en">IndividualAttribute</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#IndividualDeterminant -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#IndividualDeterminant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
        <rdfs:comment xml:lang="en">A determinant whose value does not depend on the other individuals. It may read attributes of the individual concerned (age, sex, comorbidity, biomarker), or none, like the recovery rate γ of the SIR model. Structural consequence: individual trajectories are independent, which allows microsimulation and multi-state models.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Déterminant dont la valeur ne dépend pas des autres individus. Il peut lire des attributs de l&apos;individu concerné (âge, sexe, comorbidité, biomarqueur), ou aucun, comme le taux de guérison γ du modèle SIR. Conséquence structurelle : les trajectoires individuelles sont indépendantes, ce qui autorise la microsimulation et les modèles multi-états. Pleinement couvert par OSDi.</rdfs:comment>
        <rdfs:label xml:lang="en">IndividualDeterminant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#IndividualProgressionDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#IndividualProgressionDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasStateTransition"/>
                        <owl:allValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#isGovernedBy"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/ontosim-dis#IndividualDeterminant"/>
                            </owl:Restriction>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="fr">Connaissance de maladie dont toutes les transitions sont individuelles. Modélisable par microsimulation, modèle multi-états ou arbre de décision.</rdfs:comment>
        <rdfs:comment xml:lang="en">Disease knowledge all of whose transitions are individual. Modellable by microsimulation, multi-state model or decision tree.</rdfs:comment>
        <rdfs:label xml:lang="en">IndividualProgressionDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasPathogen"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasTransmissionRoute"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Connaissance d&apos;une maladie causée par un agent pathogène. Classe DÉFINIE : toute connaissance de maladie déclarant un agent pathogène est classée ici par le raisonneur, sans qu&apos;on ait à dire qu&apos;elle est infectieuse.</rdfs:comment>
        <rdfs:comment xml:lang="en">Knowledge of a disease caused by a pathogen. DEFINED class: any disease knowledge declaring a pathogen is classified here by the reasoner, without anyone having to say it is infectious.</rdfs:comment>
        <rdfs:label xml:lang="en">InfectiousDiseaseKnowledge</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#InfectiousDisease"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#InitialCondition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#InitialCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="en">A parameter giving the value of a quantity at the start of the simulation.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Paramètre donnant la valeur d&apos;une grandeur au début de la simulation.</rdfs:comment>
        <rdfs:label xml:lang="en">InitialCondition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#InteractionTriggeredTransition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#InteractionTriggeredTransition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#AgentTransition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#triggeredBy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#InteractionType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#AgentTransition"/>
        <rdfs:comment xml:lang="en">A transition triggered by an interaction with other agents, hence depending on their state. Agent-based form of population coupling. Defined class: the reasoner classifies here any agent transition triggered by an interaction.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Transition déclenchée par une interaction avec d&apos;autres agents, donc dépendant de leur état. Forme multi-agents du couplage populationnel. Classe définie : le raisonneur classe ici toute transition d&apos;agent déclenchée par une interaction.</rdfs:comment>
        <rdfs:label xml:lang="en">InteractionTriggeredTransition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#InteractionType -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#InteractionType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="en">A kind of encounter or exchange between agents.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Sorte de rencontre ou d&apos;échange entre agents.</rdfs:comment>
        <rdfs:label xml:lang="en">InteractionType</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#IntermediateHostRole -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#IntermediateHostRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="en">Organism in which the pathogen goes through a stage of its life cycle before reaching its final host. The snail in schistosomiasis.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Organisme dans lequel l&apos;agent pathogène accomplit une étape de son cycle de vie avant d&apos;atteindre son hôte final. L&apos;escargot dans la schistosomiase.</rdfs:comment>
        <rdfs:label xml:lang="en">IntermediateHostRole</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Intervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Intervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#modifiesDeterminant"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A control measure applied during the simulation, which changes the course of the disease by modifying at least one determinant.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Mesure de contrôle appliquée pendant la simulation, qui modifie le cours de la maladie en agissant sur au moins un déterminant.</rdfs:comment>
        <rdfs:label xml:lang="en">Intervention</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#InterventionScenario -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#InterventionScenario">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationScenario"/>
        <rdfs:comment xml:lang="en">A scenario in which one or more interventions are applied: vaccination, treatment, control measure.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Scénario dans lequel une ou plusieurs interventions sont appliquées : vaccination, traitement, mesure de contrôle.</rdfs:comment>
        <rdfs:label xml:lang="en">InterventionScenario</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Isolation -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Isolation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="fr">Mise à l&apos;écart d&apos;individus dont on sait qu&apos;ils sont infectieux.</rdfs:comment>
        <rdfs:comment xml:lang="en">Separation of individuals known to be infectious.</rdfs:comment>
        <rdfs:label xml:lang="en">Isolation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#MaskWearing -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#MaskWearing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="en">Reduction of the probability of transmission during a contact.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Réduction de la probabilité de transmission lors d&apos;un contact.</rdfs:comment>
        <rdfs:label xml:lang="en">MaskWearing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#MixedPopulation -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#MixedPopulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:comment xml:lang="en">A population combining urban and rural zones within the same territory.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Population mêlant zones urbaines et rurales au sein d&apos;un même territoire.</rdfs:comment>
        <rdfs:label xml:lang="en">MixedPopulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ModelComponent -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ModelComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">A constituent part of the structure of a model.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Partie constitutive de la structure d&apos;un modèle.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelComponent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ModelNature -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ModelNature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#EMPIRICAL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#GREY_BOX"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#MECHANISTIC"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Dit si le modèle explique les mécanismes ou se contente de reproduire les observations. Liste fermée. Ce critère décide de ce qui est recomposable : on ne recompose pas une boîte noire comme un modèle à mécanismes.</rdfs:comment>
        <rdfs:comment xml:lang="en">States whether the model explains mechanisms or merely reproduces observations. Closed list. This criterion decides what can be recomposed: a black box is not recomposed the way a mechanistic model is.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelNature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ModelParameter -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ModelParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="en">A named quantity whose value settles part of the behaviour of the model. Merges the former ParameterComponent and ModelParameter.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Grandeur nommée dont la valeur fixe une partie du comportement du modèle. Fusionne les anciennes classes ParameterComponent et ModelParameter.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelParameter</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ModelPurpose -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ModelPurpose">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DYNAMICS_RESEARCH"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#EPIDEMIC_PLANNING"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#METHODOLOGICAL_RESEARCH"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#RETROSPECTIVE_ANALYSIS"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Objectif pour lequel le modèle a été construit. Liste fermée. Connaître l&apos;objectif permet de juger si un modèle convient à une situation donnée, et d&apos;identifier les caractéristiques qu&apos;il doit réunir.</rdfs:comment>
        <rdfs:comment xml:lang="en">Purpose the model was built for. Closed list. Knowing the purpose is what lets one judge whether a model fits a given situation, and identify the features it must combine.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelPurpose</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ModelScope -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ModelScope">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#GENERAL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#SPECIFIC"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Dit si le modèle est réglable pour plusieurs maladies ou construit pour une seule. Liste fermée. C&apos;est le critère qui décide si un modèle est réutilisable ailleurs.</rdfs:comment>
        <rdfs:comment xml:lang="en">States whether the model can be retuned for several diseases or was built for one. Closed list. This is the criterion that decides whether a model is reusable elsewhere.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelScope</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ModelStructureKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ModelStructureKnowledge">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasComponent"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasGranularityLevel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#GranularityLevel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasParadigm"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ParadigmType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasSpatialType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#SpatialType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasTemporalType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#TemporalType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Connaissance décrivant la structure interne d&apos;un modèle : ses composants, et ses choix de traitement du hasard (déterministe ou stochastique), de temps, d&apos;espace et de granularité. Composant MSK du Quadruplet de recomposition.</rdfs:comment>
        <rdfs:comment xml:lang="en">Knowledge describing the internal structure of a model: its components, and its choices of handling of chance (deterministic or stochastic), time, space and granularity. MSK component of the recomposition Quadruplet.</rdfs:comment>
        <rdfs:label xml:lang="en">ModelStructureKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#MovementRestriction -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#MovementRestriction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="fr">Limitation des déplacements : confinement, couvre-feu, fermeture des frontières.</rdfs:comment>
        <rdfs:comment xml:lang="en">Limitation of movement: lockdown, curfew, closure of borders.</rdfs:comment>
        <rdfs:label xml:lang="en">MovementRestriction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#NonHumanHostState -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#NonHumanHostState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ReservoirState"/>
        <rdfs:comment xml:lang="fr">Effectif d&apos;organismes non humains se trouvant dans un état donné du cycle de l&apos;agent pathogène. Les escargots infectés de la schistosomiase, les moustiques infectieux du paludisme.</rdfs:comment>
        <rdfs:comment xml:lang="en">Head count of non-human organisms in a given state of the pathogen cycle. The infected snails of schistosomiasis, the infectious mosquitoes of malaria.</rdfs:comment>
        <rdfs:label xml:lang="en">NonHumanHostState</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#PharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="en">An intervention acting on behaviour or on regulation without any medical product.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Intervention agissant sur le comportement ou la réglementation sans produit médical.</rdfs:comment>
        <rdfs:label xml:lang="en">NonPharmaceuticalIntervention</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#NormalDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#NormalDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#meanParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#standardDeviationParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Loi symétrique caractérisée par une moyenne et un écart type.</rdfs:comment>
        <rdfs:comment xml:lang="en">Symmetric law characterised by a mean and a standard deviation.</rdfs:comment>
        <rdfs:label xml:lang="en">NormalDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#NormalDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ParadigmType -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ParadigmType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DETERMINISTIC"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#STOCHASTIC"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Nature du traitement du hasard par le modèle : déterministe ou stochastique. Liste fermée. Malgré son nom, cette classe ne désigne pas le paradigme de modélisation au sens des couches 3A et 3B (agents, compartiments) : un modèle à compartiments peut être déterministe ou stochastique.</rdfs:comment>
        <rdfs:comment xml:lang="en">Nature of the model&apos;s handling of chance: deterministic or stochastic. Closed list. Despite its name, this class does not denote the modelling paradigm in the sense of layers 3A and 3B (agents, compartments): a compartmental model may be deterministic or stochastic.</rdfs:comment>
        <rdfs:label xml:lang="en">ParadigmType</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Parasite -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Parasite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:comment xml:lang="en">Organism living at the expense of a host, often with a life cycle passing through several hosts.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Organisme vivant aux dépens d&apos;un hôte, souvent avec un cycle de vie passant par plusieurs hôtes.</rdfs:comment>
        <rdfs:label xml:lang="en">Parasite</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Pathogen -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Pathogen">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Agent infectieux responsable de la maladie.</rdfs:comment>
        <rdfs:comment xml:lang="en">The infectious agent responsible for the disease.</rdfs:comment>
        <rdfs:label xml:lang="en">Pathogen</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#PharmaceuticalIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#PharmaceuticalIntervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:comment xml:lang="en">An intervention using a medical product: vaccine, antiviral, antibiotic.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Intervention reposant sur un produit médical : vaccin, antiviral, antibiotique.</rdfs:comment>
        <rdfs:label xml:lang="en">PharmaceuticalIntervention</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TherapeuticIntervention"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#PoissonDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#PoissonDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#lambdaParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Law of the number of events occurring in a fixed interval.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi du nombre d&apos;événements survenant dans un intervalle fixe.</rdfs:comment>
        <rdfs:label xml:lang="en">PoissonDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#PoissonDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Population -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Population">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#isLocatedInRegion"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#GeographicRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A group of individuals in a geographical context. Partial alignment with osdi:Population, which describes a clinical cohort by age, sex, life expectancy and size, here the population is situated, with its density, its households and its territory. The overlap is partial and must be documented as such.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Groupe d&apos;individus dans un contexte géographique. Alignement partiel avec osdi:Population, qui décrit une cohorte clinique par âge, sexe, espérance de vie et effectif ; ici la population est située, avec sa densité, ses ménages et son territoire. Le recouvrement est partiel et doit être documenté comme tel.</rdfs:comment>
        <rdfs:label xml:lang="en">Population</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000084"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#PopulationCoupledDeterminant -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#dependsOnCountIn"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#CouplingSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A determinant whose value depends on how many individuals are currently in some category, human or not. Canonical example: the force of infection. Structural consequence: the system is non-linear and coupled, individual trajectories are not independent.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Déterminant dont la valeur dépend du nombre d&apos;individus se trouvant actuellement dans une catégorie donnée, humaine ou non. Exemple canonique : la force d&apos;infection. Conséquence structurelle : le système est non linéaire et couplé, les trajectoires individuelles ne sont pas indépendantes.</rdfs:comment>
        <rdfs:label xml:lang="en">PopulationCoupledDeterminant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ProbabilityDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ProbabilityDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">A probability law characterising the uncertainty of a parameter, or the random draw of a value.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi de probabilité caractérisant l&apos;incertitude d&apos;un paramètre, ou le tirage aléatoire d&apos;une valeur.</rdfs:comment>
        <rdfs:label xml:lang="en">ProbabilityDistribution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ProgressiveCourseDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ProgressiveCourseDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasDiseaseCourseShape"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000065"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="en">A disease with an increasing deviation from homeostasis. Requires an ordered progression through stages, without return.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Maladie à déviation croissante. Impose une progression ordonnée par stades, sans retour.</rdfs:comment>
        <rdfs:label xml:lang="en">ProgressiveCourseDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Quarantine -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Quarantine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="fr">Mise à l&apos;écart d&apos;individus possiblement exposés, pour les empêcher de transmettre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Separation of individuals who may have been exposed, to prevent them from transmitting.</rdfs:comment>
        <rdfs:label xml:lang="en">Quarantine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#RateSpecification -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#RateSpecification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="fr">Façon dont le taux d&apos;un flux est déterminé.</rdfs:comment>
        <rdfs:comment xml:lang="en">The way the rate of a flow is determined.</rdfs:comment>
        <rdfs:label xml:lang="en">RateSpecification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ReservoirRole -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ReservoirRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="en">Organism or environment where the pathogen persists between outbreaks.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Organisme ou milieu où l&apos;agent pathogène persiste entre deux épidémies.</rdfs:comment>
        <rdfs:label xml:lang="en">ReservoirRole</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ReservoirState -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ReservoirState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#CouplingSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#isStateOfRole"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontosim-dis#TransitionDeterminant"/>
        <rdfs:comment xml:lang="en">A non-human category whose current head count may make a risk vary: infected snails, cercariae present in a water body, infectious mosquitoes. It is not a health state, because the entity counted is not the individual whose disease is being modelled. It is the other kind of CouplingSource, the one that makes schistosomiasis representable.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Catégorie non humaine dont l&apos;effectif courant peut faire varier un risque : escargots infectés, cercaires présentes dans un point d&apos;eau, moustiques infectieux. Ce n&apos;est pas un état de santé, parce que l&apos;entité comptée n&apos;est pas l&apos;individu dont on modélise la maladie. C&apos;est l&apos;autre sorte de CouplingSource, celle qui rend la schistosomiase représentable.</rdfs:comment>
        <rdfs:label xml:lang="en">ReservoirState</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#RiskFactor -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#RiskFactor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">An element increasing the probability of a transition. May be an individual attribute, a contextual element or an exposure.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Élément augmentant la probabilité d&apos;une transition. Peut être un attribut individuel, un élément de contexte ou une exposition.</rdfs:comment>
        <rdfs:label xml:lang="en">RiskFactor</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000030"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#RuleComponent -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#RuleComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="en">A rule governing the behaviour of the model: decision rule, behaviour rule, interaction rule.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Règle gouvernant le comportement du modèle : règle de décision, de comportement, d&apos;interaction.</rdfs:comment>
        <rdfs:label xml:lang="en">RuleComponent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#RuralPopulation -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#RuralPopulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:comment xml:lang="en">A population living mainly in the countryside, with a low density and fewer contacts.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Population vivant majoritairement en zone rurale, à faible densité et à contacts moins fréquents.</rdfs:comment>
        <rdfs:label xml:lang="en">RuralPopulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SchoolClosure -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SchoolClosure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="en">Closure of schools, which removes from the mixing population the age group with the highest contact rate.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Fermeture des établissements scolaires.</rdfs:comment>
        <rdfs:label xml:lang="en">SchoolClosure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ScreeningIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ScreeningIntervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DetectionIntervention"/>
        <rdfs:comment xml:lang="en">Detection applied to a whole population, including individuals showing no sign of the disease. Newborn screening is the typical case.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Détection appliquée à une population entière, y compris aux individus ne présentant aucun signe de la maladie. Le dépistage néonatal en est le cas type.</rdfs:comment>
        <rdfs:label xml:lang="en">ScreeningIntervention</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SimulationExecution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SimulationExecution">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#appliesExecutionKnowledge"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ExecutionKnowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#executesModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Ceci représente le processus d&apos;exécution d&apos;un modèle de simulation sur un simulateur.
Ce n&apos;est pas un artefact d&apos;information mais un processus car il se déroule dans le temps.</rdfs:comment>
        <rdfs:comment xml:lang="en">This represents the process of executing a simulation model on a simulator.
It is not an information artifact but a process, because it unfolds over time.</rdfs:comment>
        <rdfs:label xml:lang="en">SimulationExecution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:comment xml:lang="fr">Artefact d&apos;information portant une connaissance utilisée pour construire, décrire ou exécuter un modèle de simulation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Information artifact carrying knowledge used to build, describe, or execute a simulation model.</rdfs:comment>
        <rdfs:label xml:lang="en">SimulationKnowledgeArtifact</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SimulationModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SimulationModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasParameter"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasValidationMethod"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ValidationMethod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#usesScenario"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#SimulationScenario"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasStructureKnowledge"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#ModelStructureKnowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A representation of a system whose behaviour is studied by simulation, independently of the paradigm used.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Représentation d&apos;un système dont on étudie le comportement par simulation, indépendamment du paradigme employé.</rdfs:comment>
        <rdfs:label xml:lang="en">SimulationModel</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SimulationObservation -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SimulationObservation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Données réelles observées, servant à valider un modèle par comparaison avec ses résultats.</rdfs:comment>
        <rdfs:comment xml:lang="en">Real observed data, used to validate a model by comparison with its results.</rdfs:comment>
        <rdfs:label xml:lang="en">SimulationObservation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SimulationResult -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SimulationResult">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">Data produced by a simulation execution.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Données produites par une exécution de simulation.</rdfs:comment>
        <rdfs:label xml:lang="en">SimulationResult</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SimulationScenario -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SimulationScenario">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">A set of hypotheses and settings under which a model is run.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Ensemble d&apos;hypothèses et de réglages sous lesquels un modèle est exécuté.</rdfs:comment>
        <rdfs:label xml:lang="en">SimulationScenario</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SocialDistancing -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SocialDistancing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="en">Reduction of close contacts throughout the population.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Réduction des contacts rapprochés dans l&apos;ensemble de la population.</rdfs:comment>
        <rdfs:label xml:lang="en">SocialDistancing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#SpatialType -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#SpatialType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#GIS"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#GRID"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#NETWORK"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#NON_SPATIAL"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Façon dont l&apos;espace est représenté dans le modèle. Liste fermée.</rdfs:comment>
        <rdfs:comment xml:lang="en">Way space is represented in the model. Closed list.</rdfs:comment>
        <rdfs:label xml:lang="en">SpatialType</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#StateComponent -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#StateComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:comment xml:lang="en">A state that an entity of the model can occupy at a given time. Specialised as a compartment in compartmental models [C3B] and as an agent state in agent-based models [C3A].</rdfs:comment>
        <rdfs:comment xml:lang="fr">État qu&apos;une entité du modèle peut occuper à un instant donné. Se spécialise en compartiment pour les modèles compartimentaux [C3B] et en état d&apos;agent pour les modèles à agents [C3A].</rdfs:comment>
        <rdfs:label xml:lang="en">StateComponent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#StaticApproximationAgentTransition -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#StaticApproximationAgentTransition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#AttributeDrivenTransition"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#representsStateTransition"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#CoupledTransition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#AttributeDrivenTransition"/>
        <rdfs:comment xml:lang="en">An agent transition that represents a coupled transition but is triggered by the agent&apos;s own attributes alone, not by an interaction. Agent-based form of the static approximation.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Transition d&apos;agent qui représente une transition couplée, mais qui est déclenchée par les seuls attributs de l&apos;agent, et non par une interaction. Forme multi-agents de l&apos;approximation statique.</rdfs:comment>
        <rdfs:label xml:lang="en">StaticApproximationAgentTransition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#StaticApproximationFlow -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#StaticApproximationFlow">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#TransitionFlow"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasRate"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#ConstantRate"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#representsStateTransition"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#CoupledTransition"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#TransitionFlow"/>
        <rdfs:comment xml:lang="en">A flow that represents a coupled transition but whose rate is constant: it does not read the head count on which the risk depends. Compartmental form of the static approximation.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Flux qui représente une transition couplée, mais dont le taux est constant : il ne lit pas l&apos;effectif dont dépend le risque. Forme compartimentale de l&apos;approximation statique.</rdfs:comment>
        <rdfs:label xml:lang="en">StaticApproximationFlow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#StaticApproximationModel -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#StaticApproximationModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#SimulationModel"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasAgentTransition"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#StaticApproximationAgentTransition"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasFlow"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#StaticApproximationFlow"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationModel"/>
        <rdfs:comment xml:lang="en">A model containing at least one static approximation: it represents a coupled transition without realising the coupling. It therefore ignores the indirect effects of an intervention, such as herd immunity. The approximation is acceptable when the intervention studied does not change transmission; otherwise, a dynamic model is needed. Inferred by the reasoner.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle comportant au moins une approximation statique : il représente une transition couplée sans en réaliser le couplage. Il ignore donc les effets indirects d&apos;une intervention, comme l&apos;immunité de groupe. L&apos;approximation est acceptable lorsque l&apos;intervention étudiée ne modifie pas la transmission ; sinon, un modèle dynamique est nécessaire. Inféré par le raisonneur.</rdfs:comment>
        <rdfs:label xml:lang="en">StaticApproximationModel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#StaticParameter -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#StaticParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
        <rdfs:comment xml:lang="en">A parameter whose value does not change during the simulation.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Paramètre dont la valeur ne change pas au cours de la simulation.</rdfs:comment>
        <rdfs:label xml:lang="en">StaticParameter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TemperateClimate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TemperateClimate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
        <rdfs:comment xml:lang="fr">Climat à saisons marquées et températures modérées.</rdfs:comment>
        <rdfs:comment xml:lang="en">Climate with marked seasons and moderate temperatures.</rdfs:comment>
        <rdfs:label xml:lang="en">TemperateClimate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TemporalType -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TemporalType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#CONTINUOUS"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DISCRETE"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="fr">Nature du temps dans le modèle. Liste fermée.</rdfs:comment>
        <rdfs:comment xml:lang="en">Nature of time in the model. Closed list.</rdfs:comment>
        <rdfs:label xml:lang="en">TemporalType</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TransientCourseDiseaseKnowledge -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TransientCourseDiseaseKnowledge">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasDiseaseCourseShape"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000066"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"/>
        <rdfs:comment xml:lang="en">A disease whose course can end in a return to normal homeostasis. Allows a transition back to a healthy state.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Maladie dont le cours peut se terminer par un retour à l&apos;homéostasie normale. Autorise une transition de retour vers un état sain.</rdfs:comment>
        <rdfs:label xml:lang="en">TransientCourseDiseaseKnowledge</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TransitionComponent -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TransitionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ModelComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasSourceState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasTargetState"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#StateComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A passage from one state to another. Has exactly one source state and one target state, whatever the paradigm. A transition to several states is represented by several transitions.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Passage d&apos;un état à un autre. Possède exactement un état de départ et un état d&apos;arrivée, quel que soit le paradigme. Une transition vers plusieurs états se représente par plusieurs transitions.</rdfs:comment>
        <rdfs:label xml:lang="en">TransitionComponent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TransitionDeterminant -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TransitionDeterminant">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#IndividualDeterminant"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#quantifiedBy"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontosim-dis#ModelParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">No equivalent in OSDi. OSDi has no class for what governs a transition: it attaches risk to a clinical progression element through the property hasRiskCharacterization, whose value is a parameter (for instance a relative risk) or a pathway.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="fr">Pas d&apos;équivalent dans OSDi. OSDi n&apos;a pas de classe pour ce qui gouverne une transition : il rattache le risque à un élément de progression clinique par la propriété hasRiskCharacterization, dont la valeur est un paramètre (un risque relatif, par exemple) ou un chemin (Pathway).</obo:IAO_0000116>
        <rdfs:comment xml:lang="fr">Ce qui gouverne le taux ou la probabilité d&apos;une transition. La distinction entre ses deux sous-classes N&apos;EST PAS médicale mais structurelle : elle dit si le risque d&apos;un individu dépend des autres. C&apos;est elle, et non la taxonomie des maladies, qui détermine la famille de modèles utilisable.</rdfs:comment>
        <rdfs:comment xml:lang="en">What governs the rate or the probability of a transition. The distinction between its two subclasses is NOT medical but structural: it says whether the risk of one individual depends on the others. It is this distinction, and not the taxonomy of diseases, that determines the family of usable models.</rdfs:comment>
        <rdfs:label xml:lang="en">TransitionDeterminant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TransitionFlow -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TransitionFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#TransitionComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#hasRate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontosim-dis#RateSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A passage of individuals from one compartment to another, governed by a rate. Inherits from the layer 2 transition its source and target states.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Passage d&apos;individus d&apos;un compartiment à un autre, gouverné par un taux. Hérite de la transition de couche 2 ses états de départ et d&apos;arrivée.</rdfs:comment>
        <rdfs:label xml:lang="en">TransitionFlow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TransmissionReducingIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TransmissionReducingIntervention">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#Intervention"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#modifiesDeterminant"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Intervention"/>
        <rdfs:comment xml:lang="fr">Classe DÉFINIE : intervention agissant sur un déterminant couplé à la population. N&apos;a de sens que pour une maladie transmissible, puisque réduire les contacts ne change rien lorsque le risque ne dépend que de l&apos;individu.</rdfs:comment>
        <rdfs:comment xml:lang="en">DEFINED class: an intervention acting on a population-coupled determinant. Only makes sense for a transmissible disease, since reducing contacts changes nothing when the risk depends on the individual alone.</rdfs:comment>
        <rdfs:label xml:lang="en">TransmissionReducingIntervention</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TransmissionRoute -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TransmissionRoute">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#AIRBORNE"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#BLOODBORNE"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DIRECT_CONTACT"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#DROPLET"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#FECAL_ORAL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#FOODBORNE"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#SEXUAL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#VECTOR_BORNE"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#VERTICAL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#WATERBORNE"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">The biological route by which a communicable disease passes from one host to another. Closed list.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Voie biologique par laquelle une maladie transmissible passe d&apos;un hôte à un autre. Liste fermée.</rdfs:comment>
        <rdfs:label xml:lang="en">TransmissionRoute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Treatment -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Treatment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#PharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="en">A drug treatment of affected individuals. Usually acts on an individual determinant: it changes the recovery or the progression of the treated individual.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Traitement médicamenteux des individus atteints. Agit en général sur un déterminant individuel : il modifie la guérison ou la progression de l&apos;individu traité.</rdfs:comment>
        <rdfs:label xml:lang="en">Treatment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#TropicalClimate -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#TropicalClimate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Climate"/>
        <rdfs:comment xml:lang="fr">Climat chaud et humide, favorable à de nombreux vecteurs.</rdfs:comment>
        <rdfs:comment xml:lang="en">Hot and humid climate, favourable to many vectors.</rdfs:comment>
        <rdfs:label xml:lang="en">TropicalClimate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#UniformDistribution -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#UniformDistribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#ProbabilityDistribution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#lowerLimitParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontosim-dis#upperLimitParameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Law giving the same weight to every value between two bounds.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Loi donnant le même poids à toutes les valeurs entre deux bornes.</rdfs:comment>
        <rdfs:label xml:lang="en">UniformDistribution</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression"/>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#UrbanPopulation -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#UrbanPopulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Population"/>
        <rdfs:comment xml:lang="en">A population living mainly in a city, with a high density and frequent contacts.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Population vivant majoritairement en ville, à forte densité et à contacts fréquents.</rdfs:comment>
        <rdfs:label xml:lang="en">UrbanPopulation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Vaccination -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Vaccination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#PharmaceuticalIntervention"/>
        <rdfs:comment xml:lang="en">A campaign moving individuals from a susceptible state to a protected state.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Campagne faisant passer des individus d&apos;un état susceptible à un état protégé.</rdfs:comment>
        <rdfs:label xml:lang="en">Vaccination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#VaccinationCentre -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#VaccinationCentre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#HealthInfrastructure"/>
        <rdfs:comment xml:lang="en">Facility dedicated to administering vaccines.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Structure dédiée à l&apos;administration des vaccins.</rdfs:comment>
        <rdfs:label xml:lang="en">VaccinationCentre</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#ValidationMethod -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#ValidationMethod">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#ADEQUACY"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#CROSS_MODEL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#HISTORICAL_DATA"/>
                    <rdf:Description rdf:about="https://w3id.org/ontosim-dis#STATISTICAL"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact"/>
        <rdfs:comment xml:lang="en">Method by which the model is shown to be fit for its purpose. Closed list.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Méthode par laquelle on montre que le modèle convient à son objectif. Liste fermée.</rdfs:comment>
        <rdfs:label xml:lang="en">ValidationMethod</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#VectorRole -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#VectorRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#EpidemiologicalRole"/>
        <rdfs:comment xml:lang="en">Organism carrying the pathogen from one host to another without suffering the disease.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Organisme transportant l&apos;agent pathogène d&apos;un hôte à un autre sans subir la maladie.</rdfs:comment>
        <rdfs:label xml:lang="en">VectorRole</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontosim-dis#Virus -->


    <owl:Class rdf:about="https://w3id.org/ontosim-dis#Virus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontosim-dis#Pathogen"/>
        <rdfs:comment xml:lang="en">Acellular pathogen, which replicates only inside a host cell.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Agent pathogène acellulaire, qui ne se réplique qu&apos;à l&apos;intérieur d&apos;une cellule hôte.</rdfs:comment>
        <rdfs:label xml:lang="en">Virus</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontosim-dis#ADEQUACY -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#ADEQUACY">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ValidationMethod"/>
        <rdfs:comment xml:lang="en">Qualitative assessment of the model&apos;s logic and assumptions.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Évaluation qualitative de la logique et des hypothèses du modèle.</rdfs:comment>
        <rdfs:label xml:lang="en">Adequacy validation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#AIRBORNE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#AIRBORNE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par des particules fines restant en suspension dans l&apos;air.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through fine particles remaining suspended in the air.</rdfs:comment>
        <rdfs:label xml:lang="en">Airborne</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#BLOODBORNE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#BLOODBORNE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par le sang ou des produits sanguins.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through blood or blood products.</rdfs:comment>
        <rdfs:label xml:lang="en">Bloodborne</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#CONTINUOUS -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#CONTINUOUS">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TemporalType"/>
        <rdfs:comment xml:lang="fr">Le temps s&apos;écoule continûment, exemple les équations différentielles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time flows continuously
 as in differential equations.</rdfs:comment>
        <rdfs:label xml:lang="en">Continuous time</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#CROSS_MODEL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#CROSS_MODEL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ValidationMethod"/>
        <rdfs:comment xml:lang="fr">Comparaison avec un modèle établi du même phénomène.</rdfs:comment>
        <rdfs:comment xml:lang="en">Comparison with an established model of the same phenomenon.</rdfs:comment>
        <rdfs:label xml:lang="en">Cross-model validation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#DETERMINISTIC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#DETERMINISTIC">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ParadigmType"/>
        <rdfs:comment xml:lang="fr">Les mêmes entrées donnent toujours les mêmes sorties.</rdfs:comment>
        <rdfs:comment xml:lang="en">Same inputs always give the same outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">Deterministic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#DIRECT_CONTACT -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#DIRECT_CONTACT">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par contact physique entre deux hôtes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through physical contact between two hosts.</rdfs:comment>
        <rdfs:label xml:lang="en">Direct contact</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#DISCRETE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#DISCRETE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TemporalType"/>
        <rdfs:comment xml:lang="fr">Le temps avance par pas ou par événements.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time advances by steps or by events.</rdfs:comment>
        <rdfs:label xml:lang="en">Discrete time</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#DROPLET -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#DROPLET">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par des gouttelettes respiratoires projetées à courte distance.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through respiratory droplets projected over a short distance.</rdfs:comment>
        <rdfs:label xml:lang="en">Droplet</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#DYNAMICS_RESEARCH -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#DYNAMICS_RESEARCH">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelPurpose"/>
        <rdfs:comment xml:lang="fr">Explorer les mécanismes de propagation des maladies, leurs dynamiques et les facteurs qui les influencent. Objectif de compréhension.</rdfs:comment>
        <rdfs:comment xml:lang="en">Exploring disease spread mechanisms, their dynamics and the factors influencing them. An explanatory purpose.</rdfs:comment>
        <rdfs:label xml:lang="en">Dynamics research</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#EMPIRICAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#EMPIRICAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelNature"/>
        <rdfs:comment xml:lang="en">Black-box model, describing the system&apos;s responses through equations fitted to experimental data, with no scientific principle or dynamic explanation. Its inner workings remain unknown.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle dit à boîte noire, qui décrit les réponses du système par des équations ajustées sur des données expérimentales, sans intégrer de principe scientifique ni d&apos;explication dynamique. Le fonctionnement interne reste inconnu.</rdfs:comment>
        <rdfs:label xml:lang="en">Empirical</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#EPIDEMIC_PLANNING -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#EPIDEMIC_PLANNING">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelPurpose"/>
        <rdfs:comment xml:lang="en">Anticipating and managing potential epidemics by testing interventions and strategies, such as school closures or vaccination campaigns. A predictive purpose.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Anticiper et gérer des épidémies potentielles en testant des interventions et des stratégies, comme les fermetures d&apos;écoles ou les campagnes de vaccination. Objectif de prédiction.</rdfs:comment>
        <rdfs:label xml:lang="en">Epidemic planning</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#FECAL_ORAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#FECAL_ORAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par ingestion de matières contaminées par des selles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through ingestion of matter contaminated by faeces.</rdfs:comment>
        <rdfs:label xml:lang="en">Faecal-oral</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#FOODBORNE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#FOODBORNE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par des aliments contaminés.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through contaminated food.</rdfs:comment>
        <rdfs:label xml:lang="en">Foodborne</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#GENERAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#GENERAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelScope"/>
        <rdfs:comment xml:lang="en">Model using generic dynamics and adjustable parameters, able to simulate a wide range of diseases sharing similar mechanisms. Needs less data and serves epidemic planning.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle employant des dynamiques génériques et des paramètres ajustables, qui permet de simuler un large éventail de maladies partageant des mécanismes similaires. Demande moins de données et sert à la planification épidémique.</rdfs:comment>
        <rdfs:label xml:lang="en">General</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#GIS -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#GIS">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#SpatialType"/>
        <rdfs:comment xml:lang="fr">L&apos;espace est représenté par des données géographiques réelles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space is represented by real geographic data.</rdfs:comment>
        <rdfs:label xml:lang="en">Geographic information system</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#GREY_BOX -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#GREY_BOX">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelNature"/>
        <rdfs:comment xml:lang="en">Model mixing a mechanistic part and an empirical part: some subsystems are described by their mechanisms, others by relations fitted to data.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle mêlant une part mécaniste et une part empirique : certains sous-systèmes sont décrits par leurs mécanismes, d&apos;autres par des relations ajustées sur les données.</rdfs:comment>
        <rdfs:label xml:lang="en">Grey box</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#GRID -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#GRID">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#SpatialType"/>
        <rdfs:comment xml:lang="fr">L&apos;espace est représenté par une grille régulière de cellules.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space is represented by a regular grid of cells.</rdfs:comment>
        <rdfs:label xml:lang="en">grid</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#GROUP -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#GROUP">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#GranularityLevel"/>
        <rdfs:comment xml:lang="en">Individuals are gathered into homogeneous groups.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Les individus sont regroupés en groupes homogènes.</rdfs:comment>
        <rdfs:label xml:lang="en">Group</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#HISTORICAL_DATA -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#HISTORICAL_DATA">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ValidationMethod"/>
        <rdfs:comment xml:lang="fr">Comparaison des résultats avec des données réelles observées.</rdfs:comment>
        <rdfs:comment xml:lang="en">Comparison of the results with real observed data.</rdfs:comment>
        <rdfs:label xml:lang="en">Historical data validation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#INDIVIDUAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#INDIVIDUAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#GranularityLevel"/>
        <rdfs:comment xml:lang="fr">Chaque individu est représenté séparément.</rdfs:comment>
        <rdfs:comment xml:lang="en">Each individual is represented separately.</rdfs:comment>
        <rdfs:label xml:lang="en">Individual</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#MECHANISTIC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#MECHANISTIC">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelNature"/>
        <rdfs:comment xml:lang="fr">Modèle dit à boîte blanche, construit sur la connaissance du fonctionnement du système, de ses éléments et de leurs interactions. Fournit des explications causales, au prix d&apos;une complexité accrue.</rdfs:comment>
        <rdfs:comment xml:lang="en">White-box model, built on knowledge of how the system works, of its elements and their interactions. Yields causal explanations, at the cost of greater complexity.</rdfs:comment>
        <rdfs:label xml:lang="en">Mechanistic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#METHODOLOGICAL_RESEARCH -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#METHODOLOGICAL_RESEARCH">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelPurpose"/>
        <rdfs:comment xml:lang="fr">Améliorer les approches de modélisation elles-mêmes, pour les rendre plus efficaces, plus rapides ou plus robustes. Objectif de compréhension.</rdfs:comment>
        <rdfs:comment xml:lang="en">Improving the modelling approaches themselves, to make them more effective, faster or more robust. An explanatory purpose.</rdfs:comment>
        <rdfs:label xml:lang="en">Methodological research</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#MULTISCALE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#MULTISCALE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#GranularityLevel"/>
        <rdfs:comment xml:lang="fr">Plusieurs niveaux de détail coexistent dans le même modèle.</rdfs:comment>
        <rdfs:comment xml:lang="en">Several levels of detail coexist in the same model.</rdfs:comment>
        <rdfs:label xml:lang="en">Multiscale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#NETWORK -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#NETWORK">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#SpatialType"/>
        <rdfs:comment xml:lang="fr">L&apos;espace est représenté par un réseau de contacts ou de connexions.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space is represented by a network of contacts or connections.</rdfs:comment>
        <rdfs:label xml:lang="en">Network</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#NON_SPATIAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#NON_SPATIAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#SpatialType"/>
        <rdfs:comment xml:lang="fr">L&apos;espace n&apos;est pas représenté, la population est supposée bien mélangée.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space is not represented, the population is assumed well mixed.</rdfs:comment>
        <rdfs:label xml:lang="en">Non spatial</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#REGIONAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#REGIONAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#GranularityLevel"/>
        <rdfs:comment xml:lang="fr">L&apos;unité décrite est un territoire.</rdfs:comment>
        <rdfs:comment xml:lang="en">The unit described is a territory.</rdfs:comment>
        <rdfs:label xml:lang="en">Regional</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#RETROSPECTIVE_ANALYSIS -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#RETROSPECTIVE_ANALYSIS">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelPurpose"/>
        <rdfs:comment xml:lang="en">Studying a past epidemic to assess how effective the response was and to prepare future interventions. A predictive purpose.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Étudier une épidémie passée pour évaluer l&apos;efficacité des réponses et préparer les interventions futures. Objectif de prédiction.</rdfs:comment>
        <rdfs:label xml:lang="en">Retrospective analysis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#SEXUAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#SEXUAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par contact sexuel.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through sexual contact.</rdfs:comment>
        <rdfs:label xml:lang="en">Sexual</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#SPECIFIC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#SPECIFIC">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ModelScope"/>
        <rdfs:comment xml:lang="en">Model embedding the transmission mechanisms and factors particular to one disease, often in a given context. Needs precise data and serves the assessment of targeted interventions.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Modèle intégrant les mécanismes de transmission et les facteurs propres à une maladie précise, souvent dans un contexte donné. Demande des données précises et sert à évaluer des interventions ciblées.</rdfs:comment>
        <rdfs:label xml:lang="en">Specific</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#STATISTICAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#STATISTICAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ValidationMethod"/>
        <rdfs:comment xml:lang="en">Statistical test of the agreement between results and reference data.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Test statistique de l&apos;accord entre les résultats et des données de référence.</rdfs:comment>
        <rdfs:label xml:lang="en">Statistical Validation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#STOCHASTIC -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#STOCHASTIC">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#ParadigmType"/>
        <rdfs:comment xml:lang="en">Chance takes part and results vary from one run to another.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Le hasard intervient et les résultats varient d&apos;une exécution à l&apos;autre.</rdfs:comment>
        <rdfs:label xml:lang="en">Stochastic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#VECTOR_BORNE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#VECTOR_BORNE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par un vecteur vivant, le plus souvent un arthropode. Voie du paludisme et de la dengue.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through a living vector, usually an arthropod. Route of malaria and dengue.</rdfs:comment>
        <rdfs:label xml:lang="en">Vector-borne</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#VERTICAL -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#VERTICAL">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">De la mère à l&apos;enfant, pendant la grossesse, l&apos;accouchement ou l&apos;allaitement.</rdfs:comment>
        <rdfs:comment xml:lang="en">From mother to child, during pregnancy, birth or breastfeeding.</rdfs:comment>
        <rdfs:label xml:lang="en">Vertical</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontosim-dis#WATERBORNE -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontosim-dis#WATERBORNE">
        <rdf:type rdf:resource="https://w3id.org/ontosim-dis#TransmissionRoute"/>
        <rdfs:comment xml:lang="fr">Par de l&apos;eau contaminée. Voie de la schistosomiase et du choléra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Through contaminated water. Route of schistosomiasis and cholera.</rdfs:comment>
        <rdfs:label xml:lang="en">Waterborne</rdfs:label>
    </owl:NamedIndividual>
    


