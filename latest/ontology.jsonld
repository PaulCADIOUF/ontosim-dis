    "@language" : "en",
    "@value" : "State of the execution: pending, running, completed, failed."
  }, {
    "@language" : "fr",
    "@value" : "État de l'exécution : en attente, en cours, terminée, échouée."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationExecution"
