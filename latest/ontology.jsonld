    "@value" : "Links a model to its parameters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasPathogen",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une connaissance de maladie à l'agent pathogène qui la cause."
  }, {
    "@language" : "en",
    "@value" : "Links a disease knowledge artifact to the pathogen causing it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasPathogen"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#Pathogen"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasPermanentImmunity",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "True when the immunity acquired after recovery lasts for life."
  }, {
    "@language" : "fr",
    "@value" : "Vrai lorsque l'immunité acquise après guérison dure toute la vie."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasPermanentImmunity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasPopulation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un contexte aux populations qu'il concerne."
  }, {
    "@language" : "en",
    "@value" : "Links a context to the populations it concerns."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ContextKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasPopulation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#Population"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasRate",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un flux à la façon dont son taux est déterminé."
  }, {
    "@language" : "en",
    "@value" : "Links a flow to the way its rate is determined."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#TransitionFlow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasRate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#RateSpecification"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasRefToDO",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Disease Ontology identifier. Attaches the medical taxonomy, deliberately kept OUTSIDE the structure of the ontology."
  }, {
    "@language" : "fr",
    "@value" : "Identifiant Disease Ontology. Rattache la taxonomie médicale, délibérément tenue HORS de la structure de l'ontologie."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasRefToDO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRefToDO"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasRefToICD",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Code CIM de la maladie. Reprend la convention d'OSDi pour faciliter l'alignement."
  }, {
    "@language" : "en",
    "@value" : "ICD code of the disease. Follows the OSDi convention to ease alignment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasRefToICD"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRefToICD"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasRefToNCBITaxon",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Identifiant NCBI Taxonomy de l'agent pathogène. Rattache la taxonomie biologique, délibérément tenue hors de la structure de l'ontologie."
  }, {
    "@language" : "en",
    "@value" : "NCBI Taxonomy identifier of the pathogen. Attaches the biological taxonomy, deliberately kept outside the structure of the ontology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#Pathogen"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasRefToNCBITaxon"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasRefToSNOMED",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Identifiant SNOMED CT de la maladie. Reprend la convention d'OSDi."
