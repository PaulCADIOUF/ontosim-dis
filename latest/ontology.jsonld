  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un déterminant aux catégories dont il lit l'effectif courant. Signature du couplage populationnel. La catégorie lue est un état de santé lorsque le risque dépend des humains infectés, un état de réservoir lorsqu'il dépend d'un milieu ou d'un hôte non humain. Pendant exact de dependsOnCompartment [3B] et de triggeredBy sur une interaction [3A]."
  }, {
    "@language" : "en",
    "@value" : "Links a determinant to the categories whose current head count it reads. Signature of population coupling. The category read is a health state when the risk depends on infected humans, a reservoir state when it depends on an environment or a non-human host. Exact counterpart of dependsOnCompartment [3B] and triggeredBy an interaction [3A]."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#PopulationCoupledDeterminant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dependsOnCountIn"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#CouplingSource"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#detects",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une intervention de détection à la connaissance de maladie qu'elle recherche."
  }, {
    "@language" : "en",
    "@value" : "Links a detection intervention to the disease knowledge it looks for."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DetectionIntervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "detects"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#detects"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#determinantExpression",
