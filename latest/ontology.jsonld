  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasClimate",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un contexte à ses conditions climatiques."
  }, {
    "@language" : "en",
    "@value" : "Links a context to its climatic conditions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ContextKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasClimate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#Climate"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasCompartment",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle compartimental à ses compartiments."
  }, {
    "@language" : "en",
    "@value" : "Links a compartmental model to its compartments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#CompartmentalModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasCompartment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#Compartment"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une structure de modèle aux composants qu'elle contient."
  }, {
    "@language" : "en",
    "@value" : "Links a model structure to the components it contains."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelStructureKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasComponent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelComponent"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasContextKnowledge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle au contexte pour lequel il a été construit."
  }, {
    "@language" : "en",
    "@value" : "Links a model to the context it was built for."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasContextKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ContextKnowledge"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasDiseaseCourseShape",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une connaissance de maladie à la forme dynamique de son cours, telle que classifiée par OGMS. Cette forme contraint la structure du modèle indépendamment du déterminant : elle dit si un retour à l'état sain est possible, si un état absorbant est requis ou si la progression est monotone."
  }, {
    "@language" : "en",
    "@value" : "Links a disease knowledge artifact to the dynamic shape of its course, as classified by OGMS. This shape constrains the structure of the model independently of the determinant: it says whether a return to health is possible, whether an absorbing state is required or whether progression is monotone."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasDiseaseCourseShape"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OGMS_0000063"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasEndAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un état de santé au paramètre donnant l'âge au-delà duquel un individu n'y est plus."
  }, {
    "@language" : "en",
    "@value" : "Links a health state to the parameter giving the age beyond which an individual is no longer in it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasEndAge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelParameter"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasEndAge"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasEnvironmentModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle au milieu dans lequel ses agents évoluent."
  }, {
    "@language" : "en",
    "@value" : "Links a model to the surroundings in which its agents evolve."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#AgentBasedModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasEnvironmentModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#EnvironmentModel"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasEpidemiologicalRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une connaissance de maladie aux rôles intervenant dans son cycle de transmission."
  }, {
    "@language" : "en",
    "@value" : "Links a disease knowledge artifact to the roles involved in its transmission cycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasEpidemiologicalRole"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#EpidemiologicalRole"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasEquation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle compartimental à ses équations différentielles."
  }, {
    "@language" : "en",
    "@value" : "Links a compartmental model to its differential equations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#CompartmentalModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasEquation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DifferentialEquation"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasExecutionKnowledge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle aux configurations d'exécution définies pour lui. Non fonctionnelle : un même modèle peut être exécuté sous plusieurs configurations, simulateurs différents ou nombres de répétitions différents."
  }, {
    "@language" : "en",
    "@value" : "Links a model to the execution configurations defined for it. Not functional: the same model may be run under several configurations, with different simulators or different run counts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasExecutionKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ExecutionKnowledge"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle compartimental à ses flux."
  }, {
    "@language" : "en",
    "@value" : "Links a compartmental model to its flows."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#CompartmentalModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasFlow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#TransitionFlow"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasGeographicRegion",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un contexte aux territoires qu'il couvre."
  }, {
    "@language" : "en",
    "@value" : "Links a context to the territories it covers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ContextKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasGeographicRegion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#GeographicRegion"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasGranularityLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une structure de modèle à son niveau de détail."
  }, {
    "@language" : "en",
    "@value" : "Links a model structure to its level of detail."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelStructureKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasGranularityLevel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#GranularityLevel"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasHealthInfrastructure",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un contexte aux structures de santé disponibles."
  }, {
    "@language" : "en",
    "@value" : "Links a context to the health facilities available."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ContextKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasHealthInfrastructure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthInfrastructure"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasHealthState",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une connaissance de maladie aux états de santé qu'elle définit."
  }, {
    "@language" : "en",
    "@value" : "Links a disease knowledge artifact to the health states it defines."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasHealthState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthState"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasMaterialBasisIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une maladie au désordre qui en est la base physique. OGMS énonce cette relation dans la définition textuelle de la maladie, mais ne la formalise pas. IDO la formalise sous son propre IRI ; nous la déclarons ici pour ne pas dépendre d'IDO."
  }, {
    "@language" : "en",
    "@value" : "Links a disease to the disorder that is its physical basis. OGMS states this in the textual definition of disease but does not formalise it. IDO formalises it under its own IRI; we declare it here so as not to depend on IDO."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OGMS_0000031"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasMaterialBasisIn"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OGMS_0000045"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasModelNature",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Dit si le modèle est mécaniste, empirique ou mixte. Fonctionnelle."
  }, {
    "@language" : "en",
    "@value" : "States whether the model is mechanistic, empirical or mixed. Functional."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasModelNature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelNature"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasModelPurpose",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle aux objectifs pour lesquels il a été construit. Non fonctionnelle, délibérément : un même modèle peut servir à plusieurs choses, par exemple à comprendre une dynamique et à planifier une riposte."
  }, {
    "@language" : "en",
    "@value" : "Links a model to the purposes it was built for. Deliberately not functional: the same model may serve several ends, for instance understanding a dynamic and planning a response."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasModelPurpose"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelPurpose"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasModelScope",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Dit si le modèle est général ou spécifique. Fonctionnelle : un modèle est l'un ou l'autre, pas les deux."
  }, {
    "@language" : "en",
    "@value" : "States whether the model is general or specific. Functional: a model is one or the other, not both."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasModelScope"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelScope"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasOnsetAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un état de santé au paramètre donnant l'âge à partir duquel un individu peut y entrer."
  }, {
    "@language" : "en",
    "@value" : "Links a health state to the parameter giving the age from which an individual may enter it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasOnsetAge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelParameter"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasParadigm",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une structure de modèle à sa nature déterministe ou stochastique."
  }, {
    "@language" : "en",
    "@value" : "Links a model structure to its deterministic or stochastic nature."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelStructureKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasParadigm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ParadigmType"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#hasParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle à ses paramètres."
  }, {
