  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#realisesDeterminant",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Déclare quel déterminant un composant de modèle réalise : un taux dépendant d'un compartiment [3B] ou une transition déclenchée par une interaction [3A] réalisent tous deux un déterminant couplé à la population."
  }, {
    "@language" : "en",
    "@value" : "States which determinant a model component realises: a compartment-dependent rate [3B] or an interaction-triggered transition [3A] both realise a population-coupled determinant."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#ModelComponent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "realisesDeterminant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#TransitionDeterminant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000136"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#regionName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Nom officiel du territoire."
  }, {
    "@language" : "en",
    "@value" : "Official name of the territory."
