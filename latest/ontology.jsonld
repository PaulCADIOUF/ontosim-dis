  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Expression textuelle du taux, par exemple beta * I / N."
  }, {
    "@language" : "en",
    "@value" : "Textual expression of the rate, for instance beta * I / N."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
