    "@language" : "fr",
    "@value" : "Le nom de l'auteur du modèle est sous forme de texte et non en classe. "
  }, {
    "@language" : "en",
    "@value" : "The model author's name is stored as text rather than as a class."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#SimulationModel"
