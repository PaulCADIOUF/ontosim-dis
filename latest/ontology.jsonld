    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#reinfectionPossible",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "True when a recovered host can be infected again."
  }, {
    "@language" : "fr",
    "@value" : "Vrai lorsqu'un hôte guéri peut être infecté à nouveau."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "reinfectionPossible"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#representsDisease",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un artefact de connaissance de maladie à la maladie réelle dont il parle, c'est-à-dire une disposition portée par un organisme. Unique point de contact entre la couche informationnelle d'OntoSim-Dis et l'ontologie réaliste OGMS."
  }, {
    "@language" : "en",
    "@value" : "Links a disease knowledge artifact to the real disease it is about, a disposition borne by an organism. Only point of contact between the informational layer of OntoSim-Dis and the realist ontology OGMS."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "representsDisease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OGMS_0000031"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000136"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#representsHealthState",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Déclare quel état de santé un composant d'état de modèle représente. Un compartiment S et un état d'agent susceptible utilisent tous deux cette même propriété."
  }, {
    "@language" : "en",
    "@value" : "States which health state a model state component stands for. A compartment S and an agent state 'susceptible' both use this same property."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#StateComponent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "representsHealthState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000136"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#representsPhaseOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un état de santé à la phase du cours de maladie qu'il représente. Un état de santé n'est pas une phase réelle : c'est une abstraction de modélisation qui en tient lieu."
  }, {
    "@language" : "en",
    "@value" : "Links a health state to the phase of the disease course it stands for. A health state is not a real phase: it is a modelling abstraction standing in for one."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "representsPhaseOf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OGMS_0000063"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000136"
  } ]
}, {
  "@id" : "https://w3id.org/ontosim-dis#representsStateTransition",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Déclare quelle transition d'état de santé un composant de transition de modèle représente."
  }, {
    "@language" : "en",
    "@value" : "States which health state transition a model transition component stands for."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#TransitionComponent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "representsStateTransition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontosim-dis#HealthStateTransition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000136"
  } ]
}, {
