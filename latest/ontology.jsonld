  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un modèle aux règles de comportement de ses agents."
  }, {
    "@language" : "en",
    "@value" : "Links a model to the behaviour rules of its agents."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontosim-dis#AgentBasedModel"
