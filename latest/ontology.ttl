#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000001
<http://purl.obolibrary.org/obo/BFO_0000001> rdf:type owl:Class ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "BFO:0000001 - imported via MIREOT. Root of the entire BFO hierarchy."@en ,
                                                                                          "BFO:0000001 - importé via MIREOT. Racine de toute la hiérarchie BFO."@fr ;
                                             rdfs:comment "An entity is anything that exists or has existed or will exist."@en ;
                                             rdfs:label "entity"@en ;
                                             rdfs:seeAlso "http://purl.obolibrary.org/obo/bfo.owl"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/BFO_0000002
<http://purl.obolibrary.org/obo/BFO_0000002> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Entities persisting over time: models, diseases, populations."@en ,
                                                                                          "Entités persistant dans le temps : modèles, maladies, populations."@fr ;
                                             rdfs:comment "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity."@en ;
                                             rdfs:label "continuant"@en ;
                                             rdfs:seeAlso "http://purl.obolibrary.org/obo/bfo.owl"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/BFO_0000003
<http://purl.obolibrary.org/obo/BFO_0000003> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "BFO:0000003 - imported via MIREOT. Superclass of all processes in OntoSim-Dis."@en ,
                                                                                          "BFO:0000003 - importé via MIREOT. Superclasse de tous les processus dans OntoSim-Dis."@fr ;
                                             rdfs:comment "An occurrent is an entity that unfolds itself in time or it is the instantaneous boundary of such an entity (for example a beginning or an ending) or it is a temporal or spatiotemporal region which such an entity occupies_temporal_region or occupies_spatiotemporal_region."@en ;
                                             rdfs:label "occurrent"@en ;
                                             rdfs:seeAlso "http://purl.obolibrary.org/obo/bfo.owl"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/BFO_0000004
<http://purl.obolibrary.org/obo/BFO_0000004> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000020> ,
                                                              <http://purl.obolibrary.org/obo/BFO_0000031> ;
                                             rdfs:comment "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t."@en ;
                                             rdfs:label "independent continuant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
<http://purl.obolibrary.org/obo/BFO_0000015> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             rdfs:comment "An occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t."@en ;
                                             rdfs:label "process"@en .


###  http://purl.obolibrary.org/obo/BFO_0000016
<http://purl.obolibrary.org/obo/BFO_0000016> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
                                             rdfs:comment "Dire que « b est une disposition » signifie que : b est une entité réalisable ; le porteur de b est une entité matérielle ; b est telle que, si elle cesse d'exister, son porteur subit une modification physique ; la réalisation de b survient lorsque, et parce que, ce porteur se trouve dans certaines circonstances physiques particulières, et cette réalisation se produit en vertu de la constitution physique du porteur."@fr ,
                                                          "b is a disposition means: b is a realizable entity & b’s bearer is some material entity & b is such that if it ceases to exist, then its bearer is physically changed, & b’s realization occurs when and because this bearer is in some special physical circumstances, & this realization occurs in virtue of the bearer’s physical make-up."@en ;
                                             rdfs:label "disposition"@en .


###  http://purl.obolibrary.org/obo/BFO_0000017
<http://purl.obolibrary.org/obo/BFO_0000017> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                             rdfs:comment "Dire que b est une entité réalisable revient à dire que b est un continuant spécifiquement dépendant qui inhère dans un continuant indépendant, autre qu'une région spatiale, et qui est d'un type dont les instances sont réalisées au cours de processus d'un type corrélé."@fr ,
                                                          "To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type."@en ;
                                             rdfs:label "realizable entity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000019
<http://purl.obolibrary.org/obo/BFO_0000019> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             rdfs:comment "a quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized."@en ;
                                             rdfs:label "quality"@en .


###  http://purl.obolibrary.org/obo/BFO_0000020
<http://purl.obolibrary.org/obo/BFO_0000020> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000031> ;
                                             rdfs:comment "b is a specifically dependent continuant = Def. b is a continuant & there is some independent continuant c which is not a spatial region and which is such that b s-depends_on c at every time t during the course of b’s existence."@en ;
                                             rdfs:label "specifically dependent continuant"@en ;
                                             rdfs:seeAlso "http://purl.obolibrary.org/obo/bfo.owl"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/BFO_0000031
<http://purl.obolibrary.org/obo/BFO_0000031> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             rdfs:comment "b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities."@en ;
                                             rdfs:label "generically dependent continuant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000040
<http://purl.obolibrary.org/obo/BFO_0000040> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             rdfs:comment "A material entity is an independent continuant that has some portion of matter as proper or improper continuant part."@en ;
                                             rdfs:label "material entity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000141
<http://purl.obolibrary.org/obo/BFO_0000141> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
                                             rdfs:label "immaterial entity"@en .


###  http://purl.obolibrary.org/obo/IAO_0000030
<http://purl.obolibrary.org/obo/IAO_0000030> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Direct superclass of dsim:SimulationKnowledgeArtifact (Layer 2). Groups all informational artifacts of the ontology."@en ,
                                                                                          "Superclasse directe de dsim:SimulationKnowledgeArtifact (Couche 2). Regroupe tous les artefacts informationnels de l'ontologie"@fr ;
                                             rdfs:comment "A generically dependent continuant that is about some thing."@en ;
                                             rdfs:label "information content entity"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000030
<http://purl.obolibrary.org/obo/OGMS_0000030> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
                                              rdfs:comment "A disposition in an organism that constitutes an increased risk of the organism's subsequently developing the disease X."@en ,
                                                           "Une prédisposition chez un organisme qui constitue un risque accru pour cet organisme de développer ultérieurement la maladie X."@fr ;
                                              rdfs:label "predisposition to disease of type X"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000031
<http://purl.obolibrary.org/obo/OGMS_0000031> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :hasMaterialBasisIn ;
                                                                owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000045>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000054> ;
                                                                owl:allValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000063>
                                                              ] ;
                                              rdfs:comment "A disposition (i) to undergo pathological processes that (ii) exists in an organism because of one or more disorders in that organism."@en ,
                                                           "Une prédisposition (i) à subir des processus pathologiques qui (ii) existe chez un organisme en raison d'un ou plusieurs troubles affectant cet organisme."@fr ;
                                              rdfs:label "disease"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000045
<http://purl.obolibrary.org/obo/OGMS_0000045> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000087>
                                                              ] ;
                                              rdfs:comment "A material entity which is clinically abnormal and part of an extended organism. Disorders are the physical basis of disease."@en ,
                                                           "Une entité matérielle cliniquement anormale et faisant partie d'un organisme étendu. Les troubles constituent le fondement physique de la maladie."@fr ;
                                              rdfs:label "disorder"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000063
<http://purl.obolibrary.org/obo/OGMS_0000063> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                                              rdfs:comment "The totality of all processes through which a given disease instance is realized."@en ;
                                              rdfs:label "disease course"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000064
<http://purl.obolibrary.org/obo/OGMS_0000064> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/OGMS_0000063> ;
                                              rdfs:comment "A disease course that (a) does not terminate in a return to normal homeostasis and (b) would, absent intervention, fall within abnormal homeostatic range."@en ;
                                              rdfs:label "chronic disease course"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000065
<http://purl.obolibrary.org/obo/OGMS_0000065> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/OGMS_0000063> ;
                                              rdfs:comment "A disease course that (a) does not terminate in a return to normal homeostasis and (b) would, absent intervention, involve an increasing deviation from homeostasis."@en ;
                                              rdfs:label "progressive disease course"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000066
<http://purl.obolibrary.org/obo/OGMS_0000066> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/OGMS_0000063> ;
                                              rdfs:comment "A disease course that terminates in a return to normal homeostasis."@en ;
                                              rdfs:label "transient disease course"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000084
<http://purl.obolibrary.org/obo/OGMS_0000084> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                              rdfs:comment "An aggregate of organisms of the same type."@en ,
                                                           "Un regroupement d'organismes du même type."@fr ;
                                              rdfs:label "organism population"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000087
<http://purl.obolibrary.org/obo/OGMS_0000087> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                              rdfs:comment "An object aggregate consisting of an organism and all material entities located within the organism, overlapping the organism, or occupying sites formed in part by the organism."@en ,
                                                           "Un agrégat d'objets constitué d'un organisme et de toutes les entités matérielles situées à l'intérieur de l'organisme, chevauchant l'organisme ou occupant des sites formés en partie par l'organisme."@fr ;
                                              rdfs:label "extended organism"@en .


###  http://purl.obolibrary.org/obo/OGMS_0000094
<http://purl.obolibrary.org/obo/OGMS_0000094> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/OGMS_0000063> ;
                                              rdfs:comment "A disease course with an acute onset."@en ;
                                              rdfs:label "acute disease course"@en .


###  https://w3id.org/ontosim-dis#AcuteCourseDiseaseKnowledge
:AcuteCourseDiseaseKnowledge rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :hasDiseaseCourseShape ;
                                                                          owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000094>
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf :DiseaseKnowledgeTemplate ;
                             rdfs:comment "A disease with an abrupt onset. Fourth course shape recognised by OGMS, alongside the chronic, progressive and transient forms. Constrains the structure of the model little, but qualifies the dynamics of entry."@en ,
                                          "Maladie à début brutal. Quatrième forme de cours reconnue par OGMS, aux côtés des formes chronique, progressive et transitoire. Contraint peu la structure du modèle mais qualifie la dynamique d'entrée."@fr ;
                             rdfs:label "AcuteCourseDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#AdministrativeRegion
:AdministrativeRegion rdf:type owl:Class ;
                      rdfs:subClassOf :GeographicRegion ;
                      rdfs:comment "Administrative division of a country. Senegal has fourteen of them."@en ,
                                   "Division administrative d'un pays. Le Sénégal en compte quatorze."@fr ;
                      rdfs:label "AdministrativeRegion"@en .


###  https://w3id.org/ontosim-dis#AgentBasedModel
:AgentBasedModel rdf:type owl:Class ;
                 rdfs:subClassOf :SimulationModel ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasAgentType ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :AgentType
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasBehavior ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Behavior
                                 ] ;
                 rdfs:comment "A model in which autonomous agents, each following its own behaviour, interact and produce the behaviour of the system."@en ,
                              "Modèle dans lequel des agents autonomes, suivant chacun son comportement, interagissent et produisent le comportement du système."@fr ;
                 rdfs:label "AgentBasedModel"@en ;
                 <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#AgentBasedModel> .


###  https://w3id.org/ontosim-dis#AgentState
:AgentState rdf:type owl:Class ;
            rdfs:subClassOf :StateComponent ;
            rdfs:comment "A state an agent can occupy. Agent-based form of a state component."@en ,
                         "État qu'un agent peut occuper. Forme multi-agents d'un composant d'état."@fr ;
            rdfs:label "AgentState"@en .


###  https://w3id.org/ontosim-dis#AgentTransition
:AgentTransition rdf:type owl:Class ;
                 rdfs:subClassOf :TransitionComponent ;
                 rdfs:comment "A change of state of an agent. Inherits from the layer 2 transition its source and target states."@en ,
                              "Changement d'état d'un agent. Hérite de la transition de couche 2 ses états de départ et d'arrivée."@fr ;
                 rdfs:label "AgentTransition"@en .


###  https://w3id.org/ontosim-dis#AgentType
:AgentType rdf:type owl:Class ;
           rdfs:subClassOf :ModelComponent ;
           rdfs:comment """A category of autonomous entities in the model. 
The individual agent is not modelled because it exists only at run time."""@en ,
                        """Catégorie d'entités autonomes du modèle.
L'agent individuel n'est pas modélisé car il n'existe qu'à l'exécution."""@fr ;
           rdfs:label "AgentType"@en .


###  https://w3id.org/ontosim-dis#AridClimate
:AridClimate rdf:type owl:Class ;
             rdfs:subClassOf :Climate ;
             rdfs:comment "Climat sec à faibles précipitations."@fr ,
                          "Dry climate with little rainfall."@en ;
             rdfs:label "AridClimate"@en .


###  https://w3id.org/ontosim-dis#AttributeDrivenTransition
:AttributeDrivenTransition rdf:type owl:Class ;
                           rdfs:subClassOf :AgentTransition ;
                           owl:disjointWith :InteractionTriggeredTransition ;
                           rdfs:comment "A transition triggered by the agent's own attributes alone: its age, the time spent in its current state. Individual determinant."@en ,
                                        "Transition déclenchée par les seuls attributs de l'agent : son âge, le temps passé dans son état courant. Déterminant individuel."@fr ;
                           rdfs:label "AttributeDrivenTransition"@en .


###  https://w3id.org/ontosim-dis#Bacterium
:Bacterium rdf:type owl:Class ;
           rdfs:subClassOf :Pathogen ;
           rdfs:comment "Agent pathogène unicellulaire dépourvu de noyau."@fr ,
                        "Single-celled pathogen without a nucleus."@en ;
           rdfs:label "Bacterium"@en .


###  https://w3id.org/ontosim-dis#Behavior
:Behavior rdf:type owl:Class ;
          rdfs:subClassOf :RuleComponent ;
          rdfs:comment "A rule saying what an agent does according to its state and its surroundings."@en ,
                       "Règle disant ce que fait un agent selon son état et ce qui l'entoure."@fr ;
          rdfs:label "Behavior"@en .


###  https://w3id.org/ontosim-dis#BernoulliDistribution
:BernoulliDistribution rdf:type owl:Class ;
                       rdfs:subClassOf :ProbabilityDistribution ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :probabilityParameter ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:double
                                       ] ;
                       rdfs:comment "Law of a single trial with two outcomes, of given probability."@en ,
                                    "Loi d'un tirage unique à deux issues de probabilité donnée."@fr ;
                       rdfs:label "BernoulliDistribution"@en ;
                       <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression> .


###  https://w3id.org/ontosim-dis#BetaDistribution
:BetaDistribution rdf:type owl:Class ;
                  rdfs:subClassOf :ProbabilityDistribution ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :alphaParameter ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:double
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :betaParameter ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:double
                                  ] ;
                  rdfs:comment "Law on the interval zero to one, used for proportions and probabilities."@en ,
                               "Loi sur l'intervalle de zéro à un, employée pour les proportions et les probabilités."@fr ;
                  rdfs:label "BetaDistribution"@en ;
                  <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression> .


###  https://w3id.org/ontosim-dis#ChronicCourseDiseaseKnowledge
:ChronicCourseDiseaseKnowledge rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :hasDiseaseCourseShape ;
                                                                            owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000064>
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf :DiseaseKnowledgeTemplate ;
                               rdfs:comment "A disease whose course does not return to normal homeostasis. Requires at least one absorbing state."@en ,
                                            "Maladie dont le cours ne revient pas à l'homéostasie normale. Impose au moins un état absorbant."@fr ;
                               rdfs:label "ChronicCourseDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#City
:City rdf:type owl:Class ;
      rdfs:subClassOf :GeographicRegion ;
      rdfs:comment "Localité urbaine."@fr ,
                   "Urban locality"@en ;
      rdfs:label "City"@en .


###  https://w3id.org/ontosim-dis#Climate
:Climate rdf:type owl:Class ;
         rdfs:subClassOf :SimulationKnowledgeArtifact ;
         rdfs:comment "Climatic conditions influencing disease transmission. Decisive for vector-borne and water-borne diseases, where temperature and humidity govern the life cycle of the vector or of the intermediate host."@en ,
                      "Conditions climatiques influençant la transmission des maladies. Déterminantes pour les maladies à vecteur et à transmission hydrique, où température et humidité gouvernent le cycle de vie du vecteur ou de l'hôte intermédiaire."@fr ;
         rdfs:label "Climate"@en .


###  https://w3id.org/ontosim-dis#Compartment
:Compartment rdf:type owl:Class ;
             rdfs:subClassOf :StateComponent ;
             rdfs:comment "A group of individuals sharing the same situation, counted together. Compartmental form of a state component."@en ,
                          "Groupe d'individus partageant la même situation, comptés ensemble. Forme compartimentale d'un composant d'état."@fr ;
             rdfs:label "Compartment"@en .


###  https://w3id.org/ontosim-dis#CompartmentDependentRate
:CompartmentDependentRate rdf:type owl:Class ;
                          rdfs:subClassOf :RateSpecification ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :dependsOnCompartment ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :Compartment
                                          ] ;
                          owl:disjointWith :ConstantRate ;
                          rdfs:comment "A rate whose value depends on the current content of one or more compartments, which makes the system non-linear and coupled. Compartmental form of population coupling."@en ,
                                       "Taux dont la valeur dépend du contenu courant d'un ou plusieurs compartiments, ce qui rend le système non linéaire et couplé. Forme compartimentale du couplage populationnel."@fr ;
                          rdfs:label "CompartmentDependentRate"@en .


###  https://w3id.org/ontosim-dis#CompartmentalModel
:CompartmentalModel rdf:type owl:Class ;
                    rdfs:subClassOf :SimulationModel ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasCompartment ;
                                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Compartment
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasFlow ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :TransitionFlow
                                    ] ;
                    rdfs:comment "A model dividing the population into compartments, between which flows carry individuals at rates."@en ,
                                 "Modèle divisant la population en compartiments, entre lesquels des flux font passer les individus à certains taux."@fr ;
                    rdfs:label "CompartmentalModel"@en .


###  https://w3id.org/ontosim-dis#ConstantRate
:ConstantRate rdf:type owl:Class ;
              rdfs:subClassOf :RateSpecification ;
              rdfs:comment "A rate that does not depend on the current content of any compartment. Individual determinant. 'Constant' means here independent of the compartments, not fixed in time: a seasonal rate that reads no compartment is also a ConstantRate. It is then declared as such, and its value is written with rateExpression, since rateConstantValue only gives a fixed value."@en ,
                           "Taux qui ne dépend du contenu courant d'aucun compartiment. Déterminant individuel. « Constant » veut dire ici indépendant des compartiments, et non fixe dans le temps : un taux saisonnier qui ne lit aucun compartiment est aussi un ConstantRate. On le déclare alors comme tel, et sa valeur s'écrit avec rateExpression, car rateConstantValue ne donne qu'une valeur fixe."@fr ;
              rdfs:label "ConstantRate"@en .


###  https://w3id.org/ontosim-dis#ContextKnowledge
:ContextKnowledge rdf:type owl:Class ;
                  rdfs:subClassOf :SimulationKnowledgeArtifact ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasClimate ;
                                    owl:allValuesFrom :Climate
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasHealthInfrastructure ;
                                    owl:allValuesFrom :HealthInfrastructure
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasGeographicRegion ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :GeographicRegion
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasPopulation ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Population
                                  ] ;
                  rdfs:comment "Deuxième composant du Quadruplet de recomposition (CK). Décrit où, pour qui et dans quelles conditions un modèle s'applique."@fr ,
                               "Second component of the recomposition Quadruplet (CK). Describes where, for whom and under which conditions a model applies."@en ;
                  rdfs:label "ContextKnowledge"@en .


###  https://w3id.org/ontosim-dis#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :GeographicRegion ;
         rdfs:comment "Highest administrative level."@en ,
                      "Niveau administratif le plus haut."@fr ;
         rdfs:label "Country"@en .


###  https://w3id.org/ontosim-dis#CoupledAgentBasedModel
:CoupledAgentBasedModel rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :AgentBasedModel
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :hasAgentTransition ;
                                                                     owl:someValuesFrom :InteractionTriggeredTransition
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf :AgentBasedModel ;
                        rdfs:comment "An agent-based model containing at least one transition triggered by an interaction. Inferred by the reasoner without anyone declaring the model infectious."@en ,
                                     "Modèle multi-agents comportant au moins une transition déclenchée par une interaction. Inféré par le raisonneur sans que personne ait déclaré le modèle infectieux."@fr ;
                        rdfs:label "CoupledAgentBasedModel"@en .


###  https://w3id.org/ontosim-dis#CoupledCompartmentalModel
:CoupledCompartmentalModel rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :CompartmentalModel
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasFlow ;
                                                                        owl:someValuesFrom :CoupledFlow
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf :CompartmentalModel ;
                           rdfs:comment "A compartmental model containing at least one coupled flow. Inferred by the reasoner without anyone declaring the model infectious."@en ,
                                        "Modèle compartimental comportant au moins un flux couplé. Inféré par le raisonneur sans que personne ait déclaré le modèle infectieux."@fr ;
                           rdfs:label "CoupledCompartmentalModel"@en .


###  https://w3id.org/ontosim-dis#CoupledDiseaseKnowledge
:CoupledDiseaseKnowledge rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasStateTransition ;
                                                                      owl:someValuesFrom :CoupledTransition
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :DiseaseKnowledgeTemplate ;
                         rdfs:comment "Connaissance de maladie comportant au moins une transition couplée. Le raisonneur classe ici toute maladie dont une transition dépend de l'état de la population, SANS qu'on ait déclaré qu'elle est infectieuse."@fr ,
                                      "Disease knowledge containing at least one coupled transition. The reasoner classifies here any disease one of whose transitions depends on the state of the population WITHOUT anyone having declared it infectious."@en ;
                         rdfs:label "CoupledDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#CoupledFlow
:CoupledFlow rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :TransitionFlow
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :hasRate ;
                                                          owl:someValuesFrom :CompartmentDependentRate
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :TransitionFlow ;
             rdfs:comment "A flow whose rate depends on the content of a compartment."@en ,
                          "Flux dont le taux dépend du contenu d'un compartiment."@fr ;
             rdfs:label "CoupledFlow"@en .


###  https://w3id.org/ontosim-dis#CoupledTransition
:CoupledTransition rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :HealthStateTransition
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :isGovernedBy ;
                                                                owl:someValuesFrom :PopulationCoupledDeterminant
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :HealthStateTransition ;
                   rdfs:comment "A health state transition governed by at least one population-coupled determinant."@en ,
                                "Transition d'état de santé gouvernée par au moins un déterminant couplé à la population."@fr ;
                   rdfs:label "CoupledTransition"@en .


###  https://w3id.org/ontosim-dis#CouplingSource
:CouplingSource rdf:type owl:Class ;
                rdfs:subClassOf :SimulationKnowledgeArtifact ;
                rdfs:comment "A category whose current head count can be read, and whose reading may make a risk vary. Abstract class: never instantiated directly, only subclassed. A human health state in the core, a reservoir state in the infectious extension."@en ,
                             "Catégorie dont on peut lire l'effectif courant et dont la lecture peut faire varier un risque. Classe abstraite : on n'en crée jamais d'instance directe, seulement des sous-classes. Un état de santé humain dans le noyau, un état de réservoir dans l'extension infectieuse."@fr ;
                rdfs:label "CouplingSource"@en .


###  https://w3id.org/ontosim-dis#DetectionIntervention
:DetectionIntervention rdf:type owl:Class ;
                       rdfs:subClassOf :Intervention ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasSensitivity ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :ModelParameter
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasSpecificity ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :ModelParameter
                                       ] ;
                       rdfs:comment "An intervention whose purpose is to find out whether an individual has the disease, rather than to treat it. It changes a determinant through what it triggers: a detected individual is treated, followed up or isolated."@en ,
                                    "Intervention dont le but est de savoir si un individu a la maladie, et non de la soigner. Elle modifie un déterminant par l'intermédiaire de ce qu'elle déclenche : un individu détecté est traité, suivi ou isolé."@fr ;
                       rdfs:label "DetectionIntervention"@en ;
                       <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention> .


###  https://w3id.org/ontosim-dis#DiagnosisIntervention
:DiagnosisIntervention rdf:type owl:Class ;
                       rdfs:subClassOf :DetectionIntervention ;
                       owl:disjointWith :ScreeningIntervention ;
                       rdfs:comment "Detection applied to an individual who already shows signs of the disease. This is what clinical practice does in the absence of screening."@en ,
                                    "Détection appliquée à un individu présentant déjà des signes de la maladie. C'est ce que fait la pratique clinique en l'absence de dépistage."@fr ;
                       rdfs:label "DiagnosisIntervention"@en ;
                       <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention> .


###  https://w3id.org/ontosim-dis#DifferentialEquation
:DifferentialEquation rdf:type owl:Class ;
                      rdfs:subClassOf :ModelComponent ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :involvesFlow ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :TransitionFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :governsCompartment ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Compartment
                                      ] ;
                      rdfs:comment "The equation giving the variation over time of the content of one compartment, as the balance of the flows entering and leaving it."@en ,
                                   "Équation donnant la variation dans le temps du contenu d'un compartiment, comme bilan des flux qui y entrent et en sortent."@fr ;
                      rdfs:label "DifferentialEquation"@en .


###  https://w3id.org/ontosim-dis#DirectlyCoupledDeterminant
:DirectlyCoupledDeterminant rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :PopulationCoupledDeterminant
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :dependsOnCountIn ;
                                                                         owl:someValuesFrom :HealthState
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf :PopulationCoupledDeterminant ;
                            rdfs:comment "Classe DÉFINIE : déterminant dont la valeur se lit sur un effectif d'humains. Signature de la transmission interhumaine directe. Le raisonneur y classe la force d'infection du COVID, de la grippe, de la rougeole. N'est PAS disjointe de IndirectlyCoupledDeterminant : un risque peut lire les deux à la fois, ce qui est le cas du cycle complet de la schistosomiase."@fr ,
                                         "DEFINED class: a determinant whose value is read off a head count of humans. Signature of direct person-to-person transmission. NOT disjoint from IndirectlyCoupledDeterminant: one risk may read both, which is the case of the full schistosomiasis cycle."@en ;
                            rdfs:label "DirectlyCoupledDeterminant"@en .


###  https://w3id.org/ontosim-dis#DiseaseKnowledgeTemplate
:DiseaseKnowledgeTemplate rdf:type owl:Class ;
                          rdfs:subClassOf :SimulationKnowledgeArtifact ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :representsDisease ;
                                            owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000031>
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasDiseaseCourseShape ;
                                            owl:allValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000063>
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasRiskFactor ;
                                            owl:allValuesFrom :RiskFactor
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasHealthState ;
                                            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                            owl:onClass :HealthState
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasStateTransition ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :HealthStateTransition
                                          ] ;
                          rdfs:comment "First component of the recomposition Quadruplet (DK). Structured knowledge about a disease, independent of its type, of the modelling paradigm and of the geographical context. It is an information artifact: it is ABOUT a disease, it is not the disease."@en ,
                                       "Premier composant du Quadruplet de recomposition (DK). Connaissance structurée sur une maladie, indépendante de son type, du paradigme de modélisation et du contexte géographique. C'est un artefact d'information : il est À PROPOS d'une maladie, il n'est pas la maladie."@fr ;
                          rdfs:label "DiseaseKnowledgeTemplate"@en ;
                          <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#Disease> .


###  https://w3id.org/ontosim-dis#District
:District rdf:type owl:Class ;
          rdfs:subClassOf :GeographicRegion ;
          rdfs:comment "Administrative division of a region."@en ,
                       "Division administrative d'une région."@fr ;
          rdfs:label "District"@en .


###  https://w3id.org/ontosim-dis#DynamicParameter
:DynamicParameter rdf:type owl:Class ;
                  rdfs:subClassOf :ModelParameter ;
                  owl:disjointWith :StaticParameter ;
                  rdfs:comment "A parameter whose value varies with time, for instance a time-dependent transmission rate."@en ,
                               "Paramètre dont la valeur varie dans le temps, par exemple un taux de transmission dépendant du temps."@fr ;
                  rdfs:label "DynamicParameter"@en .


###  https://w3id.org/ontosim-dis#EnvironmentComponent
:EnvironmentComponent rdf:type owl:Class ;
                      rdfs:subClassOf :ModelComponent ;
                      rdfs:comment "An external or contextual factor influencing the modelled system: weather, terrain, infrastructure."@en ,
                                   "Facteur externe ou contextuel influençant le système modélisé : météo, relief, infrastructure."@fr ;
                      rdfs:label "EnvironmentComponent"@en .


###  https://w3id.org/ontosim-dis#EnvironmentModel
:EnvironmentModel rdf:type owl:Class ;
                  rdfs:subClassOf :EnvironmentComponent ;
                  rdfs:comment "Milieu dans lequel les agents se déplacent et se rencontrent. Sa nature spatiale est donnée par le type d'espace de la structure de modèle, en couche 2 et n'est pas répétée ici."@fr ,
                               "The surroundings in which agents move and meet. Its spatial nature is given by the spatial type of the model structure, in layer 2 and is not repeated here."@en ;
                  rdfs:label "EnvironmentModel"@en .


###  https://w3id.org/ontosim-dis#EnvironmentallyMediatedDiseaseKnowledge
:EnvironmentallyMediatedDiseaseKnowledge rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( :InfectiousDiseaseKnowledge
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :hasReservoirState ;
                                                                                      owl:someValuesFrom :ReservoirState
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf :InfectiousDiseaseKnowledge ;
                                         rdfs:comment """Classe DÉFINIE : maladie infectieuse dont la transmission passe par un effectif non
humain. Le raisonneur l'infère à partir de la structure du modèle, SANS que personne
ait déclaré la maladie environnementale. Schistosomiase, paludisme et choléra y
tombent ; COVID, grippe et rougeole n'y tombent pas."""@fr ,
                                                      "DEFINED class: an infectious disease whose transmission goes through a non-human head count. The reasoner infers it from the structure of the model, WITHOUT anyone having declared the disease environmental. Schistosomiasis, malaria and cholera fall here; COVID, influenza and measles do not."@en ;
                                         rdfs:label "EnvironmentallyMediatedDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#EpidemiologicalRole
:EpidemiologicalRole rdf:type owl:Class ;
                     rdfs:subClassOf :SimulationKnowledgeArtifact ;
                     rdfs:comment "Part qu'un organisme prend dans la transmission d'une maladie."@fr ,
                                  "The part an organism plays in the transmission of a disease."@en ;
                     rdfs:label "EpidemiologicalRole"@en .


###  https://w3id.org/ontosim-dis#ExecutionKnowledge
:ExecutionKnowledge rdf:type owl:Class ;
                    rdfs:subClassOf :SimulationKnowledgeArtifact ;
                    rdfs:comment "Comment exécuter le modèle : quel simulateur, combien de répétitions, avec quelle graine aléatoire. Quatrième composant du Quadruplet, à côté de la connaissance de la maladie, du contexte et de la structure. Ce n'est pas l'exécution elle-même, qui est un processus, mais la configuration que cette exécution réalise."@fr ,
                                 "How to run the model: which simulator, how many runs, with which random seed. Fourth component of the Quadruplet, alongside disease, context and structure knowledge. It is not the execution itself, which is a process, but the configuration that execution realises."@en ;
                    rdfs:label "ExecutionKnowledge"@en .


###  https://w3id.org/ontosim-dis#ExponentialDistribution
:ExponentialDistribution rdf:type owl:Class ;
                         rdfs:subClassOf :ProbabilityDistribution ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :lambdaParameter ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:double
                                         ] ;
                         rdfs:comment "Law of the time between two events occurring at a constant rate."@en ,
                                      "Loi du temps séparant deux événements survenant à taux constant."@fr ;
                         rdfs:label "ExponentialDistribution"@en ;
                         <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#ExponentialDistributionExpression> .


###  https://w3id.org/ontosim-dis#FreeLivingStageState
:FreeLivingStageState rdf:type owl:Class ;
                      rdfs:subClassOf :ReservoirState ;
                      owl:disjointWith :NonHumanHostState ;
                      rdfs:comment "Effectif d'un stade libre de l'agent pathogène présent dans un milieu, hors de tout hôte. Les cercaires dans l'eau, les miracidies. Sous l'hypothèse de quasi-équilibre, cet effectif se lit sur celui des hôtes qui le produisent et n'a pas besoin d'un compartiment propre."@fr ,
                                   "Head count of a free-living stage of the pathogen present in an environment, outside any host. The cercariae in the water, the miracidia. Under the quasi-equilibrium assumption, this head count is read off that of the hosts producing it and needs no compartment of its own."@en ;
                      rdfs:label "FreeLivingStageState"@en .


###  https://w3id.org/ontosim-dis#Fungus
:Fungus rdf:type owl:Class ;
        rdfs:subClassOf :Pathogen ;
        rdfs:comment "Champignon pathogène."@fr ,
                     "Pathogenic fungus."@en ;
        rdfs:label "Fungus"@en .


###  https://w3id.org/ontosim-dis#GammaDistribution
:GammaDistribution rdf:type owl:Class ;
                   rdfs:subClassOf :ProbabilityDistribution ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :alphaParameter ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:double
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :lambdaParameter ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:double
                                   ] ;
                   rdfs:comment "Law on positive values, used for costs and durations."@en ,
                                "Loi sur les valeurs positives, employée pour les coûts et les durées."@fr ;
                   rdfs:label "GammaDistribution"@en ;
                   <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression> .


###  https://w3id.org/ontosim-dis#GeographicRegion
:GeographicRegion rdf:type owl:Class ;
                  rdfs:subClassOf :SimulationKnowledgeArtifact ;
                  rdfs:comment "Territoire auquel un modèle s'applique. Quatre niveaux administratifs : pays, région, district, ville."@fr ,
                               "The territory a model applies to. Four administrative levels: country, region, district, city."@en ;
                  rdfs:label "GeographicRegion"@en .


###  https://w3id.org/ontosim-dis#GranularityLevel
:GranularityLevel rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( :GROUP
                                                    :INDIVIDUAL
                                                    :MULTISCALE
                                                    :REGIONAL
                                                  )
                                      ] ;
                  rdfs:subClassOf :SimulationKnowledgeArtifact ;
                  rdfs:comment "Level of detail at which the modelled entities are described. Closed list."@en ,
                               "Niveau de détail auquel les entités modélisées sont décrites. Liste fermée."@fr ;
                  rdfs:label "GranularityLevel"@en .


###  https://w3id.org/ontosim-dis#HealthCentre
:HealthCentre rdf:type owl:Class ;
              rdfs:subClassOf :HealthInfrastructure ;
              rdfs:comment "Local facility for primary care."@en ,
                           "Structure de proximité assurant les soins primaires."@fr ;
              rdfs:label "HealthCentre"@en .


###  https://w3id.org/ontosim-dis#HealthInfrastructure
:HealthInfrastructure rdf:type owl:Class ;
                      rdfs:subClassOf :SimulationKnowledgeArtifact ;
                      rdfs:comment "Health facilities available in the context. Determines the capacity to respond, and the saturation threshold beyond which lethality rises."@en ,
                                   "Structures de santé disponibles dans le contexte. Détermine la capacité de réponse, et le seuil de saturation au-delà duquel la létalité augmente."@fr ;
                      rdfs:label "HealthInfrastructure"@en .


###  https://w3id.org/ontosim-dis#HealthState
:HealthState rdf:type owl:Class ;
             rdfs:subClassOf :CouplingSource ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :representsPhaseOf ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000063>
                             ] ;
             owl:disjointWith :ReservoirState ;
             rdfs:comment "A state an individual can occupy with respect to a disease. It is knowledge about a phase of the disease course, NOT a component of a model: a compartment or an agent state represents it, through the bridge representsHealthState."@en ,
                          "État qu'un individu peut occuper vis-à-vis d'une maladie. C'est une connaissance sur une phase du cours de la maladie et NON un composant de modèle : un compartiment ou un état d'agent le représente, par le pont representsHealthState."@fr ;
             rdfs:label "HealthState"@en ;
             <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement> .


###  https://w3id.org/ontosim-dis#HealthStateTransition
:HealthStateTransition rdf:type owl:Class ;
                       rdfs:subClassOf :SimulationKnowledgeArtifact ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :isGovernedBy ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :TransitionDeterminant
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasSourceHealthState ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :HealthState
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasTargetHealthState ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :HealthState
                                       ] ;
                       owl:disjointWith :ReservoirState ;
                       rdfs:comment "Passage d'un individu d'un état de santé à un autre. Classe pivot du noyau : c'est le seul endroit où la structure du modèle est décidée, parce que c'est le déterminant de la transition qui impose sa forme mathématique."@fr ,
                                    "The passage of an individual from one health state to another. Pivot class of the core: it is the only place where the structure of the model is decided, because it is the determinant of the transition that imposes its mathematical form."@en ;
                       rdfs:label "HealthStateTransition"@en ;
                       <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#Pathway> .


###  https://w3id.org/ontosim-dis#Hospital
:Hospital rdf:type owl:Class ;
          rdfs:subClassOf :HealthInfrastructure ;
          rdfs:comment "Facility with beds, able to admit severe cases."@en ,
                       "Structure disposant de lits, capable d'accueillir les cas graves."@fr ;
          rdfs:label "Hospital"@en .


###  https://w3id.org/ontosim-dis#HostRole
:HostRole rdf:type owl:Class ;
          rdfs:subClassOf :EpidemiologicalRole ;
          rdfs:comment "Organism in which the pathogen develops and which suffers the disease."@en ,
                       "Organisme dans lequel l'agent pathogène se développe et qui subit la maladie."@fr ;
          rdfs:label "HostRole"@en .


###  https://w3id.org/ontosim-dis#IndirectlyCoupledDeterminant
:IndirectlyCoupledDeterminant rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( :PopulationCoupledDeterminant
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :dependsOnCountIn ;
                                                                           owl:someValuesFrom :ReservoirState
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf :PopulationCoupledDeterminant ;
                              rdfs:comment "Classe DÉFINIE : déterminant dont la valeur se lit sur un effectif non humain. Signature de la transmission médiée par un réservoir ou un milieu. Le raisonneur y classe le risque d'infection de la schistosomiase, du paludisme, du choléra."@fr ,
                                           "DEFINED class: a determinant whose value is read off a non-human head count. Signature of reservoir-mediated or environmentally mediated transmission. The reasoner classifies here the infection risk of schistosomiasis, malaria and cholera."@en ;
                              rdfs:label "IndirectlyCoupledDeterminant"@en .


###  https://w3id.org/ontosim-dis#IndividualAttribute
:IndividualAttribute rdf:type owl:Class ;
                     rdfs:subClassOf :SimulationKnowledgeArtifact ;
                     rdfs:comment "A clinical or demographic characteristic of an individual whose value can change the course of the disease: age, sex, comorbidity, biomarker, vaccination status."@en ,
                                  "Caractéristique clinique ou démographique d'un individu dont la valeur peut modifier l'évolution de la maladie : âge, sexe, comorbidité, biomarqueur, statut vaccinal."@fr ;
                     rdfs:label "IndividualAttribute"@en ;
                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#Attribute> .


###  https://w3id.org/ontosim-dis#IndividualDeterminant
:IndividualDeterminant rdf:type owl:Class ;
                       rdfs:subClassOf :TransitionDeterminant ;
                       owl:disjointWith :PopulationCoupledDeterminant ;
                       rdfs:comment "A determinant whose value does not depend on the other individuals. It may read attributes of the individual concerned (age, sex, comorbidity, biomarker), or none, like the recovery rate γ of the SIR model. Structural consequence: individual trajectories are independent, which allows microsimulation and multi-state models."@en ,
                                    "Déterminant dont la valeur ne dépend pas des autres individus. Il peut lire des attributs de l'individu concerné (âge, sexe, comorbidité, biomarqueur), ou aucun, comme le taux de guérison γ du modèle SIR. Conséquence structurelle : les trajectoires individuelles sont indépendantes, ce qui autorise la microsimulation et les modèles multi-états. Pleinement couvert par OSDi."@fr ;
                       rdfs:label "IndividualDeterminant"@en .


###  https://w3id.org/ontosim-dis#IndividualProgressionDiseaseKnowledge
:IndividualProgressionDiseaseKnowledge rdf:type owl:Class ;
                                       owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty :hasStateTransition ;
                                                                                    owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty :isGovernedBy ;
                                                                                                        owl:allValuesFrom :IndividualDeterminant
                                                                                                      ]
                                                                                  ]
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ] ;
                                       rdfs:subClassOf :DiseaseKnowledgeTemplate ;
                                       rdfs:comment "Connaissance de maladie dont toutes les transitions sont individuelles. Modélisable par microsimulation, modèle multi-états ou arbre de décision."@fr ,
                                                    "Disease knowledge all of whose transitions are individual. Modellable by microsimulation, multi-state model or decision tree."@en ;
                                       rdfs:label "IndividualProgressionDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#InfectiousDiseaseKnowledge
:InfectiousDiseaseKnowledge rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :hasPathogen ;
                                                                         owl:someValuesFrom :Pathogen
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf :DiseaseKnowledgeTemplate ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasTransmissionRoute ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :TransmissionRoute
                                            ] ;
                            rdfs:comment "Connaissance d'une maladie causée par un agent pathogène. Classe DÉFINIE : toute connaissance de maladie déclarant un agent pathogène est classée ici par le raisonneur, sans qu'on ait à dire qu'elle est infectieuse."@fr ,
                                         "Knowledge of a disease caused by a pathogen. DEFINED class: any disease knowledge declaring a pathogen is classified here by the reasoner, without anyone having to say it is infectious."@en ;
                            rdfs:label "InfectiousDiseaseKnowledge"@en ;
                            <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#InfectiousDisease> .


###  https://w3id.org/ontosim-dis#InitialCondition
:InitialCondition rdf:type owl:Class ;
                  rdfs:subClassOf :ModelParameter ;
                  rdfs:comment "A parameter giving the value of a quantity at the start of the simulation."@en ,
                               "Paramètre donnant la valeur d'une grandeur au début de la simulation."@fr ;
                  rdfs:label "InitialCondition"@en .


###  https://w3id.org/ontosim-dis#InteractionTriggeredTransition
:InteractionTriggeredTransition rdf:type owl:Class ;
                                owl:equivalentClass [ owl:intersectionOf ( :AgentTransition
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty :triggeredBy ;
                                                                             owl:someValuesFrom :InteractionType
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ;
                                rdfs:subClassOf :AgentTransition ;
                                rdfs:comment "A transition triggered by an interaction with other agents, hence depending on their state. Agent-based form of population coupling. Defined class: the reasoner classifies here any agent transition triggered by an interaction."@en ,
                                             "Transition déclenchée par une interaction avec d'autres agents, donc dépendant de leur état. Forme multi-agents du couplage populationnel. Classe définie : le raisonneur classe ici toute transition d'agent déclenchée par une interaction."@fr ;
                                rdfs:label "InteractionTriggeredTransition"@en .


###  https://w3id.org/ontosim-dis#InteractionType
:InteractionType rdf:type owl:Class ;
                 rdfs:subClassOf :ModelComponent ;
                 rdfs:comment "A kind of encounter or exchange between agents."@en ,
                              "Sorte de rencontre ou d'échange entre agents."@fr ;
                 rdfs:label "InteractionType"@en .


###  https://w3id.org/ontosim-dis#IntermediateHostRole
:IntermediateHostRole rdf:type owl:Class ;
                      rdfs:subClassOf :EpidemiologicalRole ;
                      rdfs:comment "Organism in which the pathogen goes through a stage of its life cycle before reaching its final host. The snail in schistosomiasis."@en ,
                                   "Organisme dans lequel l'agent pathogène accomplit une étape de son cycle de vie avant d'atteindre son hôte final. L'escargot dans la schistosomiase."@fr ;
                      rdfs:label "IntermediateHostRole"@en .


###  https://w3id.org/ontosim-dis#Intervention
:Intervention rdf:type owl:Class ;
              rdfs:subClassOf :SimulationKnowledgeArtifact ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :modifiesDeterminant ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :TransitionDeterminant
                              ] ;
              rdfs:comment "A control measure applied during the simulation, which changes the course of the disease by modifying at least one determinant."@en ,
                           "Mesure de contrôle appliquée pendant la simulation, qui modifie le cours de la maladie en agissant sur au moins un déterminant."@fr ;
              rdfs:label "Intervention"@en ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#Intervention> .


###  https://w3id.org/ontosim-dis#InterventionScenario
:InterventionScenario rdf:type owl:Class ;
                      rdfs:subClassOf :SimulationScenario ;
                      rdfs:comment "A scenario in which one or more interventions are applied: vaccination, treatment, control measure."@en ,
                                   "Scénario dans lequel une ou plusieurs interventions sont appliquées : vaccination, traitement, mesure de contrôle."@fr ;
                      rdfs:label "InterventionScenario"@en ;
                      <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#Intervention> .


###  https://w3id.org/ontosim-dis#Isolation
:Isolation rdf:type owl:Class ;
           rdfs:subClassOf :NonPharmaceuticalIntervention ;
           rdfs:comment "Mise à l'écart d'individus dont on sait qu'ils sont infectieux."@fr ,
                        "Separation of individuals known to be infectious."@en ;
           rdfs:label "Isolation"@en .


###  https://w3id.org/ontosim-dis#MaskWearing
:MaskWearing rdf:type owl:Class ;
             rdfs:subClassOf :NonPharmaceuticalIntervention ;
             rdfs:comment "Reduction of the probability of transmission during a contact."@en ,
                          "Réduction de la probabilité de transmission lors d'un contact."@fr ;
             rdfs:label "MaskWearing"@en .


###  https://w3id.org/ontosim-dis#MixedPopulation
:MixedPopulation rdf:type owl:Class ;
                 rdfs:subClassOf :Population ;
                 rdfs:comment "A population combining urban and rural zones within the same territory."@en ,
                              "Population mêlant zones urbaines et rurales au sein d'un même territoire."@fr ;
                 rdfs:label "MixedPopulation"@en .


###  https://w3id.org/ontosim-dis#ModelComponent
:ModelComponent rdf:type owl:Class ;
                rdfs:subClassOf :SimulationKnowledgeArtifact ;
                rdfs:comment "A constituent part of the structure of a model."@en ,
                             "Partie constitutive de la structure d'un modèle."@fr ;
                rdfs:label "ModelComponent"@en .


###  https://w3id.org/ontosim-dis#ModelNature
:ModelNature rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :EMPIRICAL
                                               :GREY_BOX
                                               :MECHANISTIC
                                             )
                                 ] ;
             rdfs:subClassOf :SimulationKnowledgeArtifact ;
             rdfs:comment "Dit si le modèle explique les mécanismes ou se contente de reproduire les observations. Liste fermée. Ce critère décide de ce qui est recomposable : on ne recompose pas une boîte noire comme un modèle à mécanismes."@fr ,
                          "States whether the model explains mechanisms or merely reproduces observations. Closed list. This criterion decides what can be recomposed: a black box is not recomposed the way a mechanistic model is."@en ;
             rdfs:label "ModelNature"@en .


###  https://w3id.org/ontosim-dis#ModelParameter
:ModelParameter rdf:type owl:Class ;
                rdfs:subClassOf :ModelComponent ;
                rdfs:comment "A named quantity whose value settles part of the behaviour of the model. Merges the former ParameterComponent and ModelParameter."@en ,
                             "Grandeur nommée dont la valeur fixe une partie du comportement du modèle. Fusionne les anciennes classes ParameterComponent et ModelParameter."@fr ;
                rdfs:label "ModelParameter"@en ;
                <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#Parameter> .


###  https://w3id.org/ontosim-dis#ModelPurpose
:ModelPurpose rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :DYNAMICS_RESEARCH
                                                :EPIDEMIC_PLANNING
                                                :METHODOLOGICAL_RESEARCH
                                                :RETROSPECTIVE_ANALYSIS
                                              )
                                  ] ;
              rdfs:subClassOf :SimulationKnowledgeArtifact ;
              rdfs:comment "Objectif pour lequel le modèle a été construit. Liste fermée. Connaître l'objectif permet de juger si un modèle convient à une situation donnée, et d'identifier les caractéristiques qu'il doit réunir."@fr ,
                           "Purpose the model was built for. Closed list. Knowing the purpose is what lets one judge whether a model fits a given situation, and identify the features it must combine."@en ;
              rdfs:label "ModelPurpose"@en .


###  https://w3id.org/ontosim-dis#ModelScope
:ModelScope rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :GENERAL
                                              :SPECIFIC
                                            )
                                ] ;
            rdfs:subClassOf :SimulationKnowledgeArtifact ;
            rdfs:comment "Dit si le modèle est réglable pour plusieurs maladies ou construit pour une seule. Liste fermée. C'est le critère qui décide si un modèle est réutilisable ailleurs."@fr ,
                         "States whether the model can be retuned for several diseases or was built for one. Closed list. This is the criterion that decides whether a model is reusable elsewhere."@en ;
            rdfs:label "ModelScope"@en .


###  https://w3id.org/ontosim-dis#ModelStructureKnowledge
:ModelStructureKnowledge rdf:type owl:Class ;
                         rdfs:subClassOf :SimulationKnowledgeArtifact ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasComponent ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ModelComponent
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasGranularityLevel ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :GranularityLevel
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasParadigm ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ParadigmType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasSpatialType ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :SpatialType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasTemporalType ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :TemporalType
                                         ] ;
                         rdfs:comment "Connaissance décrivant la structure interne d'un modèle : ses composants, et ses choix de traitement du hasard (déterministe ou stochastique), de temps, d'espace et de granularité. Composant MSK du Quadruplet de recomposition."@fr ,
                                      "Knowledge describing the internal structure of a model: its components, and its choices of handling of chance (deterministic or stochastic), time, space and granularity. MSK component of the recomposition Quadruplet."@en ;
                         rdfs:label "ModelStructureKnowledge"@en .


###  https://w3id.org/ontosim-dis#MovementRestriction
:MovementRestriction rdf:type owl:Class ;
                     rdfs:subClassOf :NonPharmaceuticalIntervention ;
                     rdfs:comment "Limitation des déplacements : confinement, couvre-feu, fermeture des frontières."@fr ,
                                  "Limitation of movement: lockdown, curfew, closure of borders."@en ;
                     rdfs:label "MovementRestriction"@en .


###  https://w3id.org/ontosim-dis#NonHumanHostState
:NonHumanHostState rdf:type owl:Class ;
                   rdfs:subClassOf :ReservoirState ;
                   rdfs:comment "Effectif d'organismes non humains se trouvant dans un état donné du cycle de l'agent pathogène. Les escargots infectés de la schistosomiase, les moustiques infectieux du paludisme."@fr ,
                                "Head count of non-human organisms in a given state of the pathogen cycle. The infected snails of schistosomiasis, the infectious mosquitoes of malaria."@en ;
                   rdfs:label "NonHumanHostState"@en .


###  https://w3id.org/ontosim-dis#NonPharmaceuticalIntervention
:NonPharmaceuticalIntervention rdf:type owl:Class ;
                               rdfs:subClassOf :Intervention ;
                               owl:disjointWith :PharmaceuticalIntervention ;
                               rdfs:comment "An intervention acting on behaviour or on regulation without any medical product."@en ,
                                            "Intervention agissant sur le comportement ou la réglementation sans produit médical."@fr ;
                               rdfs:label "NonPharmaceuticalIntervention"@en .


###  https://w3id.org/ontosim-dis#NormalDistribution
:NormalDistribution rdf:type owl:Class ;
                    rdfs:subClassOf :ProbabilityDistribution ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :meanParameter ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:double
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :standardDeviationParameter ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:double
                                    ] ;
                    rdfs:comment "Loi symétrique caractérisée par une moyenne et un écart type."@fr ,
                                 "Symmetric law characterised by a mean and a standard deviation."@en ;
                    rdfs:label "NormalDistribution"@en ;
                    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#NormalDistributionExpression> .


###  https://w3id.org/ontosim-dis#ParadigmType
:ParadigmType rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :DETERMINISTIC
                                                :STOCHASTIC
                                              )
                                  ] ;
              rdfs:subClassOf :SimulationKnowledgeArtifact ;
              rdfs:comment "Nature du traitement du hasard par le modèle : déterministe ou stochastique. Liste fermée. Malgré son nom, cette classe ne désigne pas le paradigme de modélisation au sens des couches 3A et 3B (agents, compartiments) : un modèle à compartiments peut être déterministe ou stochastique."@fr ,
                           "Nature of the model's handling of chance: deterministic or stochastic. Closed list. Despite its name, this class does not denote the modelling paradigm in the sense of layers 3A and 3B (agents, compartments): a compartmental model may be deterministic or stochastic."@en ;
              rdfs:label "ParadigmType"@en .


###  https://w3id.org/ontosim-dis#Parasite
:Parasite rdf:type owl:Class ;
          rdfs:subClassOf :Pathogen ;
          rdfs:comment "Organism living at the expense of a host, often with a life cycle passing through several hosts."@en ,
                       "Organisme vivant aux dépens d'un hôte, souvent avec un cycle de vie passant par plusieurs hôtes."@fr ;
          rdfs:label "Parasite"@en .


###  https://w3id.org/ontosim-dis#Pathogen
:Pathogen rdf:type owl:Class ;
          rdfs:subClassOf :SimulationKnowledgeArtifact ;
          rdfs:comment "Agent infectieux responsable de la maladie."@fr ,
                       "The infectious agent responsible for the disease."@en ;
          rdfs:label "Pathogen"@en .


###  https://w3id.org/ontosim-dis#PharmaceuticalIntervention
:PharmaceuticalIntervention rdf:type owl:Class ;
                            rdfs:subClassOf :Intervention ;
                            rdfs:comment "An intervention using a medical product: vaccine, antiviral, antibiotic."@en ,
                                         "Intervention reposant sur un produit médical : vaccin, antiviral, antibiotique."@fr ;
                            rdfs:label "PharmaceuticalIntervention"@en ;
                            <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#TherapeuticIntervention> .


###  https://w3id.org/ontosim-dis#PoissonDistribution
:PoissonDistribution rdf:type owl:Class ;
                     rdfs:subClassOf :ProbabilityDistribution ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :lambdaParameter ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:double
                                     ] ;
                     rdfs:comment "Law of the number of events occurring in a fixed interval."@en ,
                                  "Loi du nombre d'événements survenant dans un intervalle fixe."@fr ;
                     rdfs:label "PoissonDistribution"@en ;
                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#PoissonDistributionExpression> .


###  https://w3id.org/ontosim-dis#Population
:Population rdf:type owl:Class ;
            rdfs:subClassOf :SimulationKnowledgeArtifact ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :isLocatedInRegion ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :GeographicRegion
                            ] ;
            rdfs:comment "A group of individuals in a geographical context. Partial alignment with osdi:Population, which describes a clinical cohort by age, sex, life expectancy and size, here the population is situated, with its density, its households and its territory. The overlap is partial and must be documented as such."@en ,
                         "Groupe d'individus dans un contexte géographique. Alignement partiel avec osdi:Population, qui décrit une cohorte clinique par âge, sexe, espérance de vie et effectif ; ici la population est située, avec sa densité, ses ménages et son territoire. Le recouvrement est partiel et doit être documenté comme tel."@fr ;
            rdfs:label "Population"@en ;
            <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.obolibrary.org/obo/OGMS_0000084> ,
                                                               <https://w3id.org/ontologies-ULL/OSDi#Population> .


###  https://w3id.org/ontosim-dis#PopulationCoupledDeterminant
:PopulationCoupledDeterminant rdf:type owl:Class ;
                              rdfs:subClassOf :TransitionDeterminant ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty :dependsOnCountIn ;
                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass :CouplingSource
                                              ] ;
                              rdfs:comment "A determinant whose value depends on how many individuals are currently in some category, human or not. Canonical example: the force of infection. Structural consequence: the system is non-linear and coupled, individual trajectories are not independent."@en ,
                                           "Déterminant dont la valeur dépend du nombre d'individus se trouvant actuellement dans une catégorie donnée, humaine ou non. Exemple canonique : la force d'infection. Conséquence structurelle : le système est non linéaire et couplé, les trajectoires individuelles ne sont pas indépendantes."@fr ;
                              rdfs:label "PopulationCoupledDeterminant"@en .


###  https://w3id.org/ontosim-dis#ProbabilityDistribution
:ProbabilityDistribution rdf:type owl:Class ;
                         rdfs:subClassOf :SimulationKnowledgeArtifact ;
                         rdfs:comment "A probability law characterising the uncertainty of a parameter, or the random draw of a value."@en ,
                                      "Loi de probabilité caractérisant l'incertitude d'un paramètre, ou le tirage aléatoire d'une valeur."@fr ;
                         rdfs:label "ProbabilityDistribution"@en ;
                         <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression> .


###  https://w3id.org/ontosim-dis#ProgressiveCourseDiseaseKnowledge
:ProgressiveCourseDiseaseKnowledge rdf:type owl:Class ;
                                   owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasDiseaseCourseShape ;
                                                                                owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000065>
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ;
                                   rdfs:subClassOf :DiseaseKnowledgeTemplate ;
                                   rdfs:comment "A disease with an increasing deviation from homeostasis. Requires an ordered progression through stages, without return."@en ,
                                                "Maladie à déviation croissante. Impose une progression ordonnée par stades, sans retour."@fr ;
                                   rdfs:label "ProgressiveCourseDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#Quarantine
:Quarantine rdf:type owl:Class ;
            rdfs:subClassOf :NonPharmaceuticalIntervention ;
            rdfs:comment "Mise à l'écart d'individus possiblement exposés, pour les empêcher de transmettre."@fr ,
                         "Separation of individuals who may have been exposed, to prevent them from transmitting."@en ;
            rdfs:label "Quarantine"@en .


###  https://w3id.org/ontosim-dis#RateSpecification
:RateSpecification rdf:type owl:Class ;
                   rdfs:subClassOf :ModelParameter ;
                   rdfs:comment "Façon dont le taux d'un flux est déterminé."@fr ,
                                "The way the rate of a flow is determined."@en ;
                   rdfs:label "RateSpecification"@en .


###  https://w3id.org/ontosim-dis#ReservoirRole
:ReservoirRole rdf:type owl:Class ;
               rdfs:subClassOf :EpidemiologicalRole ;
               rdfs:comment "Organism or environment where the pathogen persists between outbreaks."@en ,
                            "Organisme ou milieu où l'agent pathogène persiste entre deux épidémies."@fr ;
               rdfs:label "ReservoirRole"@en .


###  https://w3id.org/ontosim-dis#ReservoirState
:ReservoirState rdf:type owl:Class ;
                rdfs:subClassOf :CouplingSource ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isStateOfRole ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :EpidemiologicalRole
                                ] ;
                owl:disjointWith :TransitionDeterminant ;
                rdfs:comment "A non-human category whose current head count may make a risk vary: infected snails, cercariae present in a water body, infectious mosquitoes. It is not a health state, because the entity counted is not the individual whose disease is being modelled. It is the other kind of CouplingSource, the one that makes schistosomiasis representable."@en ,
                             "Catégorie non humaine dont l'effectif courant peut faire varier un risque : escargots infectés, cercaires présentes dans un point d'eau, moustiques infectieux. Ce n'est pas un état de santé, parce que l'entité comptée n'est pas l'individu dont on modélise la maladie. C'est l'autre sorte de CouplingSource, celle qui rend la schistosomiase représentable."@fr ;
                rdfs:label "ReservoirState"@en .


###  https://w3id.org/ontosim-dis#RiskFactor
:RiskFactor rdf:type owl:Class ;
            rdfs:subClassOf :SimulationKnowledgeArtifact ;
            rdfs:comment "An element increasing the probability of a transition. May be an individual attribute, a contextual element or an exposure."@en ,
                         "Élément augmentant la probabilité d'une transition. Peut être un attribut individuel, un élément de contexte ou une exposition."@fr ;
            rdfs:label "RiskFactor"@en ;
            <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/OGMS_0000030> .


###  https://w3id.org/ontosim-dis#RuleComponent
:RuleComponent rdf:type owl:Class ;
               rdfs:subClassOf :ModelComponent ;
               rdfs:comment "A rule governing the behaviour of the model: decision rule, behaviour rule, interaction rule."@en ,
                            "Règle gouvernant le comportement du modèle : règle de décision, de comportement, d'interaction."@fr ;
               rdfs:label "RuleComponent"@en .


###  https://w3id.org/ontosim-dis#RuralPopulation
:RuralPopulation rdf:type owl:Class ;
                 rdfs:subClassOf :Population ;
                 rdfs:comment "A population living mainly in the countryside, with a low density and fewer contacts."@en ,
                              "Population vivant majoritairement en zone rurale, à faible densité et à contacts moins fréquents."@fr ;
                 rdfs:label "RuralPopulation"@en .


###  https://w3id.org/ontosim-dis#SchoolClosure
:SchoolClosure rdf:type owl:Class ;
               rdfs:subClassOf :NonPharmaceuticalIntervention ;
               rdfs:comment "Closure of schools, which removes from the mixing population the age group with the highest contact rate."@en ,
                            "Fermeture des établissements scolaires."@fr ;
               rdfs:label "SchoolClosure"@en .


###  https://w3id.org/ontosim-dis#ScreeningIntervention
:ScreeningIntervention rdf:type owl:Class ;
                       rdfs:subClassOf :DetectionIntervention ;
                       rdfs:comment "Detection applied to a whole population, including individuals showing no sign of the disease. Newborn screening is the typical case."@en ,
                                    "Détection appliquée à une population entière, y compris aux individus ne présentant aucun signe de la maladie. Le dépistage néonatal en est le cas type."@fr ;
                       rdfs:label "ScreeningIntervention"@en ;
                       <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention> .


###  https://w3id.org/ontosim-dis#SimulationExecution
:SimulationExecution rdf:type owl:Class ;
                     rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :appliesExecutionKnowledge ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :ExecutionKnowledge
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :executesModel ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :SimulationModel
                                     ] ;
                     rdfs:comment """Ceci représente le processus d'exécution d'un modèle de simulation sur un simulateur.
Ce n'est pas un artefact d'information mais un processus car il se déroule dans le temps."""@fr ,
                                  """This represents the process of executing a simulation model on a simulator.
It is not an information artifact but a process, because it unfolds over time."""@en ;
                     rdfs:label "SimulationExecution"@en .


###  https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact
:SimulationKnowledgeArtifact rdf:type owl:Class ;
                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ;
                             rdfs:comment "Artefact d'information portant une connaissance utilisée pour construire, décrire ou exécuter un modèle de simulation."@fr ,
                                          "Information artifact carrying knowledge used to build, describe, or execute a simulation model."@en ;
                             rdfs:label "SimulationKnowledgeArtifact"@en .


###  https://w3id.org/ontosim-dis#SimulationModel
:SimulationModel rdf:type owl:Class ;
                 rdfs:subClassOf :SimulationKnowledgeArtifact ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasParameter ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ModelParameter
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasValidationMethod ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ValidationMethod
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :usesScenario ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :SimulationScenario
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasStructureKnowledge ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ModelStructureKnowledge
                                 ] ;
                 rdfs:comment "A representation of a system whose behaviour is studied by simulation, independently of the paradigm used."@en ,
                              "Représentation d'un système dont on étudie le comportement par simulation, indépendamment du paradigme employé."@fr ;
                 rdfs:label "SimulationModel"@en ;
                 <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/ontologies-ULL/OSDi#Model> .


###  https://w3id.org/ontosim-dis#SimulationObservation
:SimulationObservation rdf:type owl:Class ;
                       rdfs:subClassOf :SimulationKnowledgeArtifact ;
                       rdfs:comment "Données réelles observées, servant à valider un modèle par comparaison avec ses résultats."@fr ,
                                    "Real observed data, used to validate a model by comparison with its results."@en ;
                       rdfs:label "SimulationObservation"@en .


###  https://w3id.org/ontosim-dis#SimulationResult
:SimulationResult rdf:type owl:Class ;
                  rdfs:subClassOf :SimulationKnowledgeArtifact ;
                  rdfs:comment "Data produced by a simulation execution."@en ,
                               "Données produites par une exécution de simulation."@fr ;
                  rdfs:label "SimulationResult"@en .


###  https://w3id.org/ontosim-dis#SimulationScenario
:SimulationScenario rdf:type owl:Class ;
                    rdfs:subClassOf :SimulationKnowledgeArtifact ;
                    rdfs:comment "A set of hypotheses and settings under which a model is run."@en ,
                                 "Ensemble d'hypothèses et de réglages sous lesquels un modèle est exécuté."@fr ;
                    rdfs:label "SimulationScenario"@en .


###  https://w3id.org/ontosim-dis#SocialDistancing
:SocialDistancing rdf:type owl:Class ;
                  rdfs:subClassOf :NonPharmaceuticalIntervention ;
                  rdfs:comment "Reduction of close contacts throughout the population."@en ,
                               "Réduction des contacts rapprochés dans l'ensemble de la population."@fr ;
                  rdfs:label "SocialDistancing"@en .


###  https://w3id.org/ontosim-dis#SpatialType
:SpatialType rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :GIS
                                               :GRID
                                               :NETWORK
                                               :NON_SPATIAL
                                             )
                                 ] ;
             rdfs:subClassOf :SimulationKnowledgeArtifact ;
             rdfs:comment "Façon dont l'espace est représenté dans le modèle. Liste fermée."@fr ,
                          "Way space is represented in the model. Closed list."@en ;
             rdfs:label "SpatialType"@en .


###  https://w3id.org/ontosim-dis#StateComponent
:StateComponent rdf:type owl:Class ;
                rdfs:subClassOf :ModelComponent ;
                rdfs:comment "A state that an entity of the model can occupy at a given time. Specialised as a compartment in compartmental models [C3B] and as an agent state in agent-based models [C3A]."@en ,
                             "État qu'une entité du modèle peut occuper à un instant donné. Se spécialise en compartiment pour les modèles compartimentaux [C3B] et en état d'agent pour les modèles à agents [C3A]."@fr ;
                rdfs:label "StateComponent"@en .


###  https://w3id.org/ontosim-dis#StaticApproximationAgentTransition
:StaticApproximationAgentTransition rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( :AttributeDrivenTransition
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :representsStateTransition ;
                                                                                 owl:someValuesFrom :CoupledTransition
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:subClassOf :AttributeDrivenTransition ;
                                    rdfs:comment "An agent transition that represents a coupled transition but is triggered by the agent's own attributes alone, not by an interaction. Agent-based form of the static approximation."@en ,
                                                 "Transition d'agent qui représente une transition couplée, mais qui est déclenchée par les seuls attributs de l'agent, et non par une interaction. Forme multi-agents de l'approximation statique."@fr ;
                                    rdfs:label "StaticApproximationAgentTransition"@en .


###  https://w3id.org/ontosim-dis#StaticApproximationFlow
:StaticApproximationFlow rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :TransitionFlow
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasRate ;
                                                                      owl:someValuesFrom :ConstantRate
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :representsStateTransition ;
                                                                      owl:someValuesFrom :CoupledTransition
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :TransitionFlow ;
                         rdfs:comment "A flow that represents a coupled transition but whose rate is constant: it does not read the head count on which the risk depends. Compartmental form of the static approximation."@en ,
                                      "Flux qui représente une transition couplée, mais dont le taux est constant : il ne lit pas l'effectif dont dépend le risque. Forme compartimentale de l'approximation statique."@fr ;
                         rdfs:label "StaticApproximationFlow"@en .


###  https://w3id.org/ontosim-dis#StaticApproximationModel
:StaticApproximationModel rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( :SimulationModel
                                                                     [ rdf:type owl:Class ;
                                                                       owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty :hasAgentTransition ;
                                                                                       owl:someValuesFrom :StaticApproximationAgentTransition
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty :hasFlow ;
                                                                                       owl:someValuesFrom :StaticApproximationFlow
                                                                                     ]
                                                                                   )
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf :SimulationModel ;
                          rdfs:comment "A model containing at least one static approximation: it represents a coupled transition without realising the coupling. It therefore ignores the indirect effects of an intervention, such as herd immunity. The approximation is acceptable when the intervention studied does not change transmission; otherwise, a dynamic model is needed. Inferred by the reasoner."@en ,
                                       "Modèle comportant au moins une approximation statique : il représente une transition couplée sans en réaliser le couplage. Il ignore donc les effets indirects d'une intervention, comme l'immunité de groupe. L'approximation est acceptable lorsque l'intervention étudiée ne modifie pas la transmission ; sinon, un modèle dynamique est nécessaire. Inféré par le raisonneur."@fr ;
                          rdfs:label "StaticApproximationModel"@en .


###  https://w3id.org/ontosim-dis#StaticParameter
:StaticParameter rdf:type owl:Class ;
                 rdfs:subClassOf :ModelParameter ;
                 rdfs:comment "A parameter whose value does not change during the simulation."@en ,
                              "Paramètre dont la valeur ne change pas au cours de la simulation."@fr ;
                 rdfs:label "StaticParameter"@en .


###  https://w3id.org/ontosim-dis#TemperateClimate
:TemperateClimate rdf:type owl:Class ;
                  rdfs:subClassOf :Climate ;
                  rdfs:comment "Climat à saisons marquées et températures modérées."@fr ,
                               "Climate with marked seasons and moderate temperatures."@en ;
                  rdfs:label "TemperateClimate"@en .


###  https://w3id.org/ontosim-dis#TemporalType
:TemporalType rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :CONTINUOUS
                                                :DISCRETE
                                              )
                                  ] ;
              rdfs:subClassOf :SimulationKnowledgeArtifact ;
              rdfs:comment "Nature du temps dans le modèle. Liste fermée."@fr ,
                           "Nature of time in the model. Closed list."@en ;
              rdfs:label "TemporalType"@en .


###  https://w3id.org/ontosim-dis#TransientCourseDiseaseKnowledge
:TransientCourseDiseaseKnowledge rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( :DiseaseKnowledgeTemplate
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasDiseaseCourseShape ;
                                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/OGMS_0000066>
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf :DiseaseKnowledgeTemplate ;
                                 rdfs:comment "A disease whose course can end in a return to normal homeostasis. Allows a transition back to a healthy state."@en ,
                                              "Maladie dont le cours peut se terminer par un retour à l'homéostasie normale. Autorise une transition de retour vers un état sain."@fr ;
                                 rdfs:label "TransientCourseDiseaseKnowledge"@en .


###  https://w3id.org/ontosim-dis#TransitionComponent
:TransitionComponent rdf:type owl:Class ;
                     rdfs:subClassOf :ModelComponent ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasSourceState ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :StateComponent
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasTargetState ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :StateComponent
                                     ] ;
                     rdfs:comment "A passage from one state to another. Has exactly one source state and one target state, whatever the paradigm. A transition to several states is represented by several transitions."@en ,
                                  "Passage d'un état à un autre. Possède exactement un état de départ et un état d'arrivée, quel que soit le paradigme. Une transition vers plusieurs états se représente par plusieurs transitions."@fr ;
                     rdfs:label "TransitionComponent"@en .


###  https://w3id.org/ontosim-dis#TransitionDeterminant
:TransitionDeterminant rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:unionOf ( :IndividualDeterminant
                                                           :PopulationCoupledDeterminant
                                                         )
                                           ] ;
                       rdfs:subClassOf :SimulationKnowledgeArtifact ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :quantifiedBy ;
                                         owl:allValuesFrom :ModelParameter
                                       ] ;
                       <http://purl.obolibrary.org/obo/IAO_0000116> "No equivalent in OSDi. OSDi has no class for what governs a transition: it attaches risk to a clinical progression element through the property hasRiskCharacterization, whose value is a parameter (for instance a relative risk) or a pathway."@en ,
                                                                    "Pas d'équivalent dans OSDi. OSDi n'a pas de classe pour ce qui gouverne une transition : il rattache le risque à un élément de progression clinique par la propriété hasRiskCharacterization, dont la valeur est un paramètre (un risque relatif, par exemple) ou un chemin (Pathway)."@fr ;
                       rdfs:comment "Ce qui gouverne le taux ou la probabilité d'une transition. La distinction entre ses deux sous-classes N'EST PAS médicale mais structurelle : elle dit si le risque d'un individu dépend des autres. C'est elle, et non la taxonomie des maladies, qui détermine la famille de modèles utilisable."@fr ,
                                    "What governs the rate or the probability of a transition. The distinction between its two subclasses is NOT medical but structural: it says whether the risk of one individual depends on the others. It is this distinction, and not the taxonomy of diseases, that determines the family of usable models."@en ;
                       rdfs:label "TransitionDeterminant"@en .


###  https://w3id.org/ontosim-dis#TransitionFlow
:TransitionFlow rdf:type owl:Class ;
                rdfs:subClassOf :TransitionComponent ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasRate ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :RateSpecification
                                ] ;
                rdfs:comment "A passage of individuals from one compartment to another, governed by a rate. Inherits from the layer 2 transition its source and target states."@en ,
                             "Passage d'individus d'un compartiment à un autre, gouverné par un taux. Hérite de la transition de couche 2 ses états de départ et d'arrivée."@fr ;
                rdfs:label "TransitionFlow"@en .


###  https://w3id.org/ontosim-dis#TransmissionReducingIntervention
:TransmissionReducingIntervention rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( :Intervention
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :modifiesDeterminant ;
                                                                               owl:someValuesFrom :PopulationCoupledDeterminant
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf :Intervention ;
                                  rdfs:comment "Classe DÉFINIE : intervention agissant sur un déterminant couplé à la population. N'a de sens que pour une maladie transmissible, puisque réduire les contacts ne change rien lorsque le risque ne dépend que de l'individu."@fr ,
                                               "DEFINED class: an intervention acting on a population-coupled determinant. Only makes sense for a transmissible disease, since reducing contacts changes nothing when the risk depends on the individual alone."@en ;
                                  rdfs:label "TransmissionReducingIntervention"@en .


###  https://w3id.org/ontosim-dis#TransmissionRoute
:TransmissionRoute rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( :AIRBORNE
                                                     :BLOODBORNE
                                                     :DIRECT_CONTACT
                                                     :DROPLET
                                                     :FECAL_ORAL
                                                     :FOODBORNE
                                                     :SEXUAL
                                                     :VECTOR_BORNE
                                                     :VERTICAL
                                                     :WATERBORNE
                                                   )
                                       ] ;
                   rdfs:subClassOf :SimulationKnowledgeArtifact ;
                   rdfs:comment "The biological route by which a communicable disease passes from one host to another. Closed list."@en ,
                                "Voie biologique par laquelle une maladie transmissible passe d'un hôte à un autre. Liste fermée."@fr ;
                   rdfs:label "TransmissionRoute"@en .


###  https://w3id.org/ontosim-dis#Treatment
:Treatment rdf:type owl:Class ;
           rdfs:subClassOf :PharmaceuticalIntervention ;
           rdfs:comment "A drug treatment of affected individuals. Usually acts on an individual determinant: it changes the recovery or the progression of the treated individual."@en ,
                        "Traitement médicamenteux des individus atteints. Agit en général sur un déterminant individuel : il modifie la guérison ou la progression de l'individu traité."@fr ;
           rdfs:label "Treatment"@en .


###  https://w3id.org/ontosim-dis#TropicalClimate
:TropicalClimate rdf:type owl:Class ;
                 rdfs:subClassOf :Climate ;
                 rdfs:comment "Climat chaud et humide, favorable à de nombreux vecteurs."@fr ,
                              "Hot and humid climate, favourable to many vectors."@en ;
                 rdfs:label "TropicalClimate"@en .


###  https://w3id.org/ontosim-dis#UniformDistribution
:UniformDistribution rdf:type owl:Class ;
                     rdfs:subClassOf :ProbabilityDistribution ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :lowerLimitParameter ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:double
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :upperLimitParameter ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:double
                                     ] ;
                     rdfs:comment "Law giving the same weight to every value between two bounds."@en ,
                                  "Loi donnant le même poids à toutes les valeurs entre deux bornes."@fr ;
                     rdfs:label "UniformDistribution"@en ;
                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression> .


###  https://w3id.org/ontosim-dis#UrbanPopulation
:UrbanPopulation rdf:type owl:Class ;
                 rdfs:subClassOf :Population ;
                 rdfs:comment "A population living mainly in a city, with a high density and frequent contacts."@en ,
                              "Population vivant majoritairement en ville, à forte densité et à contacts fréquents."@fr ;
                 rdfs:label "UrbanPopulation"@en .


###  https://w3id.org/ontosim-dis#Vaccination
:Vaccination rdf:type owl:Class ;
             rdfs:subClassOf :PharmaceuticalIntervention ;
             rdfs:comment "A campaign moving individuals from a susceptible state to a protected state."@en ,
                          "Campagne faisant passer des individus d'un état susceptible à un état protégé."@fr ;
             rdfs:label "Vaccination"@en .


###  https://w3id.org/ontosim-dis#VaccinationCentre
:VaccinationCentre rdf:type owl:Class ;
                   rdfs:subClassOf :HealthInfrastructure ;
                   rdfs:comment "Facility dedicated to administering vaccines."@en ,
                                "Structure dédiée à l'administration des vaccins."@fr ;
                   rdfs:label "VaccinationCentre"@en .


###  https://w3id.org/ontosim-dis#ValidationMethod
:ValidationMethod rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( :ADEQUACY
                                                    :CROSS_MODEL
                                                    :HISTORICAL_DATA
                                                    :STATISTICAL
                                                  )
                                      ] ;
                  rdfs:subClassOf :SimulationKnowledgeArtifact ;
                  rdfs:comment "Method by which the model is shown to be fit for its purpose. Closed list."@en ,
                               "Méthode par laquelle on montre que le modèle convient à son objectif. Liste fermée."@fr ;
                  rdfs:label "ValidationMethod"@en .


###  https://w3id.org/ontosim-dis#VectorRole
:VectorRole rdf:type owl:Class ;
            rdfs:subClassOf :EpidemiologicalRole ;
            rdfs:comment "Organism carrying the pathogen from one host to another without suffering the disease."@en ,
                         "Organisme transportant l'agent pathogène d'un hôte à un autre sans subir la maladie."@fr ;
            rdfs:label "VectorRole"@en .


###  https://w3id.org/ontosim-dis#Virus
:Virus rdf:type owl:Class ;
       rdfs:subClassOf :Pathogen ;
       rdfs:comment "Acellular pathogen, which replicates only inside a host cell."@en ,
                    "Agent pathogène acellulaire, qui ne se réplique qu'à l'intérieur d'une cellule hôte."@fr ;
       rdfs:label "Virus"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontosim-dis#ADEQUACY
:ADEQUACY rdf:type owl:NamedIndividual ,
                   :ValidationMethod ;
          rdfs:comment "Qualitative assessment of the model's logic and assumptions."@en ,
                       "Évaluation qualitative de la logique et des hypothèses du modèle."@fr ;
          rdfs:label "Adequacy validation"@en .


###  https://w3id.org/ontosim-dis#AIRBORNE
:AIRBORNE rdf:type owl:NamedIndividual ,
                   :TransmissionRoute ;
          rdfs:comment "Par des particules fines restant en suspension dans l'air."@fr ,
                       "Through fine particles remaining suspended in the air."@en ;
          rdfs:label "Airborne"@en .


###  https://w3id.org/ontosim-dis#BLOODBORNE
:BLOODBORNE rdf:type owl:NamedIndividual ,
                     :TransmissionRoute ;
            rdfs:comment "Par le sang ou des produits sanguins."@fr ,
                         "Through blood or blood products."@en ;
            rdfs:label "Bloodborne"@en .


###  https://w3id.org/ontosim-dis#CONTINUOUS
:CONTINUOUS rdf:type owl:NamedIndividual ,
                     :TemporalType ;
            rdfs:comment "Le temps s'écoule continûment, exemple les équations différentielles."@fr ,
                         """Time flows continuously
 as in differential equations."""@en ;
            rdfs:label "Continuous time"@en .


###  https://w3id.org/ontosim-dis#CROSS_MODEL
:CROSS_MODEL rdf:type owl:NamedIndividual ,
                      :ValidationMethod ;
             rdfs:comment "Comparaison avec un modèle établi du même phénomène."@fr ,
                          "Comparison with an established model of the same phenomenon."@en ;
             rdfs:label "Cross-model validation"@en .


###  https://w3id.org/ontosim-dis#DETERMINISTIC
:DETERMINISTIC rdf:type owl:NamedIndividual ,
                        :ParadigmType ;
               rdfs:comment "Les mêmes entrées donnent toujours les mêmes sorties."@fr ,
                            "Same inputs always give the same outputs."@en ;
               rdfs:label "Deterministic"@en .


###  https://w3id.org/ontosim-dis#DIRECT_CONTACT
:DIRECT_CONTACT rdf:type owl:NamedIndividual ,
                         :TransmissionRoute ;
                rdfs:comment "Par contact physique entre deux hôtes."@fr ,
                             "Through physical contact between two hosts."@en ;
                rdfs:label "Direct contact"@en .


###  https://w3id.org/ontosim-dis#DISCRETE
:DISCRETE rdf:type owl:NamedIndividual ,
                   :TemporalType ;
          rdfs:comment "Le temps avance par pas ou par événements."@fr ,
                       "Time advances by steps or by events."@en ;
          rdfs:label "Discrete time"@en .


###  https://w3id.org/ontosim-dis#DROPLET
:DROPLET rdf:type owl:NamedIndividual ,
                  :TransmissionRoute ;
         rdfs:comment "Par des gouttelettes respiratoires projetées à courte distance."@fr ,
                      "Through respiratory droplets projected over a short distance."@en ;
         rdfs:label "Droplet"@en .


###  https://w3id.org/ontosim-dis#DYNAMICS_RESEARCH
:DYNAMICS_RESEARCH rdf:type owl:NamedIndividual ,
                            :ModelPurpose ;
                   rdfs:comment "Explorer les mécanismes de propagation des maladies, leurs dynamiques et les facteurs qui les influencent. Objectif de compréhension."@fr ,
                                "Exploring disease spread mechanisms, their dynamics and the factors influencing them. An explanatory purpose."@en ;
                   rdfs:label "Dynamics research"@en .


###  https://w3id.org/ontosim-dis#EMPIRICAL
:EMPIRICAL rdf:type owl:NamedIndividual ,
                    :ModelNature ;
           rdfs:comment "Black-box model, describing the system's responses through equations fitted to experimental data, with no scientific principle or dynamic explanation. Its inner workings remain unknown."@en ,
                        "Modèle dit à boîte noire, qui décrit les réponses du système par des équations ajustées sur des données expérimentales, sans intégrer de principe scientifique ni d'explication dynamique. Le fonctionnement interne reste inconnu."@fr ;
           rdfs:label "Empirical"@en .


###  https://w3id.org/ontosim-dis#EPIDEMIC_PLANNING
:EPIDEMIC_PLANNING rdf:type owl:NamedIndividual ,
                            :ModelPurpose ;
                   rdfs:comment "Anticipating and managing potential epidemics by testing interventions and strategies, such as school closures or vaccination campaigns. A predictive purpose."@en ,
                                "Anticiper et gérer des épidémies potentielles en testant des interventions et des stratégies, comme les fermetures d'écoles ou les campagnes de vaccination. Objectif de prédiction."@fr ;
                   rdfs:label "Epidemic planning"@en .


###  https://w3id.org/ontosim-dis#FECAL_ORAL
:FECAL_ORAL rdf:type owl:NamedIndividual ,
                     :TransmissionRoute ;
            rdfs:comment "Par ingestion de matières contaminées par des selles."@fr ,
                         "Through ingestion of matter contaminated by faeces."@en ;
            rdfs:label "Faecal-oral"@en .


###  https://w3id.org/ontosim-dis#FOODBORNE
:FOODBORNE rdf:type owl:NamedIndividual ,
                    :TransmissionRoute ;
           rdfs:comment "Par des aliments contaminés."@fr ,
                        "Through contaminated food."@en ;
           rdfs:label "Foodborne"@en .


###  https://w3id.org/ontosim-dis#GENERAL
:GENERAL rdf:type owl:NamedIndividual ,
                  :ModelScope ;
         rdfs:comment "Model using generic dynamics and adjustable parameters, able to simulate a wide range of diseases sharing similar mechanisms. Needs less data and serves epidemic planning."@en ,
                      "Modèle employant des dynamiques génériques et des paramètres ajustables, qui permet de simuler un large éventail de maladies partageant des mécanismes similaires. Demande moins de données et sert à la planification épidémique."@fr ;
         rdfs:label "General"@en .


###  https://w3id.org/ontosim-dis#GIS
:GIS rdf:type owl:NamedIndividual ,
              :SpatialType ;
     rdfs:comment "L'espace est représenté par des données géographiques réelles."@fr ,
                  "Space is represented by real geographic data."@en ;
     rdfs:label "Geographic information system"@en .


###  https://w3id.org/ontosim-dis#GREY_BOX
:GREY_BOX rdf:type owl:NamedIndividual ,
                   :ModelNature ;
          rdfs:comment "Model mixing a mechanistic part and an empirical part: some subsystems are described by their mechanisms, others by relations fitted to data."@en ,
                       "Modèle mêlant une part mécaniste et une part empirique : certains sous-systèmes sont décrits par leurs mécanismes, d'autres par des relations ajustées sur les données."@fr ;
          rdfs:label "Grey box"@en .


###  https://w3id.org/ontosim-dis#GRID
:GRID rdf:type owl:NamedIndividual ,
               :SpatialType ;
      rdfs:comment "L'espace est représenté par une grille régulière de cellules."@fr ,
                   "Space is represented by a regular grid of cells."@en ;
      rdfs:label "grid"@en .


###  https://w3id.org/ontosim-dis#GROUP
:GROUP rdf:type owl:NamedIndividual ,
                :GranularityLevel ;
       rdfs:comment "Individuals are gathered into homogeneous groups."@en ,
                    "Les individus sont regroupés en groupes homogènes."@fr ;
       rdfs:label "Group"@en .


###  https://w3id.org/ontosim-dis#HISTORICAL_DATA
:HISTORICAL_DATA rdf:type owl:NamedIndividual ,
                          :ValidationMethod ;
                 rdfs:comment "Comparaison des résultats avec des données réelles observées."@fr ,
                              "Comparison of the results with real observed data."@en ;
                 rdfs:label "Historical data validation"@en .


###  https://w3id.org/ontosim-dis#INDIVIDUAL
:INDIVIDUAL rdf:type owl:NamedIndividual ,
                     :GranularityLevel ;
            rdfs:comment "Chaque individu est représenté séparément."@fr ,
                         "Each individual is represented separately."@en ;
            rdfs:label "Individual"@en .


###  https://w3id.org/ontosim-dis#MECHANISTIC
:MECHANISTIC rdf:type owl:NamedIndividual ,
                      :ModelNature ;
             rdfs:comment "Modèle dit à boîte blanche, construit sur la connaissance du fonctionnement du système, de ses éléments et de leurs interactions. Fournit des explications causales, au prix d'une complexité accrue."@fr ,
                          "White-box model, built on knowledge of how the system works, of its elements and their interactions. Yields causal explanations, at the cost of greater complexity."@en ;
             rdfs:label "Mechanistic"@en .


###  https://w3id.org/ontosim-dis#METHODOLOGICAL_RESEARCH
:METHODOLOGICAL_RESEARCH rdf:type owl:NamedIndividual ,
                                  :ModelPurpose ;
                         rdfs:comment "Améliorer les approches de modélisation elles-mêmes, pour les rendre plus efficaces, plus rapides ou plus robustes. Objectif de compréhension."@fr ,
                                      "Improving the modelling approaches themselves, to make them more effective, faster or more robust. An explanatory purpose."@en ;
                         rdfs:label "Methodological research"@en .


###  https://w3id.org/ontosim-dis#MULTISCALE
:MULTISCALE rdf:type owl:NamedIndividual ,
                     :GranularityLevel ;
            rdfs:comment "Plusieurs niveaux de détail coexistent dans le même modèle."@fr ,
                         "Several levels of detail coexist in the same model."@en ;
            rdfs:label "Multiscale"@en .


###  https://w3id.org/ontosim-dis#NETWORK
:NETWORK rdf:type owl:NamedIndividual ,
                  :SpatialType ;
         rdfs:comment "L'espace est représenté par un réseau de contacts ou de connexions."@fr ,
                      "Space is represented by a network of contacts or connections."@en ;
         rdfs:label "Network"@en .


###  https://w3id.org/ontosim-dis#NON_SPATIAL
:NON_SPATIAL rdf:type owl:NamedIndividual ,
                      :SpatialType ;
             rdfs:comment "L'espace n'est pas représenté, la population est supposée bien mélangée."@fr ,
                          "Space is not represented, the population is assumed well mixed."@en ;
             rdfs:label "Non spatial"@en .


###  https://w3id.org/ontosim-dis#REGIONAL
:REGIONAL rdf:type owl:NamedIndividual ,
                   :GranularityLevel ;
          rdfs:comment "L'unité décrite est un territoire."@fr ,
                       "The unit described is a territory."@en ;
          rdfs:label "Regional"@en .


###  https://w3id.org/ontosim-dis#RETROSPECTIVE_ANALYSIS
:RETROSPECTIVE_ANALYSIS rdf:type owl:NamedIndividual ,
                                 :ModelPurpose ;
                        rdfs:comment "Studying a past epidemic to assess how effective the response was and to prepare future interventions. A predictive purpose."@en ,
                                     "Étudier une épidémie passée pour évaluer l'efficacité des réponses et préparer les interventions futures. Objectif de prédiction."@fr ;
                        rdfs:label "Retrospective analysis"@en .


###  https://w3id.org/ontosim-dis#SEXUAL
:SEXUAL rdf:type owl:NamedIndividual ,
                 :TransmissionRoute ;
        rdfs:comment "Par contact sexuel."@fr ,
                     "Through sexual contact."@en ;
        rdfs:label "Sexual"@en .


###  https://w3id.org/ontosim-dis#SPECIFIC
:SPECIFIC rdf:type owl:NamedIndividual ,
                   :ModelScope ;
          rdfs:comment "Model embedding the transmission mechanisms and factors particular to one disease, often in a given context. Needs precise data and serves the assessment of targeted interventions."@en ,
                       "Modèle intégrant les mécanismes de transmission et les facteurs propres à une maladie précise, souvent dans un contexte donné. Demande des données précises et sert à évaluer des interventions ciblées."@fr ;
          rdfs:label "Specific"@en .


###  https://w3id.org/ontosim-dis#STATISTICAL
:STATISTICAL rdf:type owl:NamedIndividual ,
                      :ValidationMethod ;
             rdfs:comment "Statistical test of the agreement between results and reference data."@en ,
                          "Test statistique de l'accord entre les résultats et des données de référence."@fr ;
             rdfs:label "Statistical Validation"@en .


###  https://w3id.org/ontosim-dis#STOCHASTIC
:STOCHASTIC rdf:type owl:NamedIndividual ,
                     :ParadigmType ;
            rdfs:comment "Chance takes part and results vary from one run to another."@en ,
                         "Le hasard intervient et les résultats varient d'une exécution à l'autre."@fr ;
            rdfs:label "Stochastic"@en .


###  https://w3id.org/ontosim-dis#VECTOR_BORNE
:VECTOR_BORNE rdf:type owl:NamedIndividual ,
                       :TransmissionRoute ;
              rdfs:comment "Par un vecteur vivant, le plus souvent un arthropode. Voie du paludisme et de la dengue."@fr ,
                           "Through a living vector, usually an arthropod. Route of malaria and dengue."@en ;
              rdfs:label "Vector-borne"@en .


###  https://w3id.org/ontosim-dis#VERTICAL
:VERTICAL rdf:type owl:NamedIndividual ,
                   :TransmissionRoute ;
          rdfs:comment "De la mère à l'enfant, pendant la grossesse, l'accouchement ou l'allaitement."@fr ,
                       "From mother to child, during pregnancy, birth or breastfeeding."@en ;
          rdfs:label "Vertical"@en .


###  https://w3id.org/ontosim-dis#WATERBORNE
:WATERBORNE rdf:type owl:NamedIndividual ,
                     :TransmissionRoute ;
            rdfs:comment "Par de l'eau contaminée. Voie de la schistosomiase et du choléra."@fr ,
                         "Through contaminated water. Route of schistosomiasis and cholera."@en ;
            rdfs:label "Waterborne"@en .


