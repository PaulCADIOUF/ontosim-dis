                  rdfs:range xsd:integer ;
                  rdfs:comment "Nombre de lits disponibles. Fixe le seuil de saturation."@fr ,
                               "Number of beds available. Sets the saturation threshold."@en ;
                  rdfs:label "hospitalCapacity"@en .


###  https://w3id.org/ontosim-dis#incubationPeriodDays
:incubationPeriodDays rdf:type owl:DatatypeProperty ;
                      rdfs:domain :InfectiousDiseaseKnowledge ;
                      rdfs:range xsd:double ;
                      rdfs:comment "Average time between infection and the first symptoms, in days."@en ,
                                   "Durée moyenne entre l'infection et les premiers symptômes, en jours."@fr ;
                      rdfs:label "incubationPeriodDays"@en .


###  https://w3id.org/ontosim-dis#infectiousPeriodDays
:infectiousPeriodDays rdf:type owl:DatatypeProperty ;
                      rdfs:domain :InfectiousDiseaseKnowledge ;
                      rdfs:range xsd:double ;
                      rdfs:comment "Average duration during which a host can transmit, in days."@en ,
                                   "Durée moyenne pendant laquelle un hôte peut transmettre, en jours."@fr ;
                      rdfs:label "infectiousPeriodDays"@en .


###  https://w3id.org/ontosim-dis#initialAgentCount
:initialAgentCount rdf:type owl:DatatypeProperty ;
                   rdfs:domain :AgentType ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Nombre d'agents de cette catégorie au début de la simulation."@fr ,
                                "Number of agents of this category at the start of the simulation."@en ;
                   rdfs:label "initialAgentCount"@en .


