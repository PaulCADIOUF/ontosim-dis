@prefix : <https://w3id.org/ontosim-dis#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dsim: <https://w3id.org/ontosim-dis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/ontosim-dis#> .

<https://w3id.org/ontosim-dis/layer2> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://w3id.org/ontosim-dis/layer2/1.0> ;
                                       owl:imports <https://w3id.org/ontosim-dis/layer1/1.0> ;
                                       dcterms:created "2026" ;
                                       dcterms:creator "Paul Cheikh Anta DIOUF" ;
                                       dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                       dcterms:source "Couche 1"@fr ;
                                       rdfs:comment """Capa 2: Esta capa responde a la pregunta: ¿Cómo modelamos?
Aquí encontramos los conceptos genéricos de simulación; estos conceptos son comunes a todos los paradigmas de modelado e independientes de cualquier campo médico."""@es ,
                                                    """Couche 2 : cette couche répond à la question « comment modéliser ? ».
Elle rassemble les concepts génériques de simulation, communs à tous les paradigmes de modélisation et indépendants de tout domaine médical."""@fr ,
                                                    """Layer 2: This layer addresses the question of how to model.
It contains generic simulation concepts, concepts that are common to all modeling paradigms and independent of any specific medical field."""@en ;
                                       rdfs:label "OntoSim-Dis Capa 2 - Ontología de simulación"@es ,
                                                  "OntoSim-Dis Couche 2 - Ontologie de modélisation et simulation"@fr ,
                                                  "OntoSim-Dis Layer 2 - Simulation Ontology"@en ;
                                       owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty ;
                obo:IAO_0000116 """
Sens : Indique que deux concepts sont suffisamment proches sur le plan sémantique pour être utilisés de manière interchangeable dans certaines applications de recherche d'information, sans pour autant être rigoureusement identiques.

Non-transitivité : Contrairement à skos:exactMatch, la propriété skos:closeMatch n'est pas transitive pour éviter les erreurs cumulatives lors de chaînages de correspondances multiples.

"""@fr ;
                rdfs:comment "skos:closeMatch est une propriété de liaison dans le standard Simple Knowledge Organization System qui permet d'associer un concept à un autre concept provenant d'un schéma de vocabulaire différent"@fr ;
                rdfs:label "closeMatch"@en .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty ;
                rdfs:comment "skos:exactMatch est une propriété SKOS du W3C utilisée pour relier deux concepts issus de schémas différents, indiquant une forte certitude qu'ils possèdent des significations équivalentes et peuvent être utilisés de manière interchangeable."@fr ;
                rdfs:label "exactMatch"@en .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontosim-dis#appliesExecutionKnowledge
dsim:appliesExecutionKnowledge rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain dsim:SimulationExecution ;
                               rdfs:range dsim:ExecutionKnowledge ;
                               rdfs:comment "Lie un processus d'exécution à la configuration qu'il réalise. Fonctionnelle : une exécution applique une configuration et une seule."@fr ,
                                            "Links an execution process to the configuration it realises. Functional: one execution applies exactly one configuration."@en ;
                               rdfs:label "appliesExecutionKnowledge"@en .


###  https://w3id.org/ontosim-dis#executesModel
dsim:executesModel rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain dsim:SimulationExecution ;
                   rdfs:range dsim:SimulationModel ;
                   rdfs:comment "Lie une exécution au modèle qu'elle fait tourner."@fr ,
                                "Links an execution to the model it runs."@en ;
                   rdfs:label "executesModel"@en .


###  https://w3id.org/ontosim-dis#hasComponent
dsim:hasComponent rdf:type owl:ObjectProperty ;
                  rdfs:domain dsim:ModelStructureKnowledge ;
                  rdfs:range dsim:ModelComponent ;
                  rdfs:comment "Lie une structure de modèle aux composants qu'elle contient."@fr ,
                               "Links a model structure to the components it contains."@en ;
                  rdfs:label "hasComponent"@en .


###  https://w3id.org/ontosim-dis#hasExecutionKnowledge
dsim:hasExecutionKnowledge rdf:type owl:ObjectProperty ;
                           rdfs:domain dsim:SimulationModel ;
                           rdfs:range dsim:ExecutionKnowledge ;
                           rdfs:comment "Lie un modèle aux configurations d'exécution définies pour lui. Non fonctionnelle : un même modèle peut être exécuté sous plusieurs configurations, simulateurs différents ou nombres de répétitions différents."@fr ,
                                        "Links a model to the execution configurations defined for it. Not functional: the same model may be run under several configurations, with different simulators or different run counts."@en ;
                           rdfs:label "hasExecutionKnowledge"@en .


###  https://w3id.org/ontosim-dis#hasGranularityLevel
dsim:hasGranularityLevel rdf:type owl:ObjectProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain dsim:ModelStructureKnowledge ;
                         rdfs:range dsim:GranularityLevel ;
                         rdfs:comment "Lie une structure de modèle à son niveau de détail."@fr ,
                                      "Links a model structure to its level of detail."@en ;
                         rdfs:label "hasGranularityLevel"@en .


###  https://w3id.org/ontosim-dis#hasModelNature
dsim:hasModelNature rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain dsim:SimulationModel ;
                    rdfs:range dsim:ModelNature ;
                    rdfs:comment "Dit si le modèle est mécaniste, empirique ou mixte. Fonctionnelle."@fr ,
                                 "States whether the model is mechanistic, empirical or mixed. Functional."@en ;
                    rdfs:label "hasModelNature"@en .


###  https://w3id.org/ontosim-dis#hasModelPurpose
dsim:hasModelPurpose rdf:type owl:ObjectProperty ;
                     rdfs:domain dsim:SimulationModel ;
                     rdfs:range dsim:ModelPurpose ;
                     rdfs:comment "Lie un modèle aux objectifs pour lesquels il a été construit. Non fonctionnelle, délibérément : un même modèle peut servir à plusieurs choses, par exemple à comprendre une dynamique et à planifier une riposte."@fr ,
                                  "Links a model to the purposes it was built for. Deliberately not functional: the same model may serve several ends, for instance understanding a dynamic and planning a response."@en ;
                     rdfs:label "hasModelPurpose"@en .


###  https://w3id.org/ontosim-dis#hasModelScope
dsim:hasModelScope rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain dsim:SimulationModel ;
                   rdfs:range dsim:ModelScope ;
                   rdfs:comment "Dit si le modèle est général ou spécifique. Fonctionnelle : un modèle est l'un ou l'autre, pas les deux."@fr ,
                                "States whether the model is general or specific. Functional: a model is one or the other, not both."@en ;
                   rdfs:label "hasModelScope"@en .


###  https://w3id.org/ontosim-dis#hasParadigm
dsim:hasParadigm rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain dsim:ModelStructureKnowledge ;
                 rdfs:range dsim:ParadigmType ;
                 rdfs:comment "Lie une structure de modèle à sa nature déterministe ou stochastique."@fr ,
                              "Links a model structure to its deterministic or stochastic nature."@en ;
                 rdfs:label "hasParadigm"@en .


###  https://w3id.org/ontosim-dis#hasParameter
dsim:hasParameter rdf:type owl:ObjectProperty ;
                  rdfs:domain dsim:SimulationModel ;
                  rdfs:range dsim:ModelParameter ;
                  rdfs:comment "Lie un modèle à ses paramètres."@fr ,
                               "Links a model to its parameters."@en ;
                  rdfs:label "hasParameter"@en .


###  https://w3id.org/ontosim-dis#hasSourceState
dsim:hasSourceState rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain dsim:TransitionComponent ;
                    rdfs:range dsim:StateComponent ;
                    rdfs:comment "État de départ d'une transition."@fr ,
                                 "Start state of a transition."@en ;
                    rdfs:label "hasSourceState"@en .


###  https://w3id.org/ontosim-dis#hasSpatialType
dsim:hasSpatialType rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain dsim:ModelStructureKnowledge ;
                    rdfs:range dsim:SpatialType ;
                    rdfs:comment "Lie une structure de modèle à son traitement de l'espace."@fr ,
                                 "Links a model structure to its handling of space."@en ;
                    rdfs:label "hasSpatialType"@en .


###  https://w3id.org/ontosim-dis#hasStructureKnowledge
dsim:hasStructureKnowledge rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain dsim:SimulationModel ;
                           rdfs:range dsim:ModelStructureKnowledge ;
                           rdfs:comment "Lie un modèle à la connaissance décrivant sa structure interne."@fr ,
                                        "Links a model to the knowledge describing its internal structure."@en ;
                           rdfs:label "hasStructureKnowledge"@en .


###  https://w3id.org/ontosim-dis#hasTargetState
dsim:hasTargetState rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain dsim:TransitionComponent ;
                    rdfs:range dsim:StateComponent ;
                    rdfs:comment "End state of a transition."@en ,
                                 "État d'arrivée d'une transition."@fr ;
                    rdfs:label "hasTargetState"@en .


###  https://w3id.org/ontosim-dis#hasTemporalType
dsim:hasTemporalType rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain dsim:ModelStructureKnowledge ;
                     rdfs:range dsim:TemporalType ;
                     rdfs:comment "Lie une structure de modèle à son traitement du temps."@fr ,
                                  "Links a model structure to its handling of time."@en ;
                     rdfs:label "hasTemporalType"@en .


###  https://w3id.org/ontosim-dis#hasUncertaintyDistribution
dsim:hasUncertaintyDistribution rdf:type owl:ObjectProperty ;
                                rdfs:domain dsim:ModelParameter ;
                                rdfs:range dsim:ProbabilityDistribution ;
                                rdfs:comment "Lie un paramètre à la loi de probabilité qui décrit l'incertitude sur sa valeur. C'est ce qui rend possible l'analyse de sensibilité probabiliste : au lieu d'une valeur unique, le paramètre porte la loi dont sa valeur est tirée à chaque répétition de l'exécution."@fr ,
                                             "Links a parameter to the probability law describing the uncertainty on its value. This is what makes probabilistic sensitivity analysis possible: instead of a single value, the parameter carries the law its value is drawn from at each repetition of the run."@en ;
                                rdfs:label "hasUncertaintyDistribution"@en ;
                                skos:closeMatch <https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization> .


###  https://w3id.org/ontosim-dis#hasValidationMethod
dsim:hasValidationMethod rdf:type owl:ObjectProperty ;
                         rdfs:domain dsim:SimulationModel ;
                         rdfs:range dsim:ValidationMethod ;
                         rdfs:comment "Lie un modèle aux méthodes par lesquelles il a été validé."@fr ,
                                      "Links a model to the methods by which it was validated."@en ;
                         rdfs:label "hasValidationMethod"@en .


###  https://w3id.org/ontosim-dis#producesResult
dsim:producesResult rdf:type owl:ObjectProperty ;
                    rdfs:domain dsim:SimulationExecution ;
                    rdfs:range dsim:SimulationResult ;
                    rdfs:comment "Lie une exécution aux données qu'elle produit."@fr ,
                                 "Links an execution to the data it produces."@en ;
                    rdfs:label "producesResult"@en .


###  https://w3id.org/ontosim-dis#usesScenario
dsim:usesScenario rdf:type owl:ObjectProperty ;
                  rdfs:domain dsim:SimulationModel ;
                  rdfs:range dsim:SimulationScenario ;
                  rdfs:comment "Lie un modèle aux scénarios sous lesquels il est exécuté."@fr ,
                               "Links a model to the scenarios under which it is run."@en ;
                  rdfs:label "usesScenario"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontosim-dis#alphaParameter
dsim:alphaParameter rdf:type owl:DatatypeProperty ;
                    rdfs:domain dsim:ProbabilityDistribution ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Paramètre de forme d'une loi bêta ou gamma."@fr ,
                                 "Shape parameter of a beta or gamma law."@en ;
                    rdfs:label "alphaParameter"@en .


###  https://w3id.org/ontosim-dis#betaParameter
dsim:betaParameter rdf:type owl:DatatypeProperty ;
                   rdfs:domain dsim:ProbabilityDistribution ;
                   rdfs:range xsd:double ;
                   rdfs:comment "Second paramètre de forme d'une loi bêta."@fr ,
                                "Second shape parameter of a beta law."@en ;
                   rdfs:label "betaParameter"@en .


###  https://w3id.org/ontosim-dis#creationDate
dsim:creationDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain dsim:SimulationModel ;
                  rdfs:range xsd:dateTime ;
                  rdfs:comment "Date de création du modèle."@fr ,
                               "Date the model was created."@en ;
                  rdfs:label "creationDate"@en .


###  https://w3id.org/ontosim-dis#defaultValue
dsim:defaultValue rdf:type owl:DatatypeProperty ;
                  rdfs:domain dsim:ModelParameter ;
                  rdfs:range xsd:double ;
                  rdfs:comment "Valeur utilisée lorsqu'aucune n'est fournie."@fr ,
                               "Value used when none is supplied."@en ;
                  rdfs:label "defaultValue"@en .


###  https://w3id.org/ontosim-dis#endDate
dsim:endDate rdf:type owl:DatatypeProperty ;
             rdfs:domain dsim:SimulationScenario ;
             rdfs:range xsd:dateTime ;
             rdfs:comment "Date de fin du scénario."@fr ,
                          "End date of the scenario."@en ;
             rdfs:label "endDate"@en .


###  https://w3id.org/ontosim-dis#executionStatus
dsim:executionStatus rdf:type owl:DatatypeProperty ;
                     rdfs:domain dsim:SimulationExecution ;
                     rdfs:range xsd:string ;
                     rdfs:comment "État de l'exécution : en attente, en cours, terminée, échouée."@fr ,
                                  "State of the execution: pending, running, completed, failed."@en ;
                     rdfs:label "executionStatus"@en .


###  https://w3id.org/ontosim-dis#hasAuthor
dsim:hasAuthor rdf:type owl:DatatypeProperty ;
               rdfs:domain dsim:SimulationModel ;
               rdfs:range xsd:string ;
               rdfs:comment "Le nom de l'auteur du modèle est sous forme de texte et non en classe. "@fr ,
                            "The model author's name is stored as text rather than as a class."@en ;
               rdfs:label "hasAuthor"@en ;
               skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#hasAuthor> .


###  https://w3id.org/ontosim-dis#lambdaParameter
dsim:lambdaParameter rdf:type owl:DatatypeProperty ;
                     rdfs:domain dsim:ProbabilityDistribution ;
                     rdfs:range xsd:double ;
                     rdfs:comment "Paramètre de taux d'une loi exponentielle, gamma ou de Poisson."@fr ,
                                  "Rate parameter of an exponential, gamma or Poisson law."@en ;
                     rdfs:label "lambdaParameter"@en .


###  https://w3id.org/ontosim-dis#lowerLimitParameter
dsim:lowerLimitParameter rdf:type owl:DatatypeProperty ;
                         rdfs:domain dsim:ProbabilityDistribution ;
                         rdfs:range xsd:double ;
                         rdfs:comment "Borne inférieure d'une loi uniforme."@fr ,
                                      "Lower bound of a uniform law."@en ;
                         rdfs:label "lowerLimitParameter"@en .


###  https://w3id.org/ontosim-dis#meanParameter
dsim:meanParameter rdf:type owl:DatatypeProperty ;
                   rdfs:domain dsim:ProbabilityDistribution ;
                   rdfs:range xsd:double ;
                   rdfs:comment "Mean of a normal law."@en ,
                                "Moyenne d'une loi normale."@fr ;
                   rdfs:label "meanParameter"@en .


###  https://w3id.org/ontosim-dis#modelDescription
dsim:modelDescription rdf:type owl:DatatypeProperty ;
                      rdfs:domain dsim:SimulationModel ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Description libre du modèle."@fr ,
                                   "Free-text description of the model."@en ;
                      rdfs:label "modelDescription"@en .


###  https://w3id.org/ontosim-dis#modelName
dsim:modelName rdf:type owl:DatatypeProperty ;
               rdfs:domain dsim:SimulationModel ;
               rdfs:range xsd:string ;
               rdfs:comment "Name of the model."@en ,
                            "Nom du modèle"@fr ;
               rdfs:label "modelName"@en .


###  https://w3id.org/ontosim-dis#modelVersion
dsim:modelVersion rdf:type owl:DatatypeProperty ;
                  rdfs:domain dsim:SimulationModel ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Version du modèle."@fr ,
                               "Version of the model."@en ;
                  rdfs:label "modelVersion"@en .


###  https://w3id.org/ontosim-dis#numberOfRuns
dsim:numberOfRuns rdf:type owl:DatatypeProperty ;
                  rdfs:domain dsim:ExecutionKnowledge ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Nombre de répétitions de l'exécution, utile pour les modèles stochastiques."@fr ,
                               "Number of repetitions of the execution, useful for stochastic models."@en ;
                  rdfs:label "numberOfRuns"@en .


###  https://w3id.org/ontosim-dis#parameterName
dsim:parameterName rdf:type owl:DatatypeProperty ;
                   rdfs:domain dsim:ModelParameter ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Name of the parameter, for instance beta."@en ,
                                "Nom du paramètre, par exemple beta."@fr ;
                   rdfs:label "parameterName"@en .


###  https://w3id.org/ontosim-dis#parameterUnit
dsim:parameterUnit rdf:type owl:DatatypeProperty ;
                   rdfs:domain dsim:ModelParameter ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Unit of the parameter, for instance day^-1."@en ,
                                "Unité du paramètre, par exemple jour^-1."@fr ;
                   rdfs:label "parameterUnit"@en .


###  https://w3id.org/ontosim-dis#parameterValue
dsim:parameterValue rdf:type owl:DatatypeProperty ;
                    rdfs:domain dsim:ModelParameter ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Numeric value of the parameter."@en ,
                                 "Valeur numérique du paramètre."@fr ;
                    rdfs:label "parameterValue"@en .


###  https://w3id.org/ontosim-dis#probabilityParameter
dsim:probabilityParameter rdf:type owl:DatatypeProperty ;
                          rdfs:domain dsim:ProbabilityDistribution ;
                          rdfs:range xsd:double ;
                          rdfs:comment "Probabilité de succès d'une loi de Bernoulli, entre 0 et 1."@fr ,
                                       "Probability of success of a Bernoulli law, between 0 and 1."@en ;
                          rdfs:label "probabilityParameter"@en .


###  https://w3id.org/ontosim-dis#randomSeed
dsim:randomSeed rdf:type owl:DatatypeProperty ;
                rdfs:domain dsim:ExecutionKnowledge ;
                rdfs:range xsd:integer ;
                rdfs:comment "Graine du générateur aléatoire, nécessaire pour reproduire une exécution stochastique."@fr ,
                             "Seed of the random generator, needed to reproduce a stochastic run."@en ;
                rdfs:label "randomSeed"@en .


###  https://w3id.org/ontosim-dis#scenarioDurationInDays
dsim:scenarioDurationInDays rdf:type owl:DatatypeProperty ;
                            rdfs:domain dsim:SimulationScenario ;
                            rdfs:range xsd:double ;
                            rdfs:comment "Duration covered by the scenario in days"@en ,
                                         "Durée couverte par le scénario en jours"@fr ;
                            rdfs:label "scenarioDurationInDays"@en .


###  https://w3id.org/ontosim-dis#simulationDurationInDays
dsim:simulationDurationInDays rdf:type owl:DatatypeProperty ;
                              rdfs:domain dsim:ModelStructureKnowledge ;
                              rdfs:range xsd:double ;
                              rdfs:comment "Durée totale simulée en jours"@fr ,
                                           "Total simulated duration in days"@en ;
                              rdfs:label "simulationDurationInDays"@en .


###  https://w3id.org/ontosim-dis#simulatorName
dsim:simulatorName rdf:type owl:DatatypeProperty ;
                   rdfs:domain dsim:ExecutionKnowledge ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Name of the simulator used, for instance JaDES, GAMA, NetLogo."@en ,
                                "Nom du simulateur employé, par exemple JaDES, GAMA, NetLogo."@fr ;
                   rdfs:label "simulatorName"@en .


###  https://w3id.org/ontosim-dis#simulatorVersion
dsim:simulatorVersion rdf:type owl:DatatypeProperty ;
                      rdfs:domain dsim:ExecutionKnowledge ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Version du simulateur employé."@fr ,
                                   "Version of the simulator used."@en ;
                      rdfs:label "simulatorVersion"@en .


###  https://w3id.org/ontosim-dis#standardDeviationParameter
dsim:standardDeviationParameter rdf:type owl:DatatypeProperty ;
                                rdfs:domain dsim:ProbabilityDistribution ;
                                rdfs:range xsd:double ;
                                rdfs:comment "Écart type d'une loi normale"@fr ,
                                             "Standard deviation of a normal law."@en ;
                                rdfs:label "standardDeviationParameter"@en .


###  https://w3id.org/ontosim-dis#startDate
dsim:startDate rdf:type owl:DatatypeProperty ;
               rdfs:domain dsim:SimulationScenario ;
               rdfs:range xsd:dateTime ;
               rdfs:comment "Date de début du scénario."@fr ,
                            "Start date of the scenario."@en ;
               rdfs:label "startDate"@en .


###  https://w3id.org/ontosim-dis#timeStepInDays
dsim:timeStepInDays rdf:type owl:DatatypeProperty ;
                    rdfs:domain dsim:ModelStructureKnowledge ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Duration of one simulation step in days"@en ,
                                 "Durée d'un pas de simulation en jours"@fr ;
                    rdfs:label "timeStepInDays"@en .


###  https://w3id.org/ontosim-dis#upperLimitParameter
dsim:upperLimitParameter rdf:type owl:DatatypeProperty ;
                         rdfs:domain dsim:ProbabilityDistribution ;
                         rdfs:range xsd:double ;
                         rdfs:comment "Borne supérieure d'une loi uniforme."@fr ,
                                      "Upper bound of a uniform law."@en ;
                         rdfs:label "upperLimitParameter"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontosim-dis#BernoulliDistribution
dsim:BernoulliDistribution rdf:type owl:Class ;
                           rdfs:subClassOf dsim:ProbabilityDistribution ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty dsim:probabilityParameter ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:double
                                           ] ;
                           rdfs:comment "Law of a single trial with two outcomes, of given probability."@en ,
                                        "Loi d'un tirage unique à deux issues de probabilité donnée."@fr ;
                           rdfs:label "BernoulliDistribution"@en ;
                           skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression> .


###  https://w3id.org/ontosim-dis#BetaDistribution
dsim:BetaDistribution rdf:type owl:Class ;
                      rdfs:subClassOf dsim:ProbabilityDistribution ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty dsim:alphaParameter ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:double
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty dsim:betaParameter ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:double
                                      ] ;
                      rdfs:comment "Law on the interval zero to one, used for proportions and probabilities."@en ,
                                   "Loi sur l'intervalle de zéro à un, employée pour les proportions et les probabilités."@fr ;
                      rdfs:label "BetaDistribution"@en ;
                      skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression> .


###  https://w3id.org/ontosim-dis#DynamicParameter
dsim:DynamicParameter rdf:type owl:Class ;
                      rdfs:subClassOf dsim:ModelParameter ;
                      owl:disjointWith dsim:StaticParameter ;
                      rdfs:comment "A parameter whose value varies with time, for instance a time-dependent transmission rate."@en ,
                                   "Paramètre dont la valeur varie dans le temps, par exemple un taux de transmission dépendant du temps."@fr ;
                      rdfs:label "DynamicParameter"@en .


###  https://w3id.org/ontosim-dis#EnvironmentComponent
dsim:EnvironmentComponent rdf:type owl:Class ;
                          rdfs:subClassOf dsim:ModelComponent ;
                          rdfs:comment "An external or contextual factor influencing the modelled system: weather, terrain, infrastructure."@en ,
                                       "Facteur externe ou contextuel influençant le système modélisé : météo, relief, infrastructure."@fr ;
                          rdfs:label "EnvironmentComponent"@en .


###  https://w3id.org/ontosim-dis#ExecutionKnowledge
dsim:ExecutionKnowledge rdf:type owl:Class ;
                        rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                        rdfs:comment "Comment exécuter le modèle : quel simulateur, combien de répétitions, avec quelle graine aléatoire. Quatrième composant du Quadruplet, à côté de la connaissance de la maladie, du contexte et de la structure. Ce n'est pas l'exécution elle-même, qui est un processus, mais la configuration que cette exécution réalise."@fr ,
                                     "How to run the model: which simulator, how many runs, with which random seed. Fourth component of the Quadruplet, alongside disease, context and structure knowledge. It is not the execution itself, which is a process, but the configuration that execution realises."@en ;
                        rdfs:label "ExecutionKnowledge"@en .


###  https://w3id.org/ontosim-dis#ExponentialDistribution
dsim:ExponentialDistribution rdf:type owl:Class ;
                             rdfs:subClassOf dsim:ProbabilityDistribution ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dsim:lambdaParameter ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:double
                                             ] ;
                             rdfs:comment "Law of the time between two events occurring at a constant rate."@en ,
                                          "Loi du temps séparant deux événements survenant à taux constant."@fr ;
                             rdfs:label "ExponentialDistribution"@en ;
                             skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#ExponentialDistributionExpression> .


###  https://w3id.org/ontosim-dis#GammaDistribution
dsim:GammaDistribution rdf:type owl:Class ;
                       rdfs:subClassOf dsim:ProbabilityDistribution ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty dsim:alphaParameter ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:double
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty dsim:lambdaParameter ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:double
                                       ] ;
                       rdfs:comment "Law on positive values, used for costs and durations."@en ,
                                    "Loi sur les valeurs positives, employée pour les coûts et les durées."@fr ;
                       rdfs:label "GammaDistribution"@en ;
                       skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression> .


###  https://w3id.org/ontosim-dis#GranularityLevel
dsim:GranularityLevel rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( dsim:GROUP
                                                        dsim:INDIVIDUAL
                                                        dsim:MULTISCALE
                                                        dsim:REGIONAL
                                                      )
                                          ] ;
                      rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                      rdfs:comment "Level of detail at which the modelled entities are described. Closed list."@en ,
                                   "Niveau de détail auquel les entités modélisées sont décrites. Liste fermée."@fr ;
                      rdfs:label "GranularityLevel"@en .


###  https://w3id.org/ontosim-dis#InitialCondition
dsim:InitialCondition rdf:type owl:Class ;
                      rdfs:subClassOf dsim:ModelParameter ;
                      rdfs:comment "A parameter giving the value of a quantity at the start of the simulation."@en ,
                                   "Paramètre donnant la valeur d'une grandeur au début de la simulation."@fr ;
                      rdfs:label "InitialCondition"@en .


###  https://w3id.org/ontosim-dis#InterventionScenario
dsim:InterventionScenario rdf:type owl:Class ;
                          rdfs:subClassOf dsim:SimulationScenario ;
                          rdfs:comment "A scenario in which one or more interventions are applied: vaccination, treatment, control measure."@en ,
                                       "Scénario dans lequel une ou plusieurs interventions sont appliquées : vaccination, traitement, mesure de contrôle."@fr ;
                          rdfs:label "InterventionScenario"@en ;
                          skos:closeMatch <https://w3id.org/ontologies-ULL/OSDi#Intervention> .


###  https://w3id.org/ontosim-dis#ModelComponent
dsim:ModelComponent rdf:type owl:Class ;
                    rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                    rdfs:comment "A constituent part of the structure of a model."@en ,
                                 "Partie constitutive de la structure d'un modèle."@fr ;
                    rdfs:label "ModelComponent"@en .


###  https://w3id.org/ontosim-dis#ModelNature
dsim:ModelNature rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( dsim:EMPIRICAL
                                                   dsim:GREY_BOX
                                                   dsim:MECHANISTIC
                                                 )
                                     ] ;
                 rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                 rdfs:comment "Dit si le modèle explique les mécanismes ou se contente de reproduire les observations. Liste fermée. Ce critère décide de ce qui est recomposable : on ne recompose pas une boîte noire comme un modèle à mécanismes."@fr ,
                              "States whether the model explains mechanisms or merely reproduces observations. Closed list. This criterion decides what can be recomposed: a black box is not recomposed the way a mechanistic model is."@en ;
                 rdfs:label "ModelNature"@en .


###  https://w3id.org/ontosim-dis#ModelParameter
dsim:ModelParameter rdf:type owl:Class ;
                    rdfs:subClassOf dsim:ModelComponent ;
                    rdfs:comment "A named quantity whose value settles part of the behaviour of the model. Merges the former ParameterComponent and ModelParameter."@en ,
                                 "Grandeur nommée dont la valeur fixe une partie du comportement du modèle. Fusionne les anciennes classes ParameterComponent et ModelParameter."@fr ;
                    rdfs:label "ModelParameter"@en ;
                    skos:closeMatch <https://w3id.org/ontologies-ULL/OSDi#Parameter> .


###  https://w3id.org/ontosim-dis#ModelPurpose
dsim:ModelPurpose rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( dsim:DYNAMICS_RESEARCH
                                                    dsim:EPIDEMIC_PLANNING
                                                    dsim:METHODOLOGICAL_RESEARCH
                                                    dsim:RETROSPECTIVE_ANALYSIS
                                                  )
                                      ] ;
                  rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                  rdfs:comment "Objectif pour lequel le modèle a été construit. Liste fermée. Connaître l'objectif permet de juger si un modèle convient à une situation donnée, et d'identifier les caractéristiques qu'il doit réunir."@fr ,
                               "Purpose the model was built for. Closed list. Knowing the purpose is what lets one judge whether a model fits a given situation, and identify the features it must combine."@en ;
                  rdfs:label "ModelPurpose"@en .


###  https://w3id.org/ontosim-dis#ModelScope
dsim:ModelScope rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( dsim:GENERAL
                                                  dsim:SPECIFIC
                                                )
                                    ] ;
                rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                rdfs:comment "Dit si le modèle est réglable pour plusieurs maladies ou construit pour une seule. Liste fermée. C'est le critère qui décide si un modèle est réutilisable ailleurs."@fr ,
                             "States whether the model can be retuned for several diseases or was built for one. Closed list. This is the criterion that decides whether a model is reusable elsewhere."@en ;
                rdfs:label "ModelScope"@en .


###  https://w3id.org/ontosim-dis#ModelStructureKnowledge
dsim:ModelStructureKnowledge rdf:type owl:Class ;
                             rdfs:subClassOf dsim:SimulationKnowledgeArtifact ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dsim:hasComponent ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass dsim:ModelComponent
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dsim:hasGranularityLevel ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass dsim:GranularityLevel
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dsim:hasParadigm ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass dsim:ParadigmType
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dsim:hasSpatialType ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass dsim:SpatialType
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dsim:hasTemporalType ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass dsim:TemporalType
                                             ] ;
                             rdfs:comment "Connaissance décrivant la structure interne d'un modèle : ses composants, et ses choix de traitement du hasard (déterministe ou stochastique), de temps, d'espace et de granularité. Composant MSK du Quadruplet de recomposition."@fr ,
                                          "Knowledge describing the internal structure of a model: its components, and its choices of handling of chance (deterministic or stochastic), time, space and granularity. MSK component of the recomposition Quadruplet."@en ;
                             rdfs:label "ModelStructureKnowledge"@en .


###  https://w3id.org/ontosim-dis#NormalDistribution
dsim:NormalDistribution rdf:type owl:Class ;
                        rdfs:subClassOf dsim:ProbabilityDistribution ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty dsim:meanParameter ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:double
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty dsim:standardDeviationParameter ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:double
                                        ] ;
                        rdfs:comment "Loi symétrique caractérisée par une moyenne et un écart type."@fr ,
                                     "Symmetric law characterised by a mean and a standard deviation."@en ;
                        rdfs:label "NormalDistribution"@en ;
                        skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#NormalDistributionExpression> .


###  https://w3id.org/ontosim-dis#ParadigmType
dsim:ParadigmType rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( dsim:DETERMINISTIC
                                                    dsim:STOCHASTIC
                                                  )
                                      ] ;
                  rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                  rdfs:comment "Nature du traitement du hasard par le modèle : déterministe ou stochastique. Liste fermée. Malgré son nom, cette classe ne désigne pas le paradigme de modélisation au sens des couches 3A et 3B (agents, compartiments) : un modèle à compartiments peut être déterministe ou stochastique."@fr ,
                               "Nature of the model's handling of chance: deterministic or stochastic. Closed list. Despite its name, this class does not denote the modelling paradigm in the sense of layers 3A and 3B (agents, compartments): a compartmental model may be deterministic or stochastic."@en ;
                  rdfs:label "ParadigmType"@en .


###  https://w3id.org/ontosim-dis#PoissonDistribution
dsim:PoissonDistribution rdf:type owl:Class ;
                         rdfs:subClassOf dsim:ProbabilityDistribution ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:lambdaParameter ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:double
                                         ] ;
                         rdfs:comment "Law of the number of events occurring in a fixed interval."@en ,
                                      "Loi du nombre d'événements survenant dans un intervalle fixe."@fr ;
                         rdfs:label "PoissonDistribution"@en ;
                         skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#PoissonDistributionExpression> .


###  https://w3id.org/ontosim-dis#ProbabilityDistribution
dsim:ProbabilityDistribution rdf:type owl:Class ;
                             rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                             rdfs:comment "A probability law characterising the uncertainty of a parameter, or the random draw of a value."@en ,
                                          "Loi de probabilité caractérisant l'incertitude d'un paramètre, ou le tirage aléatoire d'une valeur."@fr ;
                             rdfs:label "ProbabilityDistribution"@en ;
                             skos:closeMatch <https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression> .


###  https://w3id.org/ontosim-dis#RuleComponent
dsim:RuleComponent rdf:type owl:Class ;
                   rdfs:subClassOf dsim:ModelComponent ;
                   rdfs:comment "A rule governing the behaviour of the model: decision rule, behaviour rule, interaction rule."@en ,
                                "Règle gouvernant le comportement du modèle : règle de décision, de comportement, d'interaction."@fr ;
                   rdfs:label "RuleComponent"@en .


###  https://w3id.org/ontosim-dis#SimulationExecution
dsim:SimulationExecution rdf:type owl:Class ;
                         rdfs:subClassOf obo:BFO_0000015 ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:appliesExecutionKnowledge ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass dsim:ExecutionKnowledge
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:executesModel ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass dsim:SimulationModel
                                         ] ;
                         rdfs:comment """Ceci représente le processus d'exécution d'un modèle de simulation sur un simulateur.
Ce n'est pas un artefact d'information mais un processus car il se déroule dans le temps."""@fr ,
                                      """This represents the process of executing a simulation model on a simulator.
It is not an information artifact but a process, because it unfolds over time."""@en ;
                         rdfs:label "SimulationExecution"@en .


###  https://w3id.org/ontosim-dis#SimulationKnowledgeArtifact
dsim:SimulationKnowledgeArtifact rdf:type owl:Class ;
                                 rdfs:subClassOf obo:IAO_0000030 ;
                                 rdfs:comment "Artefact d'information portant une connaissance utilisée pour construire, décrire ou exécuter un modèle de simulation."@fr ,
                                              "Information artifact carrying knowledge used to build, describe, or execute a simulation model."@en ;
                                 rdfs:label "SimulationKnowledgeArtifact"@en .


###  https://w3id.org/ontosim-dis#SimulationModel
dsim:SimulationModel rdf:type owl:Class ;
                     rdfs:subClassOf dsim:SimulationKnowledgeArtifact ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty dsim:hasParameter ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass dsim:ModelParameter
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty dsim:hasValidationMethod ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass dsim:ValidationMethod
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty dsim:usesScenario ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass dsim:SimulationScenario
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty dsim:hasStructureKnowledge ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass dsim:ModelStructureKnowledge
                                     ] ;
                     rdfs:comment "A representation of a system whose behaviour is studied by simulation, independently of the paradigm used."@en ,
                                  "Représentation d'un système dont on étudie le comportement par simulation, indépendamment du paradigme employé."@fr ;
                     rdfs:label "SimulationModel"@en ;
                     skos:closeMatch <https://w3id.org/ontologies-ULL/OSDi#Model> .


###  https://w3id.org/ontosim-dis#SimulationObservation
dsim:SimulationObservation rdf:type owl:Class ;
                           rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                           rdfs:comment "Données réelles observées, servant à valider un modèle par comparaison avec ses résultats."@fr ,
                                        "Real observed data, used to validate a model by comparison with its results."@en ;
                           rdfs:label "SimulationObservation"@en .


###  https://w3id.org/ontosim-dis#SimulationResult
dsim:SimulationResult rdf:type owl:Class ;
                      rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                      rdfs:comment "Data produced by a simulation execution."@en ,
                                   "Données produites par une exécution de simulation."@fr ;
                      rdfs:label "SimulationResult"@en .


###  https://w3id.org/ontosim-dis#SimulationScenario
dsim:SimulationScenario rdf:type owl:Class ;
                        rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                        rdfs:comment "A set of hypotheses and settings under which a model is run."@en ,
                                     "Ensemble d'hypothèses et de réglages sous lesquels un modèle est exécuté."@fr ;
                        rdfs:label "SimulationScenario"@en .


###  https://w3id.org/ontosim-dis#SpatialType
dsim:SpatialType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( dsim:GIS
                                                   dsim:GRID
                                                   dsim:NETWORK
                                                   dsim:NON_SPATIAL
                                                 )
                                     ] ;
                 rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                 rdfs:comment "Façon dont l'espace est représenté dans le modèle. Liste fermée."@fr ,
                              "Way space is represented in the model. Closed list."@en ;
                 rdfs:label "SpatialType"@en .


###  https://w3id.org/ontosim-dis#StateComponent
dsim:StateComponent rdf:type owl:Class ;
                    rdfs:subClassOf dsim:ModelComponent ;
                    rdfs:comment "A state that an entity of the model can occupy at a given time. Specialised as a compartment in compartmental models [C3B] and as an agent state in agent-based models [C3A]."@en ,
                                 "État qu'une entité du modèle peut occuper à un instant donné. Se spécialise en compartiment pour les modèles compartimentaux [C3B] et en état d'agent pour les modèles à agents [C3A]."@fr ;
                    rdfs:label "StateComponent"@en .


###  https://w3id.org/ontosim-dis#StaticParameter
dsim:StaticParameter rdf:type owl:Class ;
                     rdfs:subClassOf dsim:ModelParameter ;
                     rdfs:comment "A parameter whose value does not change during the simulation."@en ,
                                  "Paramètre dont la valeur ne change pas au cours de la simulation."@fr ;
                     rdfs:label "StaticParameter"@en .


###  https://w3id.org/ontosim-dis#TemporalType
dsim:TemporalType rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( dsim:CONTINUOUS
                                                    dsim:DISCRETE
                                                  )
                                      ] ;
                  rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                  rdfs:comment "Nature du temps dans le modèle. Liste fermée."@fr ,
                               "Nature of time in the model. Closed list."@en ;
                  rdfs:label "TemporalType"@en .


###  https://w3id.org/ontosim-dis#TransitionComponent
dsim:TransitionComponent rdf:type owl:Class ;
                         rdfs:subClassOf dsim:ModelComponent ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:hasSourceState ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass dsim:StateComponent
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:hasTargetState ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass dsim:StateComponent
                                         ] ;
                         rdfs:comment "A passage from one state to another. Has exactly one source state and one target state, whatever the paradigm. A transition to several states is represented by several transitions."@en ,
                                      "Passage d'un état à un autre. Possède exactement un état de départ et un état d'arrivée, quel que soit le paradigme. Une transition vers plusieurs états se représente par plusieurs transitions."@fr ;
                         rdfs:label "TransitionComponent"@en .


###  https://w3id.org/ontosim-dis#UniformDistribution
dsim:UniformDistribution rdf:type owl:Class ;
                         rdfs:subClassOf dsim:ProbabilityDistribution ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:lowerLimitParameter ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:double
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty dsim:upperLimitParameter ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:double
                                         ] ;
                         rdfs:comment "Law giving the same weight to every value between two bounds."@en ,
                                      "Loi donnant le même poids à toutes les valeurs entre deux bornes."@fr ;
                         rdfs:label "UniformDistribution"@en ;
                         skos:exactMatch <https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression> .


###  https://w3id.org/ontosim-dis#ValidationMethod
dsim:ValidationMethod rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( dsim:ADEQUACY
                                                        dsim:CROSS_MODEL
                                                        dsim:HISTORICAL_DATA
                                                        dsim:STATISTICAL
                                                      )
                                          ] ;
                      rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                      rdfs:comment "Method by which the model is shown to be fit for its purpose. Closed list."@en ,
                                   "Méthode par laquelle on montre que le modèle convient à son objectif. Liste fermée."@fr ;
                      rdfs:label "ValidationMethod"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/ontosim-dis#ADEQUACY
dsim:ADEQUACY rdf:type owl:NamedIndividual ,
                       dsim:ValidationMethod ;
              rdfs:comment "Évaluation qualitative de la logique et des hypothèses du modèle."@fr ,
                           "Qualitative assessment of the model's logic and assumptions."@en ;
              rdfs:label "Adequacy validation"@en .


###  https://w3id.org/ontosim-dis#CONTINUOUS
dsim:CONTINUOUS rdf:type owl:NamedIndividual ,
                         dsim:TemporalType ;
                rdfs:comment "Le temps s'écoule continûment, exemple les équations différentielles."@fr ,
                             """Time flows continuously
 as in differential equations."""@en ;
                rdfs:label "Continuous time"@en .


###  https://w3id.org/ontosim-dis#CROSS_MODEL
dsim:CROSS_MODEL rdf:type owl:NamedIndividual ,
                          dsim:ValidationMethod ;
                 rdfs:comment "Comparaison avec un modèle établi du même phénomène."@fr ,
                              "Comparison with an established model of the same phenomenon."@en ;
                 rdfs:label "Cross-model validation"@en .


###  https://w3id.org/ontosim-dis#DETERMINISTIC
dsim:DETERMINISTIC rdf:type owl:NamedIndividual ,
                            dsim:ParadigmType ;
                   rdfs:comment "Les mêmes entrées donnent toujours les mêmes sorties."@fr ,
                                "Same inputs always give the same outputs."@en ;
                   rdfs:label "Deterministic"@en .


###  https://w3id.org/ontosim-dis#DISCRETE
dsim:DISCRETE rdf:type owl:NamedIndividual ,
                       dsim:TemporalType ;
              rdfs:comment "Le temps avance par pas ou par événements."@fr ,
                           "Time advances by steps or by events."@en ;
              rdfs:label "Discrete time"@en .


###  https://w3id.org/ontosim-dis#DYNAMICS_RESEARCH
dsim:DYNAMICS_RESEARCH rdf:type owl:NamedIndividual ,
                                dsim:ModelPurpose ;
                       rdfs:comment "Explorer les mécanismes de propagation des maladies, leurs dynamiques et les facteurs qui les influencent. Objectif de compréhension."@fr ,
                                    "Exploring disease spread mechanisms, their dynamics and the factors influencing them. An explanatory purpose."@en ;
                       rdfs:label "Dynamics research"@en .


###  https://w3id.org/ontosim-dis#EMPIRICAL
dsim:EMPIRICAL rdf:type owl:NamedIndividual ,
                        dsim:ModelNature ;
               rdfs:comment "Black-box model, describing the system's responses through equations fitted to experimental data, with no scientific principle or dynamic explanation. Its inner workings remain unknown."@en ,
                            "Modèle dit à boîte noire, qui décrit les réponses du système par des équations ajustées sur des données expérimentales, sans intégrer de principe scientifique ni d'explication dynamique. Le fonctionnement interne reste inconnu."@fr ;
               rdfs:label "Empirical"@en .


###  https://w3id.org/ontosim-dis#EPIDEMIC_PLANNING
dsim:EPIDEMIC_PLANNING rdf:type owl:NamedIndividual ,
                                dsim:ModelPurpose ;
                       rdfs:comment "Anticipating and managing potential epidemics by testing interventions and strategies, such as school closures or vaccination campaigns. A predictive purpose."@en ,
                                    "Anticiper et gérer des épidémies potentielles en testant des interventions et des stratégies, comme les fermetures d'écoles ou les campagnes de vaccination. Objectif de prédiction."@fr ;
                       rdfs:label "Epidemic planning"@en .


###  https://w3id.org/ontosim-dis#GENERAL
dsim:GENERAL rdf:type owl:NamedIndividual ,
                      dsim:ModelScope ;
             rdfs:comment "Model using generic dynamics and adjustable parameters, able to simulate a wide range of diseases sharing similar mechanisms. Needs less data and serves epidemic planning."@en ,
                          "Modèle employant des dynamiques génériques et des paramètres ajustables, qui permet de simuler un large éventail de maladies partageant des mécanismes similaires. Demande moins de données et sert à la planification épidémique."@fr ;
             rdfs:label "General"@en .


###  https://w3id.org/ontosim-dis#GIS
dsim:GIS rdf:type owl:NamedIndividual ,
                  dsim:SpatialType ;
         rdfs:comment "L'espace est représenté par des données géographiques réelles."@fr ,
                      "Space is represented by real geographic data."@en ;
         rdfs:label "Geographic information system"@en .


###  https://w3id.org/ontosim-dis#GREY_BOX
dsim:GREY_BOX rdf:type owl:NamedIndividual ,
                       dsim:ModelNature ;
              rdfs:comment "Model mixing a mechanistic part and an empirical part: some subsystems are described by their mechanisms, others by relations fitted to data."@en ,
                           "Modèle mêlant une part mécaniste et une part empirique : certains sous-systèmes sont décrits par leurs mécanismes, d'autres par des relations ajustées sur les données."@fr ;
              rdfs:label "Grey box"@en .


###  https://w3id.org/ontosim-dis#GRID
dsim:GRID rdf:type owl:NamedIndividual ,
                   dsim:SpatialType ;
          rdfs:comment "L'espace est représenté par une grille régulière de cellules."@fr ,
                       "Space is represented by a regular grid of cells."@en ;
          rdfs:label "grid"@en .


###  https://w3id.org/ontosim-dis#GROUP
dsim:GROUP rdf:type owl:NamedIndividual ,
                    dsim:GranularityLevel ;
           rdfs:comment "Individuals are gathered into homogeneous groups."@en ,
                        "Les individus sont regroupés en groupes homogènes."@fr ;
           rdfs:label "Group"@en .


###  https://w3id.org/ontosim-dis#HISTORICAL_DATA
dsim:HISTORICAL_DATA rdf:type owl:NamedIndividual ,
                              dsim:ValidationMethod ;
                     rdfs:comment "Comparaison des résultats avec des données réelles observées."@fr ,
                                  "Comparison of the results with real observed data."@en ;
                     rdfs:label "Historical data validation"@en .


###  https://w3id.org/ontosim-dis#INDIVIDUAL
dsim:INDIVIDUAL rdf:type owl:NamedIndividual ,
                         dsim:GranularityLevel ;
                rdfs:comment "Chaque individu est représenté séparément."@fr ,
                             "Each individual is represented separately."@en ;
                rdfs:label "Individual"@en .


###  https://w3id.org/ontosim-dis#MECHANISTIC
dsim:MECHANISTIC rdf:type owl:NamedIndividual ,
                          dsim:ModelNature ;
                 rdfs:comment "Modèle dit à boîte blanche, construit sur la connaissance du fonctionnement du système, de ses éléments et de leurs interactions. Fournit des explications causales, au prix d'une complexité accrue."@fr ,
                              "White-box model, built on knowledge of how the system works, of its elements and their interactions. Yields causal explanations, at the cost of greater complexity."@en ;
                 rdfs:label "Mechanistic"@en .


###  https://w3id.org/ontosim-dis#METHODOLOGICAL_RESEARCH
dsim:METHODOLOGICAL_RESEARCH rdf:type owl:NamedIndividual ,
                                      dsim:ModelPurpose ;
                             rdfs:comment "Améliorer les approches de modélisation elles-mêmes, pour les rendre plus efficaces, plus rapides ou plus robustes. Objectif de compréhension."@fr ,
                                          "Improving the modelling approaches themselves, to make them more effective, faster or more robust. An explanatory purpose."@en ;
                             rdfs:label "Methodological research"@en .


###  https://w3id.org/ontosim-dis#MULTISCALE
dsim:MULTISCALE rdf:type owl:NamedIndividual ,
                         dsim:GranularityLevel ;
                rdfs:comment "Plusieurs niveaux de détail coexistent dans le même modèle."@fr ,
                             "Several levels of detail coexist in the same model."@en ;
                rdfs:label "Multiscale"@en .


###  https://w3id.org/ontosim-dis#NETWORK
dsim:NETWORK rdf:type owl:NamedIndividual ,
                      dsim:SpatialType ;
             rdfs:comment "L'espace est représenté par un réseau de contacts ou de connexions."@fr ,
                          "Space is represented by a network of contacts or connections."@en ;
             rdfs:label "Network"@en .


###  https://w3id.org/ontosim-dis#NON_SPATIAL
dsim:NON_SPATIAL rdf:type owl:NamedIndividual ,
                          dsim:SpatialType ;
                 rdfs:comment "L'espace n'est pas représenté, la population est supposée bien mélangée."@fr ,
                              "Space is not represented, the population is assumed well mixed."@en ;
                 rdfs:label "Non spatial"@en .


###  https://w3id.org/ontosim-dis#REGIONAL
dsim:REGIONAL rdf:type owl:NamedIndividual ,
                       dsim:GranularityLevel ;
              rdfs:comment "L'unité décrite est un territoire."@fr ,
                           "The unit described is a territory."@en ;
              rdfs:label "Regional"@en .


###  https://w3id.org/ontosim-dis#RETROSPECTIVE_ANALYSIS
dsim:RETROSPECTIVE_ANALYSIS rdf:type owl:NamedIndividual ,
                                     dsim:ModelPurpose ;
                            rdfs:comment "Étudier une épidémie passée pour évaluer l'efficacité des réponses et préparer les interventions futures. Objectif de prédiction."@fr ,
                                         "Studying a past epidemic to assess how effective the response was and to prepare future interventions. A predictive purpose."@en ;
                            rdfs:label "Retrospective analysis"@en .


###  https://w3id.org/ontosim-dis#SPECIFIC
dsim:SPECIFIC rdf:type owl:NamedIndividual ,
                       dsim:ModelScope ;
              rdfs:comment "Model embedding the transmission mechanisms and factors particular to one disease, often in a given context. Needs precise data and serves the assessment of targeted interventions."@en ,
                           "Modèle intégrant les mécanismes de transmission et les facteurs propres à une maladie précise, souvent dans un contexte donné. Demande des données précises et sert à évaluer des interventions ciblées."@fr ;
              rdfs:label "Specific"@en .


###  https://w3id.org/ontosim-dis#STATISTICAL
dsim:STATISTICAL rdf:type owl:NamedIndividual ,
                          dsim:ValidationMethod ;
                 rdfs:comment "Statistical test of the agreement between results and reference data."@en ,
                              "Test statistique de l'accord entre les résultats et des données de référence."@fr ;
                 rdfs:label "Statistical Validation"@en .


###  https://w3id.org/ontosim-dis#STOCHASTIC
dsim:STOCHASTIC rdf:type owl:NamedIndividual ,
                         dsim:ParadigmType ;
                rdfs:comment "Chance takes part and results vary from one run to another."@en ,
                             "Le hasard intervient et les résultats varient d'une exécution à l'autre."@fr ;
                rdfs:label "Stochastic"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( dsim:BernoulliDistribution
                dsim:BetaDistribution
                dsim:ExponentialDistribution
                dsim:GammaDistribution
                dsim:NormalDistribution
                dsim:PoissonDistribution
                dsim:UniformDistribution
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( dsim:EnvironmentComponent
                dsim:ModelParameter
                dsim:RuleComponent
                dsim:StateComponent
                dsim:TransitionComponent
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( dsim:ADEQUACY
                        dsim:CONTINUOUS
                        dsim:CROSS_MODEL
                        dsim:DETERMINISTIC
                        dsim:DISCRETE
                        dsim:GIS
                        dsim:GRID
                        dsim:GROUP
                        dsim:HISTORICAL_DATA
                        dsim:INDIVIDUAL
                        dsim:MULTISCALE
                        dsim:NETWORK
                        dsim:NON_SPATIAL
                        dsim:REGIONAL
                        dsim:STATISTICAL
                        dsim:STOCHASTIC
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( dsim:DYNAMICS_RESEARCH
                        dsim:EMPIRICAL
                        dsim:EPIDEMIC_PLANNING
                        dsim:GENERAL
                        dsim:GREY_BOX
                        dsim:MECHANISTIC
                        dsim:METHODOLOGICAL_RESEARCH
                        dsim:RETROSPECTIVE_ANALYSIS
                        dsim:SPECIFIC
                      )
] .


