@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .

#################################################################
#    L'ontologie complète
#
#    Ce fichier ne contient aucun terme. Il importe les neuf
#    modules et porte les métadonnées de l'ensemble. Son IRI est
#    celle que l'on donne aux applications et à la documentation.
#################################################################

<https://w3id.org/ontosim-dis> rdf:type owl:Ontology ;
                               owl:versionIRI <https://w3id.org/ontosim-dis/1.1> ;
                               owl:imports <https://w3id.org/ontosim-dis/layer1/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer2/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer3a/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer3b/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer4-ogms/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer4-core/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer4-infectious/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer4-context/1.1> ,
                                           <https://w3id.org/ontosim-dis/layer4-checks/1.1> ;
                               dcterms:title "OntoSim-Dis: an ontology of diseases and of the simulation models that represent them"@en ,
                                             "OntoSim-Dis : une ontologie des maladies et des modèles de simulation qui les représentent"@fr ;
                               dcterms:abstract "OntoSim-Dis describes a disease, its health states, the transitions between them and what governs each transition, together with the compartmental and agent-based simulation models that represent it."@en ,
                                                "OntoSim-Dis décrit une maladie, ses états de santé, les transitions entre ces états et ce qui gouverne chaque transition, ainsi que les modèles de simulation à compartiments et multi-agents qui la représentent."@fr ;
                               dcterms:created "2026" ;
                               dcterms:creator "Paul Cheikh Anta DIOUF" ;
                               dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                               vann:preferredNamespacePrefix "dsim" ;
                               vann:preferredNamespaceUri "https://w3id.org/ontosim-dis#" ;
                               rdfs:comment """The complete OntoSim-Dis ontology. This file contains no term: it imports the nine modules and carries the metadata of the whole.
Its central distinction concerns risk: does the risk of a transition depend on the number of individuals in some category, as in a transmissible disease, or only on the individual? The modeller describes the transitions of a disease, and the reasoner infers whether it is coupled to the population."""@en ,
                                            """L'ontologie OntoSim-Dis complète. Ce fichier ne contient aucun terme : il importe les neuf modules et porte les métadonnées de l'ensemble.
Sa distinction centrale porte sur le risque : le risque d'une transition dépend-il de l'effectif d'une catégorie d'individus, comme dans une maladie transmissible, ou seulement de l'individu ? On décrit les transitions d'une maladie, et le raisonneur en déduit si elle est couplée à la population."""@fr ;
                               rdfs:label "OntoSim-Dis - ontologie complète"@fr ,
                                          "OntoSim-Dis - complete ontology"@en ;
                               owl:versionInfo "1.1" .

#################################################################
#    Propriétés d'annotation employées dans l'en-tête
#################################################################

dcterms:abstract rdf:type owl:AnnotationProperty .
dcterms:created rdf:type owl:AnnotationProperty .
dcterms:creator rdf:type owl:AnnotationProperty .
dcterms:license rdf:type owl:AnnotationProperty .
dcterms:title rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .
