@prefix : <https://w3id.org/ontosim-dis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dsim: <https://w3id.org/ontosim-dis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/ontosim-dis#> .

<https://w3id.org/ontosim-dis/layer3b> rdf:type owl:Ontology ;
                                        owl:versionIRI <https://w3id.org/ontosim-dis/layer3b/1.1> ;
                                        owl:imports <https://w3id.org/ontosim-dis/layer2/1.1> ;
                                        dcterms:created "2026" ;
                                        dcterms:creator "Paul Cheikh Anta DIOUF" ;
                                        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                        rdfs:comment """For this type of model, we divide the population into compartments, and the flows between these compartments are governed by rates.
They are usually expressed as differential equations.
Reminder: This layer contains no medical content."""@en ,
                                                     """Pour ce type de modèle, nous divisons la population en compartiments, et les flux entre ces compartiments sont gouvernés par des taux.
La plupart du temps, ils sont exprimés en équations différentielles.
Rappel : cette couche ne contient aucun contenu médical."""@fr ;
                                        rdfs:label "OntoSim-Dis Couche 3B - Paradigme compartimental et à équations"@fr ,
                                                   "OntoSim-Dis Layer 3B - Compartmental and equation-based paradigm"@en ;
                                        owl:versionInfo "1.1" .

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontosim-dis#dependsOnCompartment
dsim:dependsOnCompartment rdf:type owl:ObjectProperty ;
                          rdfs:domain dsim:CompartmentDependentRate ;
                          rdfs:range dsim:Compartment ;
                          rdfs:comment "Lie un taux aux compartiments dont il lit le contenu courant. Signature du couplage populationnel dans le paradigme compartimental."@fr ,
                                       "Links a rate to the compartments whose current content it reads. Signature of population coupling in the compartmental paradigm."@en ;
                          rdfs:label "dependsOnCompartment"@en .


###  https://w3id.org/ontosim-dis#governsCompartment
dsim:governsCompartment rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain dsim:DifferentialEquation ;
                        rdfs:range dsim:Compartment ;
                        rdfs:comment "Lie une équation au compartiment dont elle donne la variation."@fr ,
                                     "Links an equation to the compartment whose variation it gives."@en ;
                        rdfs:label "governsCompartment"@en .


###  https://w3id.org/ontosim-dis#hasCompartment
dsim:hasCompartment rdf:type owl:ObjectProperty ;
                    rdfs:domain dsim:CompartmentalModel ;
                    rdfs:range dsim:Compartment ;
                    rdfs:comment "Lie un modèle compartimental à ses compartiments."@fr ,
                                 "Links a compartmental model to its compartments."@en ;
                    rdfs:label "hasCompartment"@en .


###  https://w3id.org/ontosim-dis#hasEquation
dsim:hasEquation rdf:type owl:ObjectProperty ;
                 rdfs:domain dsim:CompartmentalModel ;
                 rdfs:range dsim:DifferentialEquation ;
                 rdfs:comment "Lie un modèle compartimental à ses équations différentielles."@fr ,
                              "Links a compartmental model to its differential equations."@en ;
                 rdfs:label "hasEquation"@en .


###  https://w3id.org/ontosim-dis#hasFlow
dsim:hasFlow rdf:type owl:ObjectProperty ;
             rdfs:domain dsim:CompartmentalModel ;
             rdfs:range dsim:TransitionFlow ;
             rdfs:comment "Lie un modèle compartimental à ses flux."@fr ,
                          "Links a compartmental model to its flows."@en ;
             rdfs:label "hasFlow"@en .


###  https://w3id.org/ontosim-dis#hasRate
dsim:hasRate rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain dsim:TransitionFlow ;
             rdfs:range dsim:RateSpecification ;
             rdfs:comment "Lie un flux à la façon dont son taux est déterminé."@fr ,
                          "Links a flow to the way its rate is determined."@en ;
             rdfs:label "hasRate"@en .


###  https://w3id.org/ontosim-dis#involvesFlow
dsim:involvesFlow rdf:type owl:ObjectProperty ;
                  rdfs:domain dsim:DifferentialEquation ;
                  rdfs:range dsim:TransitionFlow ;
                  rdfs:comment "Lie une équation aux flux qui y figurent."@fr ,
                               "Links an equation to the flows appearing in it."@en ;
                  rdfs:label "involvesFlow"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontosim-dis#compartmentInitialSize
dsim:compartmentInitialSize rdf:type owl:DatatypeProperty ;
                            rdfs:domain dsim:Compartment ;
                            rdfs:range xsd:double ;
                            rdfs:comment "Nombre d'individus dans le compartiment au début de la simulation."@fr ,
                                         "Number of individuals in the compartment at the start of the simulation."@en ;
                            rdfs:label "compartmentInitialSize"@en .


###  https://w3id.org/ontosim-dis#compartmentSymbol
dsim:compartmentSymbol rdf:type owl:DatatypeProperty ;
                       rdfs:domain dsim:Compartment ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Symbol of the compartment in the equations, for instance S or I."@en ,
                                    "Symbole du compartiment dans les équations, par exemple S ou I."@fr ;
                       rdfs:label "compartmentSymbol"@en .


###  https://w3id.org/ontosim-dis#equationExpression
dsim:equationExpression rdf:type owl:DatatypeProperty ;
                        rdfs:domain dsim:DifferentialEquation ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Expression textuelle de l'équation, par exemple dS/dt = -beta * S * I / N."@fr ,
                                     "Textual expression of the equation, for instance dS/dt = -beta * S * I / N."@en ;
                        rdfs:label "equationExpression"@en .


###  https://w3id.org/ontosim-dis#rateConstantValue
dsim:rateConstantValue rdf:type owl:DatatypeProperty ;
                       rdfs:domain dsim:ConstantRate ;
                       rdfs:range xsd:double ;
                       rdfs:comment "Valeur d'un taux constant, par jour."@fr ,
                                    "Value of a constant rate, per day."@en ;
                       rdfs:label "rateConstantValue"@en .


###  https://w3id.org/ontosim-dis#rateExpression
dsim:rateExpression rdf:type owl:DatatypeProperty ;
                    rdfs:domain dsim:RateSpecification ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Expression textuelle du taux, par exemple beta * I / N."@fr ,
                                 "Textual expression of the rate, for instance beta * I / N."@en ;
                    rdfs:label "rateExpression"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontosim-dis#Compartment
dsim:Compartment rdf:type owl:Class ;
                 rdfs:subClassOf dsim:StateComponent ;
                 rdfs:comment "A group of individuals sharing the same situation, counted together. Compartmental form of a state component."@en ,
                              "Groupe d'individus partageant la même situation, comptés ensemble. Forme compartimentale d'un composant d'état."@fr ;
                 rdfs:label "Compartment"@en .


###  https://w3id.org/ontosim-dis#CompartmentDependentRate
dsim:CompartmentDependentRate rdf:type owl:Class ;
                              rdfs:subClassOf dsim:RateSpecification ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty dsim:dependsOnCompartment ;
                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass dsim:Compartment
                                              ] ;
                              owl:disjointWith dsim:ConstantRate ;
                              rdfs:comment "A rate whose value depends on the current content of one or more compartments, which makes the system non-linear and coupled. Compartmental form of population coupling."@en ,
                                           "Taux dont la valeur dépend du contenu courant d'un ou plusieurs compartiments, ce qui rend le système non linéaire et couplé. Forme compartimentale du couplage populationnel."@fr ;
                              rdfs:label "CompartmentDependentRate"@en .


###  https://w3id.org/ontosim-dis#CompartmentalModel
dsim:CompartmentalModel rdf:type owl:Class ;
                        rdfs:subClassOf dsim:SimulationModel ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty dsim:hasCompartment ;
                                          owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                          owl:onClass dsim:Compartment
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty dsim:hasFlow ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass dsim:TransitionFlow
                                        ] ;
                        rdfs:comment "A model dividing the population into compartments, between which flows carry individuals at rates."@en ,
                                     "Modèle divisant la population en compartiments, entre lesquels des flux font passer les individus à certains taux."@fr ;
                        rdfs:label "CompartmentalModel"@en .


###  https://w3id.org/ontosim-dis#ConstantRate
dsim:ConstantRate rdf:type owl:Class ;
                  rdfs:subClassOf dsim:RateSpecification ;
                  rdfs:comment "A rate that does not depend on the current content of any compartment. Individual determinant. 'Constant' means here independent of the compartments, not fixed in time: a seasonal rate that reads no compartment is also a ConstantRate. It is then declared as such, and its value is written with rateExpression, since rateConstantValue only gives a fixed value."@en ,
                               "Taux qui ne dépend du contenu courant d'aucun compartiment. Déterminant individuel. « Constant » veut dire ici indépendant des compartiments, et non fixe dans le temps : un taux saisonnier qui ne lit aucun compartiment est aussi un ConstantRate. On le déclare alors comme tel, et sa valeur s'écrit avec rateExpression, car rateConstantValue ne donne qu'une valeur fixe."@fr ;
                  rdfs:label "ConstantRate"@en .


###  https://w3id.org/ontosim-dis#CoupledCompartmentalModel
dsim:CoupledCompartmentalModel rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( dsim:CompartmentalModel
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty dsim:hasFlow ;
                                                                            owl:someValuesFrom dsim:CoupledFlow
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf dsim:CompartmentalModel ;
                               rdfs:comment "A compartmental model containing at least one coupled flow. Inferred by the reasoner without anyone declaring the model infectious."@en ,
                                            "Modèle compartimental comportant au moins un flux couplé. Inféré par le raisonneur sans que personne ait déclaré le modèle infectieux."@fr ;
                               rdfs:label "CoupledCompartmentalModel"@en .


###  https://w3id.org/ontosim-dis#CoupledFlow
dsim:CoupledFlow rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( dsim:TransitionFlow
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty dsim:hasRate ;
                                                              owl:someValuesFrom dsim:CompartmentDependentRate
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf dsim:TransitionFlow ;
                 rdfs:comment "A flow whose rate depends on the content of a compartment."@en ,
                              "Flux dont le taux dépend du contenu d'un compartiment."@fr ;
                 rdfs:label "CoupledFlow"@en .


###  https://w3id.org/ontosim-dis#DifferentialEquation
dsim:DifferentialEquation rdf:type owl:Class ;
                          rdfs:subClassOf dsim:ModelComponent ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty dsim:involvesFlow ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass dsim:TransitionFlow
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty dsim:governsCompartment ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass dsim:Compartment
                                          ] ;
                          rdfs:comment "Équation donnant la variation dans le temps du contenu d'un compartiment, comme bilan des flux qui y entrent et en sortent."@fr ,
                                       "The equation giving the variation over time of the content of one compartment, as the balance of the flows entering and leaving it."@en ;
                          rdfs:label "DifferentialEquation"@en .


###  https://w3id.org/ontosim-dis#RateSpecification
dsim:RateSpecification rdf:type owl:Class ;
                       rdfs:subClassOf dsim:ModelParameter ;
                       rdfs:comment "Façon dont le taux d'un flux est déterminé."@fr ,
                                    "The way the rate of a flow is determined."@en ;
                       rdfs:label "RateSpecification"@en .


###  https://w3id.org/ontosim-dis#TransitionFlow
dsim:TransitionFlow rdf:type owl:Class ;
                    rdfs:subClassOf dsim:TransitionComponent ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty dsim:hasRate ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass dsim:RateSpecification
                                    ] ;
                    rdfs:comment "A passage of individuals from one compartment to another, governed by a rate. Inherits from the layer 2 transition its source and target states."@en ,
                                 "Passage d'individus d'un compartiment à un autre, gouverné par un taux. Hérite de la transition de couche 2 ses états de départ et d'arrivée."@fr ;
                    rdfs:label "TransitionFlow"@en .


