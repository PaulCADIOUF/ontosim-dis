@prefix : <https://w3id.org/ontosim-dis#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dsim: <https://w3id.org/ontosim-dis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/ontosim-dis#> .

<https://w3id.org/ontosim-dis/layer4-context> rdf:type owl:Ontology ;
                                               owl:versionIRI <https://w3id.org/ontosim-dis/layer4-context/1.0> ;
                                               owl:imports <https://w3id.org/ontosim-dis/layer2/1.0> ;
                                               dcterms:created "2026" ;
                                               dcterms:creator "Paul Cheikh Anta DIOUF" ;
                                               dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                               rdfs:comment "Où, pour qui et dans quelles conditions un modèle s'applique : population, région géographique, climat, infrastructure de santé. Deuxième composant du Quadruplet de recomposition."@fr ,
                                                            "Where, for whom and under which conditions a model applies: population, geographic region, climate, health infrastructure. Second component of the recomposition Quadruplet."@en ;
                                               rdfs:label "OntoSim-Dis Couche 4-Context - Connaissance de contexte"@fr ,
                                                          "OntoSim-Dis Layer 4-Context - Context knowledge"@en ;
                                               owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ontosim-dis#hasClimate
dsim:hasClimate rdf:type owl:ObjectProperty ;
                rdfs:domain dsim:ContextKnowledge ;
                rdfs:range dsim:Climate ;
                rdfs:comment "Lie un contexte à ses conditions climatiques."@fr ,
                             "Links a context to its climatic conditions."@en ;
                rdfs:label "hasClimate"@en .


###  https://w3id.org/ontosim-dis#hasContextKnowledge
dsim:hasContextKnowledge rdf:type owl:ObjectProperty ;
                         rdfs:domain dsim:SimulationModel ;
                         rdfs:range dsim:ContextKnowledge ;
                         rdfs:comment "Lie un modèle au contexte pour lequel il a été construit."@fr ,
                                      "Links a model to the context it was built for."@en ;
                         rdfs:label "hasContextKnowledge"@en .


###  https://w3id.org/ontosim-dis#hasGeographicRegion
dsim:hasGeographicRegion rdf:type owl:ObjectProperty ;
                         rdfs:domain dsim:ContextKnowledge ;
                         rdfs:range dsim:GeographicRegion ;
                         rdfs:comment "Lie un contexte aux territoires qu'il couvre."@fr ,
                                      "Links a context to the territories it covers."@en ;
                         rdfs:label "hasGeographicRegion"@en .


###  https://w3id.org/ontosim-dis#hasHealthInfrastructure
dsim:hasHealthInfrastructure rdf:type owl:ObjectProperty ;
                             rdfs:domain dsim:ContextKnowledge ;
                             rdfs:range dsim:HealthInfrastructure ;
                             rdfs:comment "Lie un contexte aux structures de santé disponibles."@fr ,
                                          "Links a context to the health facilities available."@en ;
                             rdfs:label "hasHealthInfrastructure"@en .


###  https://w3id.org/ontosim-dis#hasPopulation
dsim:hasPopulation rdf:type owl:ObjectProperty ;
                   rdfs:domain dsim:ContextKnowledge ;
                   rdfs:range dsim:Population ;
                   rdfs:comment "Lie un contexte aux populations qu'il concerne."@fr ,
                                "Links a context to the populations it concerns."@en ;
                   rdfs:label "hasPopulation"@en .


###  https://w3id.org/ontosim-dis#isLocatedInRegion
dsim:isLocatedInRegion rdf:type owl:ObjectProperty ;
                       rdfs:domain dsim:Population ;
                       rdfs:range dsim:GeographicRegion ;
                       rdfs:comment "Lie une population au territoire où elle vit."@fr ,
                                    "Links a population to the territory where it lives."@en ;
                       rdfs:label "isLocatedInRegion"@en .


###  https://w3id.org/ontosim-dis#isSubRegionOf
dsim:isSubRegionOf rdf:type owl:ObjectProperty ,
                            owl:TransitiveProperty ;
                   rdfs:domain dsim:GeographicRegion ;
                   rdfs:range dsim:GeographicRegion ;
                   rdfs:comment "Lie un territoire au territoire plus large qui le contient. Transitive : un district dans une région dans un pays est dans ce pays. RO:located in n'est délibérément pas réutilisée ici, car elle relie des entités matérielles réelles, alors que nos régions sont des descriptions de territoires."@fr ,
                                "Links a territory to the larger territory containing it. Transitive: a district in a region in a country is in that country. RO:located in is deliberately not reused here, because it relates real material entities, whereas our regions are descriptions of territories."@en ;
                   rdfs:label "isSubRegionOf"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ontosim-dis#averageHouseholdSize
dsim:averageHouseholdSize rdf:type owl:DatatypeProperty ;
                          rdfs:domain dsim:Population ;
                          rdfs:range xsd:double ;
                          rdfs:comment "Average number of people per household. Governs the intensity of domestic contacts."@en ,
                                       "Nombre moyen de personnes par ménage. Gouverne l'intensité des contacts domestiques."@fr ;
                          rdfs:label "averageHouseholdSize"@en .


###  https://w3id.org/ontosim-dis#avgHumidity
dsim:avgHumidity rdf:type owl:DatatypeProperty ;
                 rdfs:domain dsim:Climate ;
                 rdfs:range xsd:double ;
                 rdfs:comment "Average relative humidity as a percentage."@en ,
                              "Humidité relative moyenne en pourcentage."@fr ;
                 rdfs:label "avgHumidity"@en .


###  https://w3id.org/ontosim-dis#avgTemperature
dsim:avgTemperature rdf:type owl:DatatypeProperty ;
                    rdfs:domain dsim:Climate ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Average annual temperature, in degrees Celsius."@en ,
                                 "Température moyenne annuelle, en degrés Celsius."@fr ;
                    rdfs:label "avgTemperature"@en .


###  https://w3id.org/ontosim-dis#hospitalCapacity
dsim:hospitalCapacity rdf:type owl:DatatypeProperty ;
                      rdfs:domain dsim:HealthInfrastructure ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Nombre de lits disponibles. Fixe le seuil de saturation."@fr ,
                                   "Number of beds available. Sets the saturation threshold."@en ;
                      rdfs:label "hospitalCapacity"@en .


###  https://w3id.org/ontosim-dis#medianAge
dsim:medianAge rdf:type owl:DatatypeProperty ;
               rdfs:domain dsim:Population ;
               rdfs:range xsd:double ;
               rdfs:comment "Âge médian de la population, en années."@fr ,
                            "Median age of the population, in years."@en ;
               rdfs:label "medianAge"@en .


###  https://w3id.org/ontosim-dis#numberOfZones
dsim:numberOfZones rdf:type owl:DatatypeProperty ;
                   rdfs:domain dsim:GeographicRegion ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Nombre de sous-zones administratives."@fr ,
                                "Number of administrative sub-zones."@en ;
                   rdfs:label "numberOfZones"@en .


###  https://w3id.org/ontosim-dis#populationDensity
dsim:populationDensity rdf:type owl:DatatypeProperty ;
                       rdfs:domain dsim:Population ;
                       rdfs:range xsd:double ;
                       rdfs:comment "Densité en habitants par kilomètre carré."@fr ,
                                    "Density in inhabitants per square kilometre."@en ;
                       rdfs:label "populationDensity"@en .


###  https://w3id.org/ontosim-dis#populationSize
dsim:populationSize rdf:type owl:DatatypeProperty ;
                    rdfs:domain dsim:Population ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "Effectif de la population."@fr ,
                                 "Number of individuals in the population."@en ;
                    rdfs:label "populationSize"@en .


###  https://w3id.org/ontosim-dis#regionName
dsim:regionName rdf:type owl:DatatypeProperty ;
                rdfs:domain dsim:GeographicRegion ;
                rdfs:range xsd:string ;
                rdfs:comment "Nom officiel du territoire."@fr ,
                             "Official name of the territory."@en ;
                rdfs:label "regionName"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/ontosim-dis#AdministrativeRegion
dsim:AdministrativeRegion rdf:type owl:Class ;
                          rdfs:subClassOf dsim:GeographicRegion ;
                          rdfs:comment "Administrative division of a country. Senegal has fourteen of them."@en ,
                                       "Division administrative d'un pays. Le Sénégal en compte quatorze."@fr ;
                          rdfs:label "AdministrativeRegion"@en .


###  https://w3id.org/ontosim-dis#AridClimate
dsim:AridClimate rdf:type owl:Class ;
                 rdfs:subClassOf dsim:Climate ;
                 rdfs:comment "Climat sec à faibles précipitations."@fr ,
                              "Dry climate with little rainfall."@en ;
                 rdfs:label "AridClimate"@en .


###  https://w3id.org/ontosim-dis#City
dsim:City rdf:type owl:Class ;
          rdfs:subClassOf dsim:GeographicRegion ;
          rdfs:comment "Localité urbaine."@fr ,
                       "Urban locality"@en ;
          rdfs:label "City"@en .


###  https://w3id.org/ontosim-dis#Climate
dsim:Climate rdf:type owl:Class ;
             rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
             rdfs:comment "Climatic conditions influencing disease transmission. Decisive for vector-borne and water-borne diseases, where temperature and humidity govern the life cycle of the vector or of the intermediate host."@en ,
                          "Conditions climatiques influençant la transmission des maladies. Déterminantes pour les maladies à vecteur et à transmission hydrique, où température et humidité gouvernent le cycle de vie du vecteur ou de l'hôte intermédiaire."@fr ;
             rdfs:label "Climate"@en .


###  https://w3id.org/ontosim-dis#ContextKnowledge
dsim:ContextKnowledge rdf:type owl:Class ;
                      rdfs:subClassOf dsim:SimulationKnowledgeArtifact ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty dsim:hasClimate ;
                                        owl:allValuesFrom dsim:Climate
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty dsim:hasHealthInfrastructure ;
                                        owl:allValuesFrom dsim:HealthInfrastructure
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty dsim:hasGeographicRegion ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass dsim:GeographicRegion
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty dsim:hasPopulation ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass dsim:Population
                                      ] ;
                      rdfs:comment "Deuxième composant du Quadruplet de recomposition (CK). Décrit où, pour qui et dans quelles conditions un modèle s'applique."@fr ,
                                   "Second component of the recomposition Quadruplet (CK). Describes where, for whom and under which conditions a model applies."@en ;
                      rdfs:label "ContextKnowledge"@en .


###  https://w3id.org/ontosim-dis#Country
dsim:Country rdf:type owl:Class ;
             rdfs:subClassOf dsim:GeographicRegion ;
             rdfs:comment "Highest administrative level."@en ,
                          "Niveau administratif le plus haut."@fr ;
             rdfs:label "Country"@en .


###  https://w3id.org/ontosim-dis#District
dsim:District rdf:type owl:Class ;
              rdfs:subClassOf dsim:GeographicRegion ;
              rdfs:comment "Administrative division of a region."@en ,
                           "Division administrative d'une région."@fr ;
              rdfs:label "District"@en .


###  https://w3id.org/ontosim-dis#GeographicRegion
dsim:GeographicRegion rdf:type owl:Class ;
                      rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                      rdfs:comment "Territoire auquel un modèle s'applique. Quatre niveaux administratifs : pays, région, district, ville."@fr ,
                                   "The territory a model applies to. Four administrative levels: country, region, district, city."@en ;
                      rdfs:label "GeographicRegion"@en .


###  https://w3id.org/ontosim-dis#HealthCentre
dsim:HealthCentre rdf:type owl:Class ;
                  rdfs:subClassOf dsim:HealthInfrastructure ;
                  rdfs:comment "Local facility for primary care."@en ,
                               "Structure de proximité assurant les soins primaires."@fr ;
                  rdfs:label "HealthCentre"@en .


###  https://w3id.org/ontosim-dis#HealthInfrastructure
dsim:HealthInfrastructure rdf:type owl:Class ;
                          rdfs:subClassOf dsim:SimulationKnowledgeArtifact ;
                          rdfs:comment "Health facilities available in the context. Determines the capacity to respond, and the saturation threshold beyond which lethality rises."@en ,
                                       "Structures de santé disponibles dans le contexte. Détermine la capacité de réponse, et le seuil de saturation au-delà duquel la létalité augmente."@fr ;
                          rdfs:label "HealthInfrastructure"@en .


###  https://w3id.org/ontosim-dis#Hospital
dsim:Hospital rdf:type owl:Class ;
              rdfs:subClassOf dsim:HealthInfrastructure ;
              rdfs:comment "Facility with beds, able to admit severe cases."@en ,
                           "Structure disposant de lits, capable d'accueillir les cas graves."@fr ;
              rdfs:label "Hospital"@en .


###  https://w3id.org/ontosim-dis#MixedPopulation
dsim:MixedPopulation rdf:type owl:Class ;
                     rdfs:subClassOf dsim:Population ;
                     rdfs:comment "A population combining urban and rural zones within the same territory."@en ,
                                  "Population mêlant zones urbaines et rurales au sein d'un même territoire."@fr ;
                     rdfs:label "MixedPopulation"@en .


###  https://w3id.org/ontosim-dis#Population
dsim:Population rdf:type owl:Class ;
                rdfs:subClassOf dsim:SimulationKnowledgeArtifact ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty dsim:isLocatedInRegion ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass dsim:GeographicRegion
                                ] ;
                rdfs:comment "A group of individuals in a geographical context. Partial alignment with osdi:Population, which describes a clinical cohort by age, sex, life expectancy and size, here the population is situated, with its density, its households and its territory. The overlap is partial and must be documented as such."@en ,
                             "Groupe d'individus dans un contexte géographique. Alignement partiel avec osdi:Population, qui décrit une cohorte clinique par âge, sexe, espérance de vie et effectif ; ici la population est située, avec sa densité, ses ménages et son territoire. Le recouvrement est partiel et doit être documenté comme tel."@fr ;
                rdfs:label "Population"@en ;
                skos:relatedMatch <http://purl.obolibrary.org/obo/OGMS_0000084> ,
                                  <https://w3id.org/ontologies-ULL/OSDi#Population> .


###  https://w3id.org/ontosim-dis#RuralPopulation
dsim:RuralPopulation rdf:type owl:Class ;
                     rdfs:subClassOf dsim:Population ;
                     rdfs:comment "A population living mainly in the countryside, with a low density and fewer contacts."@en ,
                                  "Population vivant majoritairement en zone rurale, à faible densité et à contacts moins fréquents."@fr ;
                     rdfs:label "RuralPopulation"@en .


###  https://w3id.org/ontosim-dis#TemperateClimate
dsim:TemperateClimate rdf:type owl:Class ;
                      rdfs:subClassOf dsim:Climate ;
                      rdfs:comment "Climat à saisons marquées et températures modérées."@fr ,
                                   "Climate with marked seasons and moderate temperatures."@en ;
                      rdfs:label "TemperateClimate"@en .


###  https://w3id.org/ontosim-dis#TropicalClimate
dsim:TropicalClimate rdf:type owl:Class ;
                     rdfs:subClassOf dsim:Climate ;
                     rdfs:comment "Climat chaud et humide, favorable à de nombreux vecteurs."@fr ,
                                  "Hot and humid climate, favourable to many vectors."@en ;
                     rdfs:label "TropicalClimate"@en .


###  https://w3id.org/ontosim-dis#UrbanPopulation
dsim:UrbanPopulation rdf:type owl:Class ;
                     rdfs:subClassOf dsim:Population ;
                     rdfs:comment "A population living mainly in a city, with a high density and frequent contacts."@en ,
                                  "Population vivant majoritairement en ville, à forte densité et à contacts fréquents."@fr ;
                     rdfs:label "UrbanPopulation"@en .


###  https://w3id.org/ontosim-dis#VaccinationCentre
dsim:VaccinationCentre rdf:type owl:Class ;
                       rdfs:subClassOf dsim:HealthInfrastructure ;
                       rdfs:comment "Facility dedicated to administering vaccines."@en ,
                                    "Structure dédiée à l'administration des vaccins."@fr ;
                       rdfs:label "VaccinationCentre"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( dsim:AdministrativeRegion
                dsim:City
                dsim:Country
                dsim:District
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( dsim:AridClimate
                dsim:TemperateClimate
                dsim:TropicalClimate
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( dsim:MixedPopulation
                dsim:RuralPopulation
                dsim:UrbanPopulation
              )
] .


